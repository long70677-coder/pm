<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>三層式專案管理看板 v3 (Fixed)</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f5f5f7;--surface:#fff;--surface2:#f2f2f7;--border:#d2d2d7;
  --text:#1d1d1f;--text2:#6e6e73;--text3:#aeaeb2;
  --accent:#007aff;--green:#34c759;--red:#ff3b30;--orange:#ff9500;--purple:#af52de;
  --shadow-s:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.04);
  --shadow-m:0 4px 16px rgba(0,0,0,.10);--shadow-l:0 8px 32px rgba(0,0,0,.14);
  --rs:8px;--rm:12px;--rl:16px;--rxl:20px;
}
body.dark{
  --bg:#000;--surface:#1c1c1e;--surface2:#2c2c2e;--border:#3a3a3c;
  --text:#f5f5f7;--text2:#d1d1d6;--text3:#8e8e93;
  --shadow-s:0 1px 3px rgba(0,0,0,.5);--shadow-m:0 4px 16px rgba(0,0,0,.6);
}
body{font-family:-apple-system,"SF Pro Text","Microsoft JhengHei","Segoe UI",sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;transition:background .3s,color .3s;margin:0;height:100vh;display:flex;flex-direction:column;overflow:hidden}

header{background:rgba(255,255,255,.88);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:13px 28px;display:flex;align-items:center;justify-content:space-between;box-shadow:var(--shadow-s);z-index:200;flex-shrink:0}
body.dark header{background:rgba(28,28,30,.92)}
header h1{font-size:1.15rem;font-weight:700;color:var(--text)}
header .subtitle{font-size:.72rem;color:var(--text2);margin-top:2px}
.hdr-right{display:flex;align-items:center;gap:10px}
.save-ind{font-size:.72rem;background:var(--surface2);color:var(--text2);padding:4px 12px;border-radius:20px;border:1px solid var(--border)}
.theme-btn{background:var(--surface2);border:1px solid var(--border);border-radius:20px;padding:4px 14px;cursor:pointer;font-size:.78rem;color:var(--text2);transition:all .2s}
.theme-btn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}

.toolbar-wrap{flex-shrink:0;z-index:100;background:var(--surface);border-bottom:1px solid var(--border)}
.toolbar-top{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:10px 28px;border-bottom:1px solid var(--border)}
.toolbar-bottom{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:8px 28px;background:var(--surface2)}
.toolbar-bottom select, .toolbar-bottom input{border:1px solid var(--border);border-radius:var(--rs);padding:5px 10px;font-size:.8rem;outline:none;background:var(--surface);color:var(--text)}
.toolbar-bottom select:focus, .toolbar-bottom input:focus{border-color:var(--accent)}

.btn{background:var(--accent);color:#fff;border:none;border-radius:var(--rs);padding:7px 16px;cursor:pointer;font-size:.8rem;font-weight:500;transition:all .18s;white-space:nowrap;display:inline-flex;align-items:center;gap:4px}
.btn:hover{filter:brightness(1.1);transform:translateY(-1px);box-shadow:var(--shadow-s)}
.btn.green{background:var(--green)}
.btn.gray{background:var(--surface2);color:var(--text);border:1px solid var(--border)}
.btn.gray:hover{background:var(--border)}
.btn.red{background:var(--red)}
.btn.small{padding:4px 10px;font-size:.72rem}

.stats-bar{display:flex;gap:12px;padding:12px 28px;background:var(--surface);border-bottom:1px solid var(--border);flex-wrap:wrap}
.stat-card{background:var(--surface2);border-radius:var(--rm);padding:8px 16px;text-align:center;min-width:80px;border:1px solid var(--border);cursor:pointer;transition:all .15s}
.stat-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-s);border-color:var(--accent)}
.stat-card.active{box-shadow:0 0 0 2px var(--accent);background:var(--surface)}
.stat-card .num{font-size:1.4rem;font-weight:700;color:var(--accent)}
.stat-card.or .num{color:var(--orange)}.stat-card.gr .num{color:var(--green)}.stat-card.rd .num{color:var(--red)}
.stat-card .lbl{font-size:.7rem;color:var(--text2);margin-top:2px}

#mainZone{flex:1;position:relative;overflow:hidden;display:flex}
#boardCol{flex:1;overflow-y:auto;padding:20px 28px;background:var(--bg);transition:margin-right .3s}
#sidebar{width:320px;background:var(--surface);border-left:1px solid var(--border);overflow-y:auto;flex-shrink:0;box-shadow:-2px 0 8px rgba(0,0,0,.04);transition:transform 0.3s;z-index:10;position:absolute;right:0;top:0;bottom:0;transform:translateX(0)}
#sidebar.collapsed{transform:translateX(100%)}

.sb-header{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.sb-header h2{font-size:.95rem;font-weight:700;color:var(--text)}
.sb-section{padding:12px 16px 4px}
.sb-title{font-size:.72rem;font-weight:700;letter-spacing:.4px;margin-bottom:8px}
.sb-title.overdue{color:var(--red)}.sb-title.thisweek{color:var(--orange)}.sb-title.upcoming{color:var(--green)}
.sb-item{background:var(--surface2);border:1px solid var(--border);border-radius:var(--rm);padding:8px 10px;margin-bottom:8px;cursor:pointer;transition:all .15s}
.sb-item:hover{border-color:var(--accent);transform:translateX(-2px);box-shadow:var(--shadow-s)}
.sb-item .req{font-size:.68rem;color:var(--text3);margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-item .name{font-size:.8rem;font-weight:600;color:var(--text)}
.sb-item .meta{display:flex;justify-content:space-between;font-size:.68rem;margin-top:4px}
.sb-empty{font-size:.78rem;color:var(--text3);text-align:center;padding:10px}

.proj-card{background:var(--surface);border-radius:var(--rl);margin-bottom:20px;box-shadow:var(--shadow-s);border:1px solid var(--border);overflow:hidden;transition:box-shadow .2s, border-color .2s}
.proj-card:hover{box-shadow:var(--shadow-m)}
.proj-card.starred{border:2px solid #f59e0b;box-shadow:0 0 0 3px rgba(245,158,11,.15)}
.proj-header{padding:16px 20px;display:flex;align-items:flex-start;gap:12px;background:var(--surface);border-bottom:1px solid transparent;transition:border-color .2s;cursor:pointer}
.proj-card.open .proj-header{border-bottom-color:var(--border)}
.proj-id{font-size:.75rem;color:var(--text3);font-family:monospace;background:var(--surface2);padding:2px 6px;border-radius:4px}
.proj-title{font-size:1.1rem;font-weight:700;color:var(--text);margin:4px 0}
.badge{font-size:.68rem;padding:3px 10px;border-radius:20px;font-weight:600;white-space:nowrap}
.b-進行中{background:rgba(0,122,255,.12);color:var(--accent)}
.b-待開始{background:var(--surface2);color:var(--text2);border:1px solid var(--border)}
.b-已完成{background:rgba(52,199,89,.12);color:var(--green)}
.b-擱置{background:rgba(255,59,48,.12);color:var(--red)}

.dual-wrap{display:flex;flex-direction:column;gap:4px;min-width:220px;margin-top:4px}
.dp-row{display:flex;align-items:center;gap:8px}
.dp-label{font-size:.68rem;color:var(--text3);width:52px;text-align:right;flex-shrink:0}
.dp-bg{flex:1;height:6px;background:var(--surface2);border-radius:10px;overflow:hidden;min-width:100px}
.dp-fill-actual{height:100%;border-radius:10px;background:linear-gradient(90deg,var(--accent),#5ac8fa);transition:width .4s}
.dp-fill-expect{height:100%;border-radius:10px;background:repeating-linear-gradient(90deg,var(--orange) 0,var(--orange) 4px,transparent 4px,transparent 8px)}
.dp-pct{font-size:.75rem;font-weight:600;min-width:32px}
.dp-pct.a{color:var(--accent)}.dp-pct.e{color:var(--orange)}
.tag-ahead{font-size:.66rem;background:rgba(52,199,89,.12);color:var(--green);padding:2px 6px;border-radius:6px}
.tag-behind{font-size:.66rem;background:rgba(255,59,48,.12);color:var(--red);padding:2px 6px;border-radius:6px}

.proj-body{display:none;background:var(--surface2);padding:16px 20px}
.proj-card.open .proj-body{display:block}
.phase-block{background:var(--surface);border:1px solid var(--border);border-radius:var(--rm);margin-bottom:16px;overflow:hidden;box-shadow:var(--shadow-s);transition:all .2s}
.phase-block.dragging{opacity:0.5;box-shadow:var(--shadow-l);transform:scale(0.98)}
.phase-block.drag-over{border-top:3px solid var(--accent)}
.phase-header{background:rgba(0,122,255,.03);padding:10px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border)}
.phase-title{font-weight:600;font-size:.9rem;color:var(--text);display:flex;align-items:center;gap:8px}
.st-table-wrap{display:block;overflow-x:auto}
.phase-block.collapsed .st-table-wrap{display:none}

.st-table{width:100%;min-width:800px;border-collapse:collapse;table-layout:fixed}
.st-table th{padding:8px 6px;font-size:.7rem;color:var(--text2);text-align:left;background:var(--surface2);border-bottom:1px solid var(--border)}
.st-table td{padding:6px;font-size:.8rem;border-bottom:1px solid var(--border);vertical-align:middle;color:var(--text)}
.st-table tr:hover td{background:var(--surface2)}
.st-table tr.done td{opacity:0.6;background:rgba(52,199,89,.05)}
.st-table tr.dragging{opacity:0.4;background:var(--surface2)}
.st-table tr.drag-over-top{box-shadow:inset 0 2px 0 var(--accent)}
.st-table tr.drag-over-bot{box-shadow:inset 0 -2px 0 var(--accent)}

/* 這裡就是為任務列加入狀態顏色的地方，使用 rgba 透明度以適應深淺色模式 */
tr.status-待開始 { background-color: transparent !important; }
tr.status-進行中 { background-color: rgba(0, 122, 255, 0.08) !important; }
tr.status-擱置 { background-color: rgba(255, 149, 0, 0.12) !important; }
tr.status-已完成 { background-color: rgba(52, 199, 89, 0.1) !important; }

.drag-handle{cursor:grab;color:var(--text3);font-size:1rem;user-select:none;padding:0 4px;text-align:center}
.drag-handle:active{cursor:grabbing;color:var(--accent)}
.di{width:100%;font-size:.75rem;border:1px solid transparent;border-radius:var(--rs);padding:4px 6px;background:transparent;color:var(--text);outline:none;transition:all .2s}
.di:hover{border-color:var(--border);background:var(--surface2)}
.di:focus{border-color:var(--accent);background:var(--surface)}
select.di{appearance:none;cursor:pointer}

.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.overlay.show{display:flex}
.modal{background:var(--surface);border-radius:var(--rxl);padding:26px;width:480px;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-l);border:1px solid var(--border)}
.modal h3{margin-bottom:16px;font-size:1.1rem;color:var(--text)}
.modal label{display:block;font-size:.8rem;color:var(--text2);margin:12px 0 4px}
.modal input,.modal select,.modal textarea{width:100%;border:1px solid var(--border);border-radius:var(--rs);padding:8px 12px;font-size:.85rem;background:var(--surface2);color:var(--text);outline:none}
.modal input:focus,.modal select:focus,.modal textarea:focus{border-color:var(--accent);background:var(--surface)}
.modal-btns{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}

#dialogOverlay { z-index: 99999; }
#dialogOverlay .modal { width: 340px; text-align: center; padding: 24px 20px; }
#dialogMessage { font-size: 0.9rem; color: var(--text2); margin-bottom: 24px; white-space: pre-wrap; line-height: 1.5; }

#toast{position:fixed;bottom:32px;left:50%;transform:translateX(-50%);background:var(--text);color:var(--surface);padding:10px 22px;border-radius:20px;font-size:.9rem;z-index:9999;opacity:0;transition:opacity .3s;pointer-events:none}
</style>
</head>
<body>

<header>
  <div>
    <h1>🚀 專案管理看板 (三層式 v3)</h1>
    <div class="subtitle">Project ➔ Phase ➔ Task 結構管理</div>
  </div>
  <div class="hdr-right">
    <span class="save-ind" id="saveInd"></span>
    <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙 深色</button>
  </div>
</header>

<div class="toolbar-wrap">
  <div class="toolbar-top">
    <button class="btn" onclick="openProjModal(-1)" style="font-weight:700">＋ 新增專案</button>
    <div style="width:1px;height:24px;background:var(--border);margin:0 4px"></div>
    <button class="btn gray" onclick="openMemberMgr()">👥 成員管理</button>
    <div style="width:1px;height:24px;background:var(--border);margin:0 4px"></div>
    <label class="btn gray" style="cursor:pointer;margin:0">📂 匯入 Excel<input type="file" id="fileInput" accept=".xlsx" style="display:none" onclick="this.value=null" onchange="importData(event)"></label>
    <button class="btn gray" onclick="exportData()">📥 匯出 Excel</button>
    <div style="flex:1"></div>
    <button id="ganttBtn" class="btn" onclick="openGantt()" style="background:linear-gradient(135deg,#0ea5e9,#6366f1);display:none">📊 產出甘特圖</button>
    <button class="btn gray" id="sidebarToggle" onclick="toggleSidebar()">📅 儀表板</button>
    <button class="btn red small" onclick="clearData()" style="margin-left:8px">🗑 清除</button>
  </div>
  <div class="toolbar-bottom">
    <select id="filterType" onchange="render()"><option value="">全部類型</option></select>
    <select id="filterStatus" onchange="render()"><option value="">全部狀態</option><option>待開始</option><option>進行中</option><option>已完成</option><option>擱置</option></select>
    <select id="filterOwner" onchange="render()"><option value="">全部 PM</option></select>
    <input type="text" id="filterSearch" placeholder="🔍 搜尋名稱或編號..." oninput="render()" style="width:180px">
    <button class="btn gray small" onclick="clearFilters()">✕ 清除篩選</button>
    <div style="flex:1"></div>
    <button class="btn gray small" onclick="expandAll()">⊞ 展開</button>
    <button class="btn gray small" onclick="collapseAll()">⊟ 收合</button>
  </div>
  <div class="stats-bar" id="statsBar"></div>
</div>

<div id="mainZone">
  <div id="boardCol"><div id="board"></div></div>
  <div id="sidebar">
    <div class="sb-header">
      <h2>📅 今日儀表板</h2>
      <button class="btn gray small" onclick="toggleSidebar()">✕</button>
    </div>
    <div id="sbContent"></div>
  </div>
</div>

<div class="overlay" id="projOverlay" onclick="if(event.target===this)closeModal('projOverlay')">
  <div class="modal">
    <h3 id="projModalTitle">新增專案</h3>
    <label>專案編號</label><input id="p-id" placeholder="PJ202600001">
    <label>專案名稱</label><input id="p-name" placeholder="輸入專案名稱">
    <label>專案類型</label><input id="p-type" placeholder="例如：系統建置、維運..." list="typeList">
    <datalist id="typeList"></datalist>
    <div style="display:flex;gap:10px">
      <div style="flex:1"><label>負責人(PM)</label><select id="p-owner"></select></div>
      <div style="flex:1"><label>狀態</label><select id="p-status"><option>待開始</option><option>進行中</option><option>已完成</option><option>擱置</option></select></div>
    </div>
    <div style="display:flex;gap:10px">
      <div style="flex:1"><label>預計開始日</label><input type="date" id="p-start"></div>
      <div style="flex:1"><label>預計完成日</label><input type="date" id="p-due"></div>
    </div>
    <label>專案備註</label><textarea id="p-note" rows="2"></textarea>
    <div class="modal-btns">
      <button class="btn gray" onclick="closeModal('projOverlay')">取消</button>
      <button class="btn" onclick="saveProj()">儲存</button>
    </div>
  </div>
</div>

<div class="overlay" id="phaseOverlay" onclick="if(event.target===this)closeModal('phaseOverlay')">
  <div class="modal">
    <h3 id="phaseModalTitle">新增階段</h3>
    <label>階段名稱</label><input id="ph-name" placeholder="例如：需求訪談、系統開發...">
    <label>階段狀態</label><select id="ph-status"><option>待開始</option><option>進行中</option><option>已完成</option><option>擱置</option></select>
    <div style="display:flex;gap:10px">
      <div style="flex:1"><label>開始日</label><input type="date" id="ph-start"></div>
      <div style="flex:1"><label>完成日</label><input type="date" id="ph-due"></div>
    </div>
    <div class="modal-btns">
      <button class="btn gray" onclick="closeModal('phaseOverlay')">取消</button>
      <button class="btn" onclick="savePhase()">儲存</button>
    </div>
  </div>
</div>

<div class="overlay" id="memberOverlay" onclick="if(event.target===this)closeModal('memberOverlay')">
  <div class="modal">
    <h3>👥 成員管理</h3>
    <div id="memberListWrap" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px"></div>
    <div style="display:flex;gap:8px">
      <input id="newMemberInp" placeholder="輸入新成員姓名" onkeydown="if(event.key==='Enter')addMember()">
      <button class="btn green" onclick="addMember()">新增</button>
    </div>
    <div class="modal-btns">
      <button class="btn gray" onclick="closeModal('memberOverlay'); render();">關閉</button>
    </div>
  </div>
</div>

<div class="overlay" id="ganttOverlay" onclick="if(event.target===this)closeModal('ganttOverlay')">
  <div class="modal" style="max-width:90vw;width:1200px;height:85vh;display:flex;flex-direction:column">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
      <h3 style="margin:0;color:var(--accent)">📊 專案甘特圖</h3>
      <div style="display:flex;gap:8px">
        <button class="btn green" onclick="exportGanttXlsx()">📥 匯出 Excel</button>
        <button class="btn gray" onclick="closeModal('ganttOverlay')">關閉</button>
      </div>
    </div>
    <div id="ganttContainer" style="flex:1;overflow:auto;border:1px solid var(--border);border-radius:var(--rs);background:var(--surface)"></div>
  </div>
</div>

<div class="overlay" id="dialogOverlay">
  <div class="modal">
    <h3 id="dialogTitle">提示</h3>
    <div id="dialogMessage"></div>
    <div class="modal-btns" style="justify-content:center;">
      <button class="btn gray" id="dialogBtnCancel" style="display:none;">取消</button>
      <button class="btn" id="dialogBtnConfirm">確定</button>
    </div>
  </div>
</div>

<div id="toast"></div>

<script>
const SK = 'pm_project_v3_data_fixed';
const SK_MEMBERS = 'pm_project_v3_members_fixed';
const SK_THEME = 'pm_project_v3_theme_fixed';

let DATA = [];
let MEMBERS = [];

try { 
  DATA = JSON.parse(localStorage.getItem(SK)) || []; 
  MEMBERS = JSON.parse(localStorage.getItem(SK_MEMBERS)) || ['負責人A', '負責人B', '負責人C'];
} catch(e){}

let editP = -1, editPh = -1;
let openCards = new Set(); 
let collapsedPhases = new Set(); 
let selectedGanttProjs = new Set();
let _sidebarOpen = false;

function todayStr(){ return new Date().toISOString().split('T')[0]; }

function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg; t.style.opacity = '1';
  clearTimeout(t._t);
  t._t = setTimeout(() => t.style.opacity = '0', 2500);
}

function showDialog(message, title = '提示', isConfirm = false, onConfirm = null, onCancel = null) {
  const overlay = document.getElementById('dialogOverlay');
  document.getElementById('dialogTitle').textContent = title;
  document.getElementById('dialogMessage').textContent = message;

  const btnConfirm = document.getElementById('dialogBtnConfirm');
  const btnCancel = document.getElementById('dialogBtnCancel');

  btnCancel.style.display = isConfirm ? 'inline-flex' : 'none';

  btnConfirm.onclick = () => {
    overlay.classList.remove('show');
    if (onConfirm) onConfirm();
  };

  btnCancel.onclick = () => {
    overlay.classList.remove('show');
    if (onCancel) onCancel();
  };

  overlay.classList.add('show');
}

function saveData(){ 
  localStorage.setItem(SK, JSON.stringify(DATA)); 
  const ind = document.getElementById('saveInd');
  ind.textContent = '💾 已自動儲存 ' + new Date().toLocaleTimeString();
  setTimeout(()=>ind.textContent='', 3000);
}
function saveMembers(){ localStorage.setItem(SK_MEMBERS, JSON.stringify(MEMBERS)); }

function toggleTheme(){
  const dark = document.body.classList.toggle('dark');
  localStorage.setItem(SK_THEME, dark ? 'dark' : 'light');
  document.getElementById('themeBtn').textContent = dark ? '☀️ 亮色' : '🌙 深色';
}
if(localStorage.getItem(SK_THEME) === 'dark'){
  document.body.classList.add('dark');
  document.getElementById('themeBtn').textContent = '☀️ 亮色';
}

function toggleSidebar(){
  _sidebarOpen = !_sidebarOpen;
  document.getElementById('sidebar').classList.toggle('collapsed', !_sidebarOpen);
  document.getElementById('boardCol').style.marginRight = _sidebarOpen ? '320px' : '0';
}
document.getElementById('sidebar').classList.add('collapsed');

function openMemberMgr(){ renderMemberList(); openModal('memberOverlay'); }
function renderMemberList(){
  const wrap = document.getElementById('memberListWrap');
  if(!MEMBERS.length){ wrap.innerHTML = `<span style="color:var(--text3);font-size:.8rem">尚未新增成員</span>`; return; }
  wrap.innerHTML = MEMBERS.map((m, i) => `
