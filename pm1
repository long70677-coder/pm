function renderPhases(proj, pIdx){
  if(!proj.phases || !proj.phases.length) return `<div style="font-size:.8rem;color:var(--text3);text-align:center;padding:10px">尚無階段資料</div>`;
  
  return proj.phases.map((ph, phIdx) => {
    const isCollapsed = collapsedPhases.has(`${pIdx}-${phIdx}`);
    const tCount = ph.tasks.length;
    const phPct = tCount ? Math.round(ph.tasks.reduce((sum, t)=>sum+(t.pct||0), 0) / tCount) : 0;

    return `
    <div class="phase-block ${isCollapsed?'collapsed':''}" data-pidx="${pIdx}" data-phidx="${phIdx}">
      <div class="phase-header">
        <div class="phase-title">
          <span class="drag-handle phase-drag" title="拖曳排序階段" onmousedown="this.closest('.phase-block').draggable=true" onmouseup="this.closest('.phase-block').draggable=false" onmouseleave="this.closest('.phase-block').draggable=false">⠿</span>
          ${ph.name}
          <span class="badge b-${ph.status}" style="font-size:.65rem">${ph.status}</span>
          <span style="font-size:.7rem;color:var(--text3);font-weight:normal;margin-left:8px">階段進度: ${phPct}%</span>
        </div>
        <div style="display:flex;gap:6px;align-items:center">
          <button class="btn gray small" onclick="openPhaseModal(${pIdx}, ${phIdx})">✏️</button>
          <button class="btn gray small" onclick="addTask(${pIdx}, ${phIdx})">＋ 新增任務</button>
          <button class="btn gray small" style="color:var(--red)" onclick="delPhase(${pIdx}, ${phIdx})">✕</button>
          <button style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:1rem;margin-left:4px" onclick="togglePhaseCollapse(${pIdx},${phIdx})">${isCollapsed?'▼':'▲'}</button>
        </div>
      </div>
      <div class="st-table-wrap">
        <table class="st-table">
          <colgroup><col width="32"><col width="200"><col width="110"><col width="90"><col width="105"><col width="105"><col width="80"><col width="180"><col width="40"></colgroup>
          <thead><tr><th></th><th>任務名稱</th><th>負責人</th><th>狀態</th><th>開始日</th><th>完成日</th><th>完成率</th><th>備註</th><th>操作</th></tr></thead>
          <tbody>
            ${ph.tasks.length ? ph.tasks.map((t, tIdx) => renderTaskRow(pIdx, phIdx, tIdx, t)).join('') : `<tr><td colspan="9" style="text-align:center;color:var(--text3);font-size:.75rem">此階段尚無任務</td></tr>`}
          </tbody>
        </table>
      </div>
    </div>`;
  }).join('');
}

function renderTaskRow(pIdx, phIdx, tIdx, t){
  const isDone = t.status === '已完成';
  const memberOpts = `<option value="">選擇</option>` + MEMBERS.map(m => `<option value="${m}" ${t.person===m?'selected':''}>${m}</option>`).join('');

  // 動態綁定狀態顏色 css class (status-待開始, status-進行中 等)
  return `
  <tr class="${isDone?'done':''} status-${t.status || '待開始'}" data-pidx="${pIdx}" data-phidx="${phIdx}" data-tidx="${tIdx}">
    <td class="drag-handle task-drag" title="拖曳排序任務" onmousedown="this.closest('tr').draggable=true" onmouseup="this.closest('tr').draggable=false" onmouseleave="this.closest('tr').draggable=false">⠿</td>
    <td><input class="di" value="${t.name}" onchange="updateTask(${pIdx},${phIdx},${tIdx},'name',this.value)"></td>
    <td><select class="di" onchange="updateTask(${pIdx},${phIdx},${tIdx},'person',this.value)">${memberOpts}</select></td>
    <td>
      <select class="di" onchange="updateTask(${pIdx},${phIdx},${tIdx},'status',this.value)">
        ${['待開始','進行中','已完成','擱置'].map(s=>`<option ${t.status===s?'selected':''}>${s}</option>`).join('')}
      </select>
    </td>
    <td><input type="date" class="di" value="${t.startDate||''}" onchange="updateTask(${pIdx},${phIdx},${tIdx},'startDate',this.value)"></td>
    <td><input type="date" class="di" value="${t.dueDate||''}" onchange="updateTask(${pIdx},${phIdx},${tIdx},'dueDate',this.value)"></td>
    <td><div style="display:flex;align-items:center;gap:4px"><input type="number" class="di" value="${t.pct||0}" min="0" max="100" style="width:46px;text-align:center" onchange="updateTask(${pIdx},${phIdx},${tIdx},'pct',this.value)"> %</div></td>
    <td><input class="di" value="${t.note||''}" placeholder="備註" onchange="updateTask(${pIdx},${phIdx},${tIdx},'note',this.value)"></td>
    <td style="text-align:center"><button style="background:none;border:none;cursor:pointer;color:var(--red);font-size:1rem" onclick="delTask(${pIdx},${phIdx},${tIdx})" title="刪除">✕</button></td>
  </tr>`;
}

let dragType = null, dragSource = null;
function bindDragEvents(){
  document.querySelectorAll('.phase-block').forEach(el => {
    el.addEventListener('dragstart', e => {
      if(!el.draggable) { e.preventDefault(); return; }
      dragType = 'phase'; dragSource = { pIdx: parseInt(el.dataset.pidx), phIdx: parseInt(el.dataset.phidx) };
      el.classList.add('dragging'); e.dataTransfer.effectAllowed = 'move';
    });
    el.addEventListener('dragend', e => { el.classList.remove('dragging'); el.draggable = false; document.querySelectorAll('.phase-block').forEach(x=>x.classList.remove('drag-over')); dragType=null; });
    el.addEventListener('dragover', e => { if(dragType==='phase'){ e.preventDefault(); el.classList.add('drag-over'); } });
    el.addEventListener('dragleave', e => { el.classList.remove('drag-over'); });
    el.addEventListener('drop', e => {
      e.preventDefault(); el.classList.remove('drag-over');
      if(dragType !== 'phase' || !dragSource) return;
      const tPIdx = parseInt(el.dataset.pidx), tPhIdx = parseInt(el.dataset.phidx);
      if(dragSource.pIdx !== tPIdx) return;
      if(dragSource.phIdx === tPhIdx) return;
      const phases = DATA[tPIdx].phases;
      const [moved] = phases.splice(dragSource.phIdx, 1);
      phases.splice(tPhIdx, 0, moved);
      saveData(); render();
    });
  });

  document.querySelectorAll('.st-table tbody tr').forEach(el => {
    el.addEventListener('dragstart', e => {
      if(!el.draggable) { e.preventDefault(); return; }
      dragType = 'task'; dragSource = { pIdx: parseInt(el.dataset.pidx), phIdx: parseInt(el.dataset.phidx), tIdx: parseInt(el.dataset.tidx) };
      el.classList.add('dragging'); e.dataTransfer.effectAllowed = 'move';
    });
    el.addEventListener('dragend', e => { 
      el.classList.remove('dragging'); el.draggable = false;
      document.querySelectorAll('.st-table tr').forEach(x=>x.classList.remove('drag-over-top', 'drag-over-bot')); 
      dragType=null; 
    });
    el.addEventListener('dragover', e => {
      if(dragType === 'task'){
        e.preventDefault(); const rect = el.getBoundingClientRect();
        el.classList.remove('drag-over-top', 'drag-over-bot');
        el.classList.add(e.clientY < rect.top + rect.height / 2 ? 'drag-over-top' : 'drag-over-bot');
      }
    });
    el.addEventListener('dragleave', e => el.classList.remove('drag-over-top', 'drag-over-bot'));
    el.addEventListener('drop', e => {
      e.preventDefault(); if(dragType !== 'task' || !dragSource) return;
      el.classList.remove('drag-over-top', 'drag-over-bot');
      const tPIdx = parseInt(el.dataset.pidx), tPhIdx = parseInt(el.dataset.phidx), tTIdx = parseInt(el.dataset.tidx);
      if(dragSource.pIdx !== tPIdx || dragSource.phIdx !== tPhIdx) return;
      if(dragSource.tIdx === tTIdx) return;
      const rect = el.getBoundingClientRect();
      const insertAfter = e.clientY >= rect.top + rect.height / 2;
      const tasks = DATA[tPIdx].phases[tPhIdx].tasks;
      const [moved] = tasks.splice(dragSource.tIdx, 1);
      let target = tTIdx > dragSource.tIdx ? tTIdx - 1 : tTIdx;
      if(insertAfter) target++;
      tasks.splice(target, 0, moved);
      saveData(); render();
    });
  });
}

function toggleCard(idx){ openCards.has(idx) ? openCards.delete(idx) : openCards.add(idx); render(); }
function expandAll(){ DATA.forEach((_,i)=>openCards.add(i)); render(); }
function collapseAll(){ openCards.clear(); render(); }
function togglePhaseCollapse(pIdx, phIdx){ const k=`${pIdx}-${phIdx}`; collapsedPhases.has(k)?collapsedPhases.delete(k):collapsedPhases.add(k); render(); }
function toggleGantt(pIdx){ selectedGanttProjs.has(pIdx) ? selectedGanttProjs.delete(pIdx) : selectedGanttProjs.add(pIdx); render(); }
function toggleStar(pIdx){ DATA[pIdx].starred = !DATA[pIdx].starred; saveData(); render(); }
function closeModal(id){ document.getElementById(id).classList.remove('show'); }
function openModal(id){ document.getElementById(id).classList.add('show'); }

function renderSidebar(){
  const today = todayStr();
  let curr = new Date(); curr.setDate(curr.getDate() + (7 - curr.getDay())); 
  const sunday = curr.toISOString().split('T')[0];
  let p7 = new Date(); p7.setDate(p7.getDate()+7);
  const plus7 = p7.toISOString().split('T')[0];

  const over=[], week=[], up=[];
  DATA.forEach((p, pIdx) => {
    (p.phases||[]).forEach((ph, phIdx) => {
      (ph.tasks||[]).forEach((t, tIdx) => {
        if(t.status === '已完成' || t.status === '擱置') return;
        if(t.dueDate && t.dueDate < today) over.push({p,t,pIdx});
        else if(t.dueDate && t.dueDate >= today && t.dueDate <= sunday) week.push({p,t,pIdx});
        else if(t.startDate && t.startDate > today && t.startDate <= plus7) up.push({p,t,pIdx});
      });
    });
  });

  const mkItems = (list, cls) => {
    if(!list.length) return '<div class="sb-empty">—</div>';
    return list.map(x => `
      <div class="sb-item" style="border-left:3px solid var(--${cls})" onclick="jumpToCard(${x.pIdx})">
        <div class="req">${x.p.id}</div>
        <div class="name">${x.t.name}</div>
        <div class="meta"><span>👤 ${x.t.person||'未指派'}</span><span style="color:var(--${cls})">${x.t.dueDate||x.t.startDate}</span></div>
      </div>`).join('');
  };

  const sb = document.getElementById('sbContent');
  sb.innerHTML = `
    <div class="sb-section"><div class="sb-title overdue">🔴 已逾期 (${over.length})</div>${mkItems(over,'red')}</div>
    <div class="sb-section"><div class="sb-title thisweek">🟡 本週到期 (${week.length})</div>${mkItems(week,'orange')}</div>
    <div class="sb-section"><div class="sb-title upcoming">🟢 即將開始 (${up.length})</div>${mkItems(up,'green')}</div>
  `;
}
function jumpToCard(idx){
  openCards.add(idx); render();
  setTimeout(()=>{
    const el = document.getElementById('proj-'+idx);
    if(el) { el.scrollIntoView({behavior:'smooth', block:'start'}); el.style.borderColor='var(--accent)'; setTimeout(()=>el.style.borderColor='', 1500); }
  }, 100);
}

