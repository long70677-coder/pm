function delPhase(pIdx, phIdx) {
  showDialog('確定刪除階段？', '刪除確認', true, () => {
    DATA[pIdx].phases.splice(phIdx,1); saveData(); render();
  });
}

function addTask(pIdx, phIdx){
  DATA[pIdx].phases[phIdx].tasks.push({ name:'新任務', person:'', status:'待開始', startDate:'', dueDate:'', pct:0, note:'' });
  saveData(); render();
}

function updateTask(pIdx, phIdx, tIdx, field, val){
  const t = DATA[pIdx].phases[phIdx].tasks[tIdx];
  t[field] = field === 'pct' ? (parseInt(val)||0) : val;
  if(field === 'status' && val === '已完成') { t.pct = 100; if(!t.actualDate) t.actualDate = todayStr(); }
  saveData(); render();
}

function delTask(pIdx, phIdx, tIdx) { 
  showDialog('刪除任務？', '刪除確認', true, () => {
    DATA[pIdx].phases[phIdx].tasks.splice(tIdx,1); saveData(); render();
  });
}

function clearData() {
  showDialog('⚠️ 警告：這會清空所有專案資料！\n確定繼續？', '清空資料', true, () => {
    DATA=[]; selectedGanttProjs.clear(); saveData(); render(); showToast('🗑 已清空全部資料');
  });
}

const EXCEL_HEADERS = ['專案編號','專案名稱','專案類型','負責人','狀態','預計開始日','預計完成日','備註',
  '階段名稱','階段狀態','階段開始日','階段完成日','任務名稱','任務負責人','任務狀態','任務開始日','任務完成日','任務完成率','任務備註'];

function fmtDate(val){
  if(!val) return '';
  if(val instanceof Date) return val.getFullYear()+'-'+String(val.getMonth()+1).padStart(2,'0')+'-'+String(val.getDate()).padStart(2,'0');
  return String(val).substring(0,10);
}

function importData(e){
  const file = e.target.files[0]; 
  if(!file) return;
  
  showDialog(`⚠️ 準備匯入：${file.name}\n這將解析 專案 > 階段 > 任務。\n確定繼續嗎？`, '匯入確認', true,
    () => { 
      if(typeof XLSX === 'undefined'){ showDialog('❌ 錯誤：XLSX 函式庫未載入'); e.target.value=''; return; }
      
      const reader = new FileReader();
      reader.onload = function(ev){
        try {
          const wb = XLSX.read(new Uint8Array(ev.target.result), {type:'array', cellDates:true});
          
          const wsMembers = wb.Sheets['成員清單'];
          if(wsMembers){
            const mRows = XLSX.utils.sheet_to_json(wsMembers, {defval:''});
            const newMembers = mRows.map(r => String(r['成員姓名'] || r['成員'] || '').trim()).filter(Boolean);
            if(newMembers.length > 0) MEMBERS = [...new Set([...MEMBERS, ...newMembers])];
            saveMembers();
          }

          const wsData = wb.Sheets['專案資料'] || wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(wsData, {defval:''});
          if(!rows.length){ showDialog('❌ 專案資料表內沒有資料'); e.target.value=''; return; }

          const projMap = {}; const projOrder = []; let valid = 0;
          rows.forEach(r => {
            const getVal = (keys) => { for(let k of keys){ if(r[k]!==undefined && String(r[k]).trim()!=='') return String(r[k]).trim(); } return ''; };
            const pId = getVal(['專案編號','ID']); if(!pId) return;
            valid++;

            if(!projMap[pId]){
              projOrder.push(pId);
              projMap[pId] = {
                id: pId, name: getVal(['專案名稱','名稱']) || '未命名', type: getVal(['專案類型','類型']),
                owner: getVal(['負責人','PM']), status: getVal(['狀態']) || '待開始',
                startDate: fmtDate(getVal(['預計開始日','開始日'])), dueDate: fmtDate(getVal(['預計完成日','完成日'])),
                note: getVal(['備註']), phases: [], starred: false
              };
            }
            const proj = projMap[pId];
            const phName = getVal(['階段名稱']) || '預設階段';
            let phase = proj.phases.find(ph => ph.name === phName);
            if(!phase){
              phase = { name: phName, status: getVal(['階段狀態'])||'待開始', startDate: fmtDate(getVal(['階段開始日'])), dueDate: fmtDate(getVal(['階段完成日'])), tasks: [] };
              proj.phases.push(phase);
            }
            const tName = getVal(['任務名稱','子功能名稱']);
            if(tName){
              phase.tasks.push({
                name: tName, person: getVal(['任務負責人','子功能負責人']), status: getVal(['任務狀態'])||'待開始',
                startDate: fmtDate(getVal(['任務開始日'])), dueDate: fmtDate(getVal(['任務完成日'])),
                pct: parseInt(getVal(['任務完成率']).replace('%',''))||0, note: getVal(['任務備註'])
              });
            }
          });

          if(valid === 0){ showDialog('❌ 讀不到有效的專案資料 (請確認有"專案編號"欄位)'); e.target.value=''; return; }
          const newProjs = projOrder.map(id => projMap[id]);
          
          if(DATA.length > 0){
            showDialog(`解析成功！共 ${newProjs.length} 筆專案。\n\n[確定] = 完全覆蓋現有資料\n[取消] = 合併新增 (略過重複編號)`, '資料匯入方式', true,
              () => { 
                DATA = newProjs; selectedGanttProjs.clear(); showToast(`✅ 已覆蓋 ${newProjs.length} 筆資料`);
                saveData(); e.target.value = ''; render();
              },
              () => { 
                const existIds = new Set(DATA.map(p=>p.id));
                const toAdd = newProjs.filter(p=>!existIds.has(p.id));
                DATA = DATA.concat(toAdd);
                showToast(`✅ 已合併新增 ${toAdd.length} 筆資料 (略過重複)`);
                saveData(); e.target.value = ''; render();
              }
            );
          } else {
            DATA = newProjs; showToast(`✅ 匯入成功！共 ${newProjs.length} 筆專案`);
            saveData(); e.target.value = ''; render();
          }
        } catch(err){ showDialog('❌ 匯入失敗：' + err.message); e.target.value = ''; }
      };
      
      try {
        reader.readAsArrayBuffer(file);
      } catch(err) {
        showDialog('❌ 讀取檔案發生錯誤');
        e.target.value = '';
      }
    },
    () => { 
      e.target.value = '';
    }
  );
}

function exportData(){
  if(!DATA.length){ showDialog('目前沒有資料可匯出'); return; }
  const rows = [];
  DATA.forEach(p => {
    const pBase = { '專案編號': p.id, '專案名稱': p.name, '專案類型': p.type, '負責人': p.owner, '狀態': p.status, '預計開始日': p.startDate, '預計完成日': p.dueDate, '備註': p.note };
    if(!p.phases || !p.phases.length){ rows.push(pBase); return; }
    p.phases.forEach(ph => {
      const phBase = { ...pBase, '階段名稱': ph.name, '階段狀態': ph.status, '階段開始日': ph.startDate, '階段完成日': ph.dueDate };
      if(!ph.tasks || !ph.tasks.length){ rows.push(phBase); return; }
      ph.tasks.forEach(t => {
        rows.push({ ...phBase, '任務名稱': t.name, '任務負責人': t.person, '任務狀態': t.status, '任務開始日': t.startDate, '任務完成日': t.dueDate, '任務完成率': (t.pct||0) + '%', '任務備註': t.note });
      });
    });
  });

  const wb = XLSX.utils.book_new();
  const ws1 = XLSX.utils.json_to_sheet(rows, { header: EXCEL_HEADERS });
  Object.keys(ws1).forEach(k => { if(k[0] !== '!') ws1[k].z = '@'; });
  XLSX.utils.book_append_sheet(wb, ws1, '專案資料');
  
  const mRows = MEMBERS.map(m => ({'成員姓名': m}));
  const ws2 = XLSX.utils.json_to_sheet(mRows.length ? mRows : [{'成員姓名':''}]);
  XLSX.utils.book_append_sheet(wb, ws2, '成員清單');

  XLSX.writeFile(wb, '專案管理_' + todayStr() + '.xlsx');
}

function openGantt(){
  if(selectedGanttProjs.size === 0) return;
  const container = document.getElementById('ganttContainer');
  const projs = [...selectedGanttProjs].map(i => DATA[i]).filter(Boolean);
  
  let minDate = new Date('2099-01-01'), maxDate = new Date('2000-01-01');
  const rows = []; 
  projs.forEach(p => {
    rows.push({ type: 'project', label: `📁 ${p.name}`, start: p.startDate, end: p.dueDate });
    if(p.startDate) minDate = new Date(Math.min(minDate, new Date(p.startDate)));
    if(p.dueDate) maxDate = new Date(Math.max(maxDate, new Date(p.dueDate)));
    (p.phases||[]).forEach(ph => {
      rows.push({ type: 'phase', label: `🔻 ${ph.name}`, start: ph.startDate, end: ph.dueDate });
      (ph.tasks||[]).forEach(t => {
        if(t.startDate && t.dueDate){
          rows.push({ type: 'task', label: t.name, owner: t.person, start: t.startDate, end: t.dueDate, pct: t.pct||0 });
          minDate = new Date(Math.min(minDate, new Date(t.startDate))); maxDate = new Date(Math.max(maxDate, new Date(t.dueDate)));
        }
      });
    });
  });

  if(minDate > maxDate) { container.innerHTML = '<div style="padding:20px">所選專案無有效日期</div>'; openModal('ganttOverlay'); return; }
  minDate.setDate(minDate.getDate() - 3); maxDate.setDate(maxDate.getDate() + 7);
  
  const timeStart = minDate.getTime();
  const timeEnd = maxDate.getTime();
  const totalDays = Math.round((timeEnd - timeStart) / (1000 * 60 * 60 * 24)) + 1;
  
  let html = `<div style="position:relative; min-width: ${Math.max(800, totalDays * 20)}px">`;
  html += `<div style="display:flex;background:var(--surface2);border-bottom:2px solid var(--border);position:sticky;top:0;z-index:10">
    <div style="width:280px;flex-shrink:0;padding:10px;font-weight:600;border-right:1px solid var(--border)">結構樹</div>
    <div style="flex:1;position:relative;height:40px">`;
  for(let d=new Date(minDate); d<=maxDate; d.setDate(d.getDate()+1)){
    const dayDiff = Math.round((d.getTime() - timeStart) / (1000 * 60 * 60 * 24));
    const lPct = (dayDiff / totalDays) * 100;
    if(d.getDate() === 1 || d.getDate() === 15 || dayDiff === 0){
      html += `<div style="position:absolute;left:${lPct}%;top:5px;font-size:.7rem;color:var(--text2);border-left:1px solid var(--border);padding-left:4px">${d.getMonth()+1}/${d.getDate()}</div>`;
    }
  }
  html += `</div></div>`;

  rows.forEach((r, i) => {
    const bg = r.type==='project' ? 'rgba(14,165,233,.1)' : (r.type==='phase' ? 'rgba(16,185,129,.05)' : (i%2?'var(--surface)':'var(--surface2)'));
    const pad = r.type==='project' ? '10px' : (r.type==='phase' ? '20px' : '36px');
    const fw = r.type==='task' ? 'normal' : '600';
    html += `<div style="display:flex;border-bottom:1px solid var(--border);background:${bg}">
      <div style="width:280px;flex-shrink:0;padding:8px 10px 8px ${pad};font-weight:${fw};font-size:.85rem;border-right:1px solid var(--border);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${r.label}</div>
      <div style="flex:1;position:relative;height:36px">`;
    if(r.start && r.end){
      const s = new Date(r.start), e = new Date(r.end);
      if(s <= e){
        const sDiff = Math.round((s.getTime() - timeStart) / (1000 * 60 * 60 * 24));
        const duration = Math.round((e.getTime() - s.getTime()) / (1000 * 60 * 60 * 24));
        const lPct = (sDiff / totalDays) * 100;
        const wPct = ((duration + 1) / totalDays) * 100; 
        const col = r.type==='project' ? '#0284c7' : (r.type==='phase' ? '#16a34a' : 'var(--accent)');
        const h = r.type==='task' ? '20px' : '6px';
        const t = r.type==='task' ? '8px' : '15px';
        html += `<div style="position:absolute;left:${lPct}%;width:${wPct}%;top:${t};height:${h};background:${col};border-radius:4px;opacity:0.8;display:flex;align-items:center;overflow:hidden">`;
        if(r.type==='task'){ html += `<div style="background:rgba(0,0,0,0.2);height:100%;width:${r.pct}%"></div><span style="position:absolute;left:4px;color:#fff;font-size:.65rem">${r.owner||''}</span>`; }
        html += `</div>`;
      }
    }
    html += `</div></div>`;
  });
  html += `</div>`;
  container.innerHTML = html; openModal('ganttOverlay');
}

async function exportGanttXlsx(){
  if(selectedGanttProjs.size === 0) return;
  if(typeof ExcelJS === 'undefined'){ showDialog('ExcelJS 尚未載入'); return; }
  const wb = new ExcelJS.Workbook(); const ws = wb.addWorksheet('甘特圖', {views:[{showGridLines:false}]});
  const projs = [...selectedGanttProjs].map(i => DATA[i]).filter(Boolean);
  const rows = []; let minD = new Date('2099-01-01'), maxD = new Date('2000-01-01');
  
  projs.forEach(p => {
    rows.push({ lvl: 1, name: p.name, start: p.startDate, end: p.dueDate });
    if(p.startDate) minD = new Date(Math.min(minD, new Date(p.startDate))); if(p.dueDate) maxD = new Date(Math.max(maxD, new Date(p.dueDate)));
    (p.phases||[]).forEach(ph => {
      rows.push({ lvl: 2, name: ph.name, start: ph.startDate, end: ph.dueDate });
      (ph.tasks||[]).forEach(t => {
        if(!t.startDate || !t.dueDate) return;
        rows.push({ lvl: 3, name: t.name, owner: t.person, start: t.startDate, end: t.dueDate });
        minD = new Date(Math.min(minD, new Date(t.startDate))); maxD = new Date(Math.max(maxD, new Date(t.dueDate)));
      });
    });
  });

  if(rows.length===0 || minD>maxD){ showDialog('無有效日期資料可匯出'); return; }
  const weeks = []; let curr = new Date(minD);
  const dow = curr.getDay(); curr.setDate(curr.getDate() - (dow===0?6:dow-1)); maxD.setDate(maxD.getDate() + 7);
  while(curr <= maxD){ weeks.push(new Date(curr)); curr.setDate(curr.getDate()+7); }

  ws.getColumn(1).width=4; ws.getColumn(2).width=30; ws.getColumn(3).width=10; ws.getColumn(4).width=12; ws.getColumn(5).width=12;
  weeks.forEach((w,i) => ws.getColumn(6+i).width=5); 
  ws.getRow(1).height=24;
  ['層級','項目','負責人','開始日','完成日'].forEach((h,i) => {
    const c = ws.getCell(1, i+1); c.value=h; c.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FF1F3864'}}; c.font={color:{argb:'FFFFFFFF'},bold:true}; c.alignment={horizontal:'center',vertical:'middle'};
  });
  weeks.forEach((w,i) => {
    const c = ws.getCell(1, 6+i); c.value=`${w.getMonth()+1}/${w.getDate()}`; c.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FFD6E4F0'}}; c.font={color:{argb:'FF1F3864'},size:9}; c.alignment={horizontal:'center',vertical:'middle'}; c.border={left:{style:'thin',color:{argb:'FFCCCCCC'}}};
  });
  ws.views = [{state:'frozen', xSplit:5, ySplit:1, showGridLines:false}];

  let rIdx = 2;
  rows.forEach(r => {
    ws.getRow(rIdx).height = 18;
    const isP=r.lvl===1, isPh=r.lvl===2;
    const bg = isP?'FFE0F2FE':(isPh?'FFF0FDF4':'FFFFFFFF');
    const fnt = isP?{bold:true,color:{argb:'FF0284C7'}}:(isPh?{bold:true,color:{argb:'FF16A34A'}}:{});
    const ind = isP?'':(isPh?'   ':'      ');
    [r.lvl, ind+r.name, r.owner||'', r.start||'', r.end||''].forEach((v,i) => {
      const c = ws.getCell(rIdx, i+1); c.value=v; c.fill={type:'pattern',pattern:'solid',fgColor:{argb:bg}}; c.font=fnt; c.alignment={vertical:'middle'}; c.border={bottom:{style:'thin',color:{argb:'FFEEEEEE'}}};
    });
    if(r.start && r.end){
      const sD=new Date(r.start), eD=new Date(r.end);
      const bar = isP?'FF38BDF8':(isPh?'FF4ADE80':'FF60A5FA');
      weeks.forEach((w,wi) => {
        const wEnd = new Date(w); wEnd.setDate(wEnd.getDate()+6);
        const c = ws.getCell(rIdx, 6+wi);
        if(sD<=wEnd && eD>=w){ c.fill={type:'pattern',pattern:'solid',fgColor:{argb:bar}}; if(isP||isPh)c.border={top:{style:'thin',color:{argb:bar}},bottom:{style:'thin',color:{argb:bar}}}; }
        else { c.fill={type:'pattern',pattern:'solid',fgColor:{argb:bg}}; c.border={left:{style:'thin',color:{argb:'FFEEEEEE'}}}; }
      });
    }
    rIdx++;
  });

  const buf = await wb.xlsx.writeBuffer();
  const blob = new Blob([buf], {type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
  a.download = '甘特圖_'+todayStr()+'.xlsx'; a.click();
}

