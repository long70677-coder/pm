    html += `
    <div class="proj-card ${isOpen} ${p.starred?'starred':''}" id="proj-${pIdx}">
      <div class="proj-header" onclick="toggleCard(${pIdx})">
        <div style="display:flex;align-items:flex-start;gap:12px;flex:1">
          <input type="checkbox" ${isChecked} onclick="event.stopPropagation();toggleGantt(${pIdx})" style="width:18px;height:18px;margin-top:4px;cursor:pointer;accent-color:var(--accent)">
          <button onclick="event.stopPropagation();toggleStar(${pIdx})" style="background:none;border:none;font-size:1.2rem;cursor:pointer;padding:0;color:${p.starred?'#f59e0b':'var(--text3)'}">${p.starred?'⭐':'☆'}</button>
          
          <div style="flex:1">
            <div style="display:flex;align-items:center;gap:8px">
              <span class="proj-id">${p.id}</span>
              <span class="badge b-${p.status}">${p.status}</span>
              <span style="font-size:.75rem;color:var(--text2)">🗂️ ${p.type||'未分類'}</span>
            </div>
            <div class="proj-title">${p.name}</div>
            <div style="font-size:.8rem;color:var(--text2)">👤 PM: ${p.owner||'未定'} ｜ 📅 ${p.startDate||'?'} ~ ${p.dueDate||'?'}</div>
            
            <div class="dual-wrap">
              <div class="dp-row">
                <span class="dp-label">實際進度</span>
                <div class="dp-bg"><div class="dp-fill-actual" style="width:${prog.actual}%"></div></div>
                <span class="dp-pct a">${prog.actual}%</span>
                ${diffTag}
              </div>
              <div class="dp-row">
                <span class="dp-label">預期進度</span>
                <div class="dp-bg"><div class="dp-fill-expect" style="width:${prog.expect}%"></div></div>
                <span class="dp-pct e">${prog.expect}%</span>
              </div>
            </div>

          </div>
        </div>
        
        <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end" onclick="event.stopPropagation()">
          <div style="display:flex;gap:6px">
            <button class="btn gray small" onclick="openProjModal(${pIdx})">✏️ 編輯專案</button>
            <button class="btn red small" onclick="delProj(${pIdx})">🗑</button>
          </div>
          <span style="color:var(--text3);font-size:1.2rem">${isOpen?'▲':'▼'}</span>
