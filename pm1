    </div>
  `).join('');
}
function addMember(){
  const val = document.getElementById('newMemberInp').value.trim();
  if(val && !MEMBERS.includes(val)){
    MEMBERS.push(val); saveMembers(); renderMemberList();
    document.getElementById('newMemberInp').value = ''; updateFilterOptions(); render();
  }
}
function delMember(idx){
  MEMBERS.splice(idx, 1); saveMembers(); renderMemberList(); updateFilterOptions(); render();
}

function updateFilterOptions(){
  const types = new Set();
  const owners = new Set(MEMBERS);
  DATA.forEach(p => { if(p.type) types.add(p.type); if(p.owner) owners.add(p.owner); });
  
  const mkOpts = (id, def, set) => {
    const sel = document.getElementById(id);
    const cur = sel.value;
    sel.innerHTML = `<option value="">${def}</option>` + [...set].map(v=>`<option value="${v}">${v}</option>`).join('');
    sel.value = cur;
  };
  mkOpts('filterType', '全部類型', types);
  mkOpts('filterOwner', '全部 PM', owners);
  document.getElementById('typeList').innerHTML = [...types].map(t=>`<option value="${t}">`).join('');
}

function clearFilters(){
  ['filterType', 'filterStatus', 'filterOwner', 'filterSearch'].forEach(id => document.getElementById(id).value = '');
  render();
}

function calcProgress(proj){
  let taskCount=0, actualSum=0, expectSum=0;
  const today = todayStr();
  (proj.phases||[]).forEach(ph => {
    (ph.tasks||[]).forEach(t => {
      taskCount++;
      if(t.status === '已完成') actualSum += 100;
      else if(t.status === '進行中') actualSum += (t.pct||0);
      
      if(t.dueDate && t.dueDate <= today) expectSum += 100;
      else if(t.startDate && t.startDate <= today && t.dueDate && t.dueDate > today){
        const totalD = new Date(t.dueDate) - new Date(t.startDate);
        const passD = new Date() - new Date(t.startDate);
        if(totalD>0) expectSum += Math.min(100, Math.max(0, (passD/totalD)*100));
      }
    });
  });
  if(taskCount===0) return { actual:0, expect:0 };
  return { actual: Math.round(actualSum/taskCount), expect: Math.round(expectSum/taskCount) };
}

function render(){
