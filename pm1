  document.getElementById('p-name').value = p.name || '';
  document.getElementById('p-type').value = p.type || '一般';
  document.getElementById('p-owner').innerHTML = `<option value="">選擇</option>` + MEMBERS.map(m => `<option value="${m}" ${p.owner===m?'selected':''}>${m}</option>`).join('');
  document.getElementById('p-status').value = p.status || '待開始';
  document.getElementById('p-start').value = p.startDate || '';
  document.getElementById('p-due').value = p.dueDate || '';
  document.getElementById('p-note').value = p.note || '';
  openModal('projOverlay');
}
function saveProj(){
  const p = {
    id: document.getElementById('p-id').value, name: document.getElementById('p-name').value || '未命名',
    type: document.getElementById('p-type').value, owner: document.getElementById('p-owner').value,
    status: document.getElementById('p-status').value, startDate: document.getElementById('p-start').value,
    dueDate: document.getElementById('p-due').value, note: document.getElementById('p-note').value,
    phases: editP >= 0 ? DATA[editP].phases : [], starred: editP >= 0 ? DATA[editP].starred : false
  };
  if(editP >= 0) DATA[editP] = p; else { DATA.unshift(p); openCards.add(0); }
  saveData(); closeModal('projOverlay'); render(); showToast('✅ 專案已儲存');
}

function delProj(idx) { 
  showDialog('確定刪除此專案與所有內容？', '刪除確認', true, () => {
    DATA.splice(idx,1); selectedGanttProjs.delete(idx); saveData(); render(); showToast('🗑 已刪除專案');
  });
}

function openPhaseModal(pIdx, phIdx = -1){
  editP = pIdx; editPh = phIdx; const ph = phIdx >= 0 ? DATA[pIdx].phases[phIdx] : {};
  document.getElementById('phaseModalTitle').textContent = phIdx >= 0 ? '編輯階段' : '新增階段';
