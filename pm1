  const viewData = DATA.filter(p => {
    if(fType && p.type !== fType) return false;
    if(fStatus && p.status !== fStatus) return false;
    if(fOwner && p.owner !== fOwner) return false;
    if(fSearch){
      const matchP = p.name.toLowerCase().includes(fSearch) || p.id.toLowerCase().includes(fSearch);
      const matchT = (p.phases||[]).some(ph => ph.name.toLowerCase().includes(fSearch) || (ph.tasks||[]).some(t => t.name.toLowerCase().includes(fSearch)));
