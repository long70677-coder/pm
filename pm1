      </div>

      <div class="proj-body">
        <div style="margin-bottom:12px"><button class="btn small" onclick="openPhaseModal(${pIdx})">＋ 新增階段</button></div>
        ${renderPhases(p, pIdx)}
      </div>
    </div>`;
  });

  board.innerHTML = html;
  document.getElementById('ganttBtn').style.display = selectedGanttProjs.size > 0 ? 'inline-flex' : 'none';
  renderSidebar();
