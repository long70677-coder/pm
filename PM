// 初始化階段拖曳排序，讓階段可以在專案內拖曳調整順序
function initPhaseDragSort(pi){
  const container=document.getElementById(`phases-${pi}`);
  if(!container) return;
  let dragPhi=null;
  container.querySelectorAll('.phase-drag-handle').forEach(handle=>{
    handle.addEventListener('mousedown',()=>{
      const block=handle.closest('.phase-block');
      if(block) block.draggable=true;
    });
  });
  container.addEventListener('dragstart',e=>{
    const block=e.target.closest('.phase-block[data-phi]');
    if(!block) return;
    dragPhi=parseInt(block.dataset.phi);
    block.classList.add('dragging-row');
    e.dataTransfer.effectAllowed='move';
  });
  container.addEventListener('dragend',e=>{
    const block=e.target.closest('.phase-block');
    if(block){ block.classList.remove('dragging-row'); block.draggable=false; }
    container.querySelectorAll('.phase-block').forEach(b=>b.classList.remove('drag-over-top','drag-over-bot'));
    dragPhi=null;
  });
  container.addEventListener('dragover',e=>{
    e.preventDefault();
    const block=e.target.closest('.phase-block[data-phi]');
    if(!block) return;
    const overPhi=parseInt(block.dataset.phi);
    if(overPhi===dragPhi) return;
    container.querySelectorAll('.phase-block').forEach(b=>b.classList.remove('drag-over-top','drag-over-bot'));
    const rect=block.getBoundingClientRect();
    block.classList.add(e.clientY<rect.top+rect.height/2?'drag-over-top':'drag-over-bot');
  });
  container.addEventListener('drop',e=>{
    e.preventDefault();
    const block=e.target.closest('.phase-block[data-phi]');
    if(!block||dragPhi===null) return;
    const overPhi=parseInt(block.dataset.phi);
    if(overPhi===dragPhi) return;
    const rect=block.getBoundingClientRect();
    const insertAfter=e.clientY>=rect.top+rect.height/2;
    const phases=DATA.projects[pi].phases;
    const [moved]=phases.splice(dragPhi,1);
    let idx=overPhi>dragPhi?overPhi-1:overPhi;
    if(insertAfter) idx++;
    phases.splice(idx,0,moved);
    saveData(); render();
  });
}

