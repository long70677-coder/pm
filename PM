        const phRowObj=ws.getRow(rowNum);
        phRowObj.getCell(1).font={italic:true,size:9,name:'微軟正黑體',color:{argb:'FF007AFF'}};
        phRowObj.getCell(1).fill={type:'pattern',pattern:'solid',fgColor:{argb:'FFF0F4FF'}};
        if(ph.startDate&&ph.dueDate){
          const si=days.findIndex(d=>dayStr(d)>=ph.startDate)+2;
          const ei=days.findIndex(d=>dayStr(d)>=ph.dueDate);
          const endCol=ei<0?days.length+1:ei+2;
          const phC=phaseArgbs[phi%phaseArgbs.length];
          for(let ci=si;ci<=endCol;ci++){
            phRowObj.getCell(ci).fill={type:'pattern',pattern:'solid',fgColor:{argb:phC+'55'}};
          }
        }
        days.forEach((d,di)=>{ if(d.getDay()===0||d.getDay()===6){ const cell=phRowObj.getCell(di+2); if(!cell.fill?.fgColor||cell.fill.fgColor.argb==='FF000000') cell.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FFF2F2F7'}}; } });
        rowNum++;
        (ph.tasks||[]).forEach(t=>{
          const tRow=[`    ↳ ${t.name}${t.person?' 👤'+t.person:''}`,...days.map(()=>'')];
          ws.addRow(tRow);
          ws.getRow(rowNum).height=14;
          const tRowObj=ws.getRow(rowNum);
          tRowObj.getCell(1).font={size:8,name:'微軟正黑體'};
          if(t.startDate&&t.dueDate){
            const si=days.findIndex(d=>dayStr(d)>=t.startDate)+2;
            const ei=days.findIndex(d=>dayStr(d)>=t.dueDate);
            const endCol=ei<0?days.length+1:ei+2;
            const tc=statusArgb[t.status]||'FFAEAEB2';
            for(let ci=si;ci<=endCol;ci++){
              tRowObj.getCell(ci).fill={type:'pattern',pattern:'solid',fgColor:{argb:tc+'60'}};
            }
          }
          days.forEach((d,di)=>{ if(d.getDay()===0||d.getDay()===6){ const cell=tRowObj.getCell(di+2); if(!cell.fill?.fgColor||cell.fill.fgColor.argb==='FF000000') cell.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FFF2F2F7'}}; } });
          rowNum++;
        });
      });
    });
    const buf=await wb.xlsx.writeBuffer();
    const blob=new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a'); a.href=url; a.download=`甘特圖_${todayStr()}.xlsx`; a.click();
    URL.revokeObjectURL(url);
    showToast('✅ 甘特圖 xlsx 匯出完成');
  } catch(e){ showToast('匯出失敗：'+e.message); console.error(e); }
  btn.disabled=false; btn.textContent='📥 匯出 xlsx';
}

// ══════════════════════════════════════════════════════
//  初始化
// ══════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded',()=>{
  initTheme();
  render();
  window.addEventListener('resize',setMainHeight);
  setMainHeight();
});
</script>
