let _openCards=new Set();
let _openPhases={};
// 切換專案卡片展開/收合
function toggleCard(pi){ if(_openCards.has(pi)) _openCards.delete(pi); else _openCards.add(pi); render(); }
// 切換階段展開/收合
function togglePhase(pi,phi){ const k=`${pi}-${phi}`; if(_openPhases[k]) delete _openPhases[k]; else _openPhases[k]=true; render(); }
// 展開所有專案卡片
function expandAll(){ DATA.projects.forEach((_,i)=>_openCards.add(i)); render(); }
// 收合所有專案卡片
function collapseAll(){ _openCards.clear(); _openPhases={}; render(); }

