<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>專案管理看板 v1</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
<style>
/* ── 全域變數 ── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f5f5f7;--surface:#fff;--surface2:#f2f2f7;--border:#d2d2d7;
  --text:#1d1d1f;--text2:#6e6e73;--text3:#aeaeb2;
  --accent:#007aff;--green:#34c759;--red:#ff3b30;--orange:#ff9500;--purple:#af52de;
  --shadow-s:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.04);
  --shadow-m:0 4px 16px rgba(0,0,0,.10);--shadow-l:0 8px 32px rgba(0,0,0,.14);
  --rs:8px;--rm:12px;--rl:16px;--rxl:20px;
}
body.dark{
  --bg:#000;--surface:#1c1c1e;--surface2:#2c2c2e;--border:#4a4a4c;
  --text:#f5f5f7;--text2:#d1d1d6;--text3:#8e8e93;
  --shadow-s:0 1px 3px rgba(0,0,0,.5);--shadow-m:0 4px 16px rgba(0,0,0,.5);--shadow-l:0 8px 32px rgba(0,0,0,.6);
}
body{font-family:-apple-system,SF Pro Text,Microsoft JhengHei,Segoe UI,sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;transition:background .3s,color .3s;margin:0}

/* ── Header ── */
header{background:rgba(255,255,255,.88);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:13px 28px;display:flex;align-items:center;justify-content:space-between;box-shadow:var(--shadow-s);z-index:200;flex-shrink:0}
body.dark header{background:rgba(28,28,30,.92)}
header h1{font-size:1.15rem;font-weight:700;letter-spacing:-.3px;color:var(--text)}
header .subtitle{font-size:.72rem;color:var(--text2);margin-top:2px}
.hdr-right{display:flex;align-items:center;gap:10px}
.save-ind{font-size:.72rem;background:var(--surface2);color:var(--text2);padding:4px 12px;border-radius:20px;border:1px solid var(--border)}
.theme-btn{background:var(--surface2);border:1px solid var(--border);border-radius:20px;padding:4px 14px;cursor:pointer;font-size:.78rem;color:var(--text2);transition:all .2s}
.theme-btn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}

/* ── Toolbar ── */
.toolbar{background:var(--surface);padding:10px 28px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;border-bottom:1px solid var(--border)}
.btn{background:var(--accent);color:#fff;border:none;border-radius:var(--rs);padding:7px 16px;cursor:pointer;font-size:.8rem;font-weight:500;transition:all .18s;white-space:nowrap;display:inline-flex;align-items:center;gap:4px}
.btn:hover{filter:brightness(1.1);transform:translateY(-1px);box-shadow:var(--shadow-s)}
.btn:active{transform:translateY(0);filter:brightness(.95)}
.btn.green{background:var(--green)}
.btn.gray{background:var(--surface2);color:var(--text);border:1px solid var(--border)}
.btn.gray:hover{background:var(--border);filter:none;transform:none}
.btn.red{background:var(--red)}

/* ── 篩選列 ── */
.filter-bar{background:var(--surface2);padding:5px 20px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;border-bottom:1px solid var(--border)}
.filter-bar select,.filter-bar input{border:1px solid var(--border);border-radius:var(--rs);padding:4px 8px;font-size:.8rem;background:var(--surface);color:var(--text);outline:none}
.filter-bar select:focus,.filter-bar input:focus{border-color:var(--accent)}

/* ── Stats ── */
.stats-bar{display:flex;gap:12px;padding:14px 28px;background:var(--surface);border-bottom:1px solid var(--border);flex-wrap:wrap}
.stat-card{background:var(--surface2);border-radius:var(--rm);padding:10px 20px;text-align:center;min-width:86px;border:1px solid var(--border);cursor:pointer;transition:transform .15s,box-shadow .15s}
.stat-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-m)}
.stat-card .num{font-size:1.55rem;font-weight:700;color:var(--accent)}
.stat-card.or .num{color:var(--orange)}.stat-card.gr .num{color:var(--green)}.stat-card.rd .num{color:var(--red)}
.stat-card .lbl{font-size:.7rem;color:var(--text2);margin-top:2px}

/* ── 主內容區 ── */
.main-layout{position:relative;overflow:hidden}
.board-col{position:absolute;top:0;left:0;right:300px;bottom:0;overflow-y:scroll;transition:right .3s}
.sidebar{position:absolute;top:0;right:0;bottom:0;width:300px;background:var(--surface);border-left:1px solid var(--border);overflow-y:auto;box-shadow:-2px 0 8px rgba(0,0,0,.06);transition:transform .3s,opacity .3s;z-index:10}
.sidebar.collapsed{transform:translateX(300px);opacity:0;pointer-events:none}
.container{padding:20px 28px}

/* ── 專案卡片 ── */
.proj-card{background:var(--surface);border-radius:var(--rl);margin-bottom:14px;box-shadow:var(--shadow-s);border:1px solid var(--border);overflow:hidden;transition:box-shadow .2s,transform .2s}
.proj-card:hover{box-shadow:var(--shadow-m);transform:translateY(-1px)}
.proj-card[data-status="進行中"]{border-left:4px solid var(--accent)}
.proj-card[data-status="待開始"]{border-left:4px solid var(--text3)}
.proj-card[data-status="已完成"]{border-left:4px solid var(--green)}
.proj-card[data-status="擱置"]{border-left:4px solid var(--red)}
.proj-card.starred{border:2px solid #f59e0b;box-shadow:0 0 0 3px rgba(245,158,11,.15)}

/* ── 卡片標題列 ── */
.proj-header{padding:14px 18px;display:flex;align-items:flex-start;gap:10px;flex-wrap:wrap}
.proj-header-left{display:flex;flex-direction:column;gap:6px;flex:1;cursor:pointer}
.proj-header-left:hover .proj-title{color:var(--accent)}
.proj-header-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.proj-id{font-size:.7rem;color:var(--text3);font-family:SF Mono,Menlo,monospace}
.proj-title{font-weight:600;font-size:.96rem;color:var(--text)}
.badge{font-size:.68rem;padding:3px 10px;border-radius:20px;font-weight:600;white-space:nowrap}
.b-blue{background:rgba(0,122,255,.12);color:var(--accent)}
.b-gray{background:var(--surface2);color:var(--text2);border:1px solid var(--border)}
.b-green{background:rgba(52,199,89,.12);color:var(--green)}
.b-red{background:rgba(255,59,48,.12);color:var(--red)}
.b-orange{background:rgba(255,149,0,.12);color:var(--orange)}
.b-type{background:rgba(255,149,0,.12);color:var(--orange)}
.meta-row{display:flex;gap:14px;flex-wrap:wrap}
.meta-item{font-size:.74rem;color:var(--text2)}
.toggle-icon{font-size:.88rem;color:var(--text3);cursor:pointer;padding:4px 8px;margin-top:2px;transition:transform .2s}
.proj-card.open .toggle-icon{transform:rotate(180deg)}
.proj-header-actions{display:flex;gap:4px;align-items:flex-start}

/* ── 整體進度條 ── */
.proj-progress{padding:0 18px 12px;display:flex;flex-direction:column;gap:4px}
.pp-row{display:flex;align-items:center;gap:8px}
.pp-label{font-size:.68rem;color:var(--text3);width:52px;text-align:right;flex-shrink:0}
.pp-bg{flex:1;height:6px;background:var(--surface2);border-radius:10px;overflow:hidden}
.pp-fill{height:100%;border-radius:10px;transition:width .4s}
.pp-pct{font-size:.7rem;font-weight:600;min-width:36px}

/* ── 階段 + 任務區 ── */
.phases{display:none;border-top:1px solid var(--border)}
.proj-card.open .phases{display:block}


/* ── 階段列固定欄位 ── */
.phase-meta{display:flex;align-items:center;gap:0;flex-wrap:nowrap}
.pm-col{display:inline-flex;align-items:center;flex-shrink:0}
.pm-sep{color:var(--text3);font-size:.72rem;margin:0 3px;flex-shrink:0}
.pm-status{width:70px}
.pm-start{width:116px;margin-left:6px}
.pm-due{width:116px}
.pm-pct{width:44px;margin-left:6px;justify-content:flex-end}
.pm-dur{width:100px;margin-left:8px}
.pm-dur-badge{font-size:.66rem;background:rgba(0,122,255,.1);color:var(--accent);border-radius:10px;padding:1px 8px;font-weight:600;white-space:nowrap}
.pm-dur-empty{font-size:.72rem;color:var(--text3)}

/* ── 階段 ── */
.phase-block{border-bottom:1px solid var(--border)}
.phase-block:last-child{border-bottom:none}
.phase-header{display:flex;align-items:center;gap:8px;padding:8px 18px 8px 24px;background:var(--surface2);cursor:pointer;user-select:none;transition:background .15s}
.phase-header:hover{background:var(--border)}
.phase-toggle{font-size:.72rem;color:var(--text3);transition:transform .2s;flex-shrink:0}
.phase-block.open .phase-toggle{transform:rotate(90deg)}
.phase-name-inp{border:none;background:transparent;font-size:.84rem;font-weight:600;color:var(--text);outline:none;flex:1;cursor:text;min-width:80px}
.phase-name-inp:focus{background:var(--surface);border-radius:4px;padding:1px 4px}
.phase-badge{font-size:.66rem;padding:2px 8px;border-radius:10px;white-space:nowrap}
.phase-meta{font-size:.7rem;color:var(--text2);display:flex;gap:8px;flex-wrap:wrap}
.phase-actions{display:flex;gap:2px;margin-left:auto;flex-shrink:0}
.phase-actions button{background:none;border:none;cursor:pointer;font-size:.8rem;color:var(--text3);padding:2px 4px;border-radius:4px;transition:all .15s}
.phase-actions button:hover{background:var(--surface);color:var(--accent)}

/* ── 任務表格 ── */
.tasks-wrap{display:none;overflow-x:auto}
.phase-block.open .tasks-wrap{display:block}
.task-table{width:auto;min-width:100%;border-collapse:collapse;table-layout:fixed}
.task-table thead tr{background:var(--surface2)}
.task-table thead th{padding:6px 8px;font-size:.66rem;color:var(--text2);font-weight:600;text-align:left;white-space:nowrap;position:relative;user-select:none;border-bottom:1px solid var(--border);border-right:1px solid var(--border)}
.task-table thead th:last-child{border-right:none}
.task-table tbody tr{border-bottom:1px solid var(--border);transition:background .15s}
.task-table tbody tr:hover{background:var(--surface2)}
.task-table tbody tr.done{opacity:.55;background:rgba(52,199,89,.06)}
.task-table tbody tr.wip{background:rgba(255,149,0,.07)}
.task-table td{padding:6px 8px;vertical-align:middle;overflow:hidden;font-size:.8rem;color:var(--text)}
/* 欄寬拖曳 */
.rz{position:absolute;right:0;top:0;bottom:0;width:6px;cursor:col-resize;background:transparent;z-index:2}
.rz:hover,.rz.dragging{background:var(--accent);opacity:.5}
/* 拖曳把手 */
.drag-handle{width:28px;min-width:28px;cursor:grab;text-align:center;color:var(--text3);font-size:.85rem;user-select:none;padding:0 2px}
.drag-handle:active{cursor:grabbing}
.drag-handle:hover{color:var(--accent)}
tr.drag-over-top{box-shadow:inset 0 2px 0 var(--accent)}
tr.drag-over-bot{box-shadow:inset 0 -2px 0 var(--accent)}
tr.dragging-row{opacity:.35}

/* ── 輸入元件 ── */
.di{font-size:.78rem;border:1px solid var(--border);border-radius:var(--rs);padding:3px 5px;outline:none;color:var(--text);background:var(--surface2);width:100%;transition:border-color .2s}
.di:focus{border-color:var(--accent);background:var(--surface)}
.di.done-date{background:rgba(52,199,89,.1);color:var(--green);border-color:var(--green)}
.di:disabled{opacity:.4;cursor:not-allowed}
.es{font-size:.78rem;border:1px solid var(--border);border-radius:var(--rs);padding:3px 5px;outline:none;background:var(--surface2);color:var(--text);width:100%;cursor:pointer}
.es:focus{border-color:var(--accent)}
.pc-wrap{display:flex;align-items:center;gap:5px}
.pc-bar{flex:1;height:5px;background:var(--surface2);border-radius:10px;overflow:hidden;cursor:pointer;min-width:30px}
.pc-fill{height:100%;border-radius:10px;transition:width .3s}
.pc-inp{width:36px;font-size:.7rem;border:1px solid var(--border);border-radius:var(--rs);padding:2px 3px;text-align:center;outline:none;background:var(--surface2);color:var(--text)}
.pc-inp:focus{border-color:var(--accent)}
.add-task-row{padding:6px 18px 6px 28px}
.add-task-row button{font-size:.76rem;color:var(--accent);background:none;border:1px dashed var(--accent);border-radius:var(--rs);padding:4px 14px;cursor:pointer;transition:all .15s}
.add-task-row button:hover{background:rgba(0,122,255,.08)}
.add-phase-row{padding:8px 18px 8px 28px;border-top:1px dashed var(--border)}
.add-phase-row button{font-size:.76rem;color:var(--text2);background:none;border:1px dashed var(--border);border-radius:var(--rs);padding:4px 14px;cursor:pointer;transition:all .15s}
.add-phase-row button:hover{border-color:var(--accent);color:var(--accent)}
/* Tag 輸入 */
.multi-tag-wrap{display:flex;flex-wrap:wrap;gap:4px;border:1px solid var(--border);border-radius:var(--rs);padding:6px 8px;min-height:36px;background:var(--surface2);cursor:text;align-items:center}
.multi-tag-wrap:focus-within{border-color:var(--accent);background:var(--surface)}
.m-tag{background:rgba(0,122,255,.12);color:var(--accent);border-radius:12px;padding:2px 8px;font-size:.75rem;display:inline-flex;align-items:center;gap:4px}
.m-tag .rm{cursor:pointer;color:var(--text3);font-size:.8rem}
.m-tag .rm:hover{color:var(--red)}
.m-tag-input{border:none;outline:none;font-size:.8rem;background:transparent;color:var(--text);min-width:80px;flex:1}

/* ── Modal ── */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;backdrop-filter:blur(6px)}
.overlay.show{display:flex}
.modal{background:var(--surface);border-radius:var(--rxl);padding:26px;width:440px;max-height:92vh;overflow-y:auto;box-shadow:var(--shadow-l);border:1px solid var(--border)}
.modal h3{margin-bottom:14px;color:var(--text);font-size:1.02rem;font-weight:700}
.modal label{font-size:.78rem;color:var(--text2);display:block;margin-bottom:4px;margin-top:10px}
.modal input,.modal select,.modal textarea{width:100%;border:1px solid var(--border);border-radius:var(--rs);padding:8px 10px;font-size:.84rem;font-family:inherit;outline:none;background:var(--surface2);color:var(--text);transition:border-color .2s}
.modal input:focus,.modal select:focus{border-color:var(--accent);background:var(--surface)}
.modal-btns{display:flex;gap:8px;margin-top:18px;justify-content:flex-end}
.date-pair{display:flex;gap:8px}
.date-pair div{flex:1}

/* ── 今日儀表板 ── */
.sidebar-header{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 8px}
.sidebar-header h2{font-size:.9rem;font-weight:700;color:var(--text)}
.sidebar-toggle{background:none;border:none;cursor:pointer;color:var(--text2);font-size:.9rem;padding:2px 6px;border-radius:var(--rs);transition:all .15s}
.sidebar-toggle:hover{background:var(--surface2);color:var(--accent)}
.today-badge{font-size:.72rem;color:var(--text2);padding:3px 10px;background:var(--surface2);border-radius:20px;border:1px solid var(--border);margin:10px 16px 4px;display:inline-block}
.sb-section{padding:10px 12px 4px}
.sb-section-title{font-size:.72rem;font-weight:700;letter-spacing:.4px;text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center;gap:6px}
.sb-section-title.overdue{color:var(--red)}
.sb-section-title.thisweek{color:var(--orange)}
.sb-section-title.upcoming{color:var(--green)}
.sb-item{background:var(--surface2);border:1px solid var(--border);border-radius:var(--rm);padding:8px 10px;margin-bottom:7px;cursor:pointer;transition:all .15s}
.sb-item:hover{border-color:var(--accent);box-shadow:var(--shadow-s);transform:translateX(-2px)}
.sb-item .sb-proj{font-size:.66rem;color:var(--text3);margin-bottom:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-item .sb-phase{font-size:.64rem;color:var(--text3);margin-bottom:2px}
.sb-item .sb-name{font-size:.8rem;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-item .sb-date{font-size:.68rem;margin-top:3px}
.sb-item.overdue .sb-date{color:var(--red)}
.sb-item.thisweek .sb-date{color:var(--orange)}
.sb-item.upcoming .sb-date{color:var(--green)}
.sb-empty{font-size:.78rem;color:var(--text3);padding:8px 12px 12px;text-align:center}
.sb-open-btn{background:none;border:none;cursor:pointer;color:var(--text2);font-size:.78rem;padding:4px 8px;border-radius:var(--rs);transition:all .15s;white-space:nowrap}
.sb-open-btn:hover{background:var(--surface2);color:var(--accent)}

/* ── Drop Zone ── */
#dropZone{margin:40px auto;max-width:480px;border:2px dashed var(--accent);border-radius:var(--rxl);padding:52px 20px;text-align:center;color:var(--accent);background:rgba(0,122,255,.04);cursor:pointer;transition:all .2s}
#dropZone:hover{background:rgba(0,122,255,.09)}
#dropZone .dz-icon{font-size:2.8rem}
#dropZone .dz-title{font-size:1.05rem;font-weight:600;margin-top:10px}
#dropZone .dz-sub{font-size:.82rem;color:var(--text2);margin-top:6px}


/* ── 甘特圖 Modal ── */
.gantt-wrap{overflow-x:auto;overflow-y:auto;max-height:70vh;position:relative}
.gantt-table{border-collapse:collapse;min-width:100%;table-layout:fixed}
.gantt-table th,.gantt-table td{border:1px solid var(--border);padding:0;vertical-align:middle}
.gantt-head-sticky{position:sticky;top:0;z-index:10;background:var(--surface2)}
.g-label{background:var(--surface2);font-size:.72rem;font-weight:600;color:var(--text);padding:4px 8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border-right:2px solid var(--border)!important}
.g-label.phase{background:rgba(0,122,255,.07);font-size:.74rem;color:var(--accent);padding-left:10px}
.g-label.task{background:var(--surface);font-size:.7rem;color:var(--text2);padding-left:22px}
.g-head-month{font-size:.68rem;font-weight:700;color:var(--text2);text-align:center;padding:3px 4px;background:var(--surface2)}
.g-head-day{font-size:.6rem;color:var(--text3);text-align:center;padding:2px 1px;min-width:18px;width:18px;background:var(--surface2)}
.g-head-day.today{background:rgba(255,59,48,.12);color:var(--red);font-weight:700}
.g-head-day.weekend{background:var(--surface2);color:var(--text3);opacity:.45}
.g-cell{width:18px;min-width:18px;height:26px;padding:0}
.g-cell.weekend{background:repeating-linear-gradient(135deg,transparent,transparent 3px,rgba(0,0,0,.04) 3px,rgba(0,0,0,.04) 6px)}
.g-cell.today-col{background:rgba(255,59,48,.06)}
.g-bar{height:14px;border-radius:7px;margin:6px auto;display:block;position:relative;min-width:4px;cursor:pointer;transition:filter .15s;opacity:.9}
.g-bar:hover{filter:brightness(1.15);opacity:1}
.g-bar.proj{height:10px;border-radius:5px;margin:8px auto}
.g-bar.phase-bar{height:12px;border-radius:6px;margin:7px auto}
.g-bar.done{opacity:.55}
.gantt-legend{display:flex;gap:14px;flex-wrap:wrap;padding:10px 0 4px;font-size:.72rem;color:var(--text2)}
.gantt-legend span{display:flex;align-items:center;gap:5px}
.gantt-legend .dot{width:12px;height:12px;border-radius:50%;display:inline-block}
/* ── 甘特圖大 Modal ── */
.modal-xl{width:min(96vw,1200px);max-height:94vh;padding:20px}

/* ── Toast ── */
.toast{position:fixed;bottom:24px;right:24px;background:var(--text);color:var(--bg);padding:10px 20px;border-radius:var(--rm);font-size:.82rem;z-index:9999;box-shadow:var(--shadow-l);opacity:0;transition:opacity .3s;pointer-events:none}
.toast.show{opacity:1}
</style>
</head>
<body>
<div id="appWrapper" style="display:flex;flex-direction:column;height:100vh;overflow:clip">

<!-- ── 頂部標題列 ── -->
<header>
  <div>
    <h1>📁 專案管理看板</h1>
    <div class="subtitle">Project Management Board v1</div>
  </div>
  <div class="hdr-right">
    <span class="save-ind" id="saveInd"></span>
    <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
  </div>
</header>

<!-- ── 工具列 ── -->
<div style="flex-shrink:0;z-index:100">
  <div class="toolbar">
    <button class="btn" onclick="openProjModal(-1)" style="font-weight:700">＋ 新增專案</button>
    <div style="width:1px;height:22px;background:var(--border)"></div>
    <label class="btn gray" style="cursor:pointer;margin:0">
      <input type="file" id="xlsxInput" accept=".xlsx,.xls" style="display:none" onchange="importXlsx(event)">
      📂 匯入
    </label>
    <button class="btn gray" onclick="exportXlsx()">📥 匯出</button>
    <div style="width:1px;height:22px;background:var(--border)"></div>
