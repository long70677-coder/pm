<script>
// ══════════════════════════════════════════════════════
//  常數 / 儲存鍵
// ══════════════════════════════════════════════════════
// 三層結構：專案（Project）→ 階段（Phase）→ 任務（Task）
const SK = { data:'pm_proj_v1_data', theme:'pm_proj_v1_theme' };

// ══════════════════════════════════════════════════════
//  localStorage 工具
// ══════════════════════════════════════════════════════
// 從 localStorage 讀取資料，若不存在則回傳預設值
function load(key, def){ try{ const v=localStorage.getItem(key); return v?JSON.parse(v):def; }catch(e){ return def; } }
// 將資料序列化後存入 localStorage
function save(key, val){ localStorage.setItem(key, JSON.stringify(val)); }
// 儲存主要資料並顯示提示
function saveData(){ save(SK.data, DATA); showSaveInd(); }
// 短暫顯示「已自動儲存」提示
function showSaveInd(){ const el=document.getElementById('saveInd'); el.textContent='✓ 已自動儲存'; clearTimeout(el._t); el._t=setTimeout(()=>el.textContent='',3000); }
// 回傳今日日期字串 yyyy-mm-dd
function todayStr(){ return new Date().toISOString().split('T')[0]; }

// ══════════════════════════════════════════════════════
//  資料初始化
// ══════════════════════════════════════════════════════
const DEFDATA = { members:[], projects:[] };
let DATA = load(SK.data, DEFDATA);
if(!DATA.members) DATA.members=[];
if(!DATA.projects) DATA.projects=[];

// ══════════════════════════════════════════════════════
//  主題切換
// ══════════════════════════════════════════════════════
// 切換亮色／深色主題並儲存偏好
function toggleTheme(){ const dark=document.body.classList.toggle('dark'); save(SK.theme,dark?'dark':'light'); document.getElementById('themeBtn').textContent=dark?'☀️':'🌙'; }
// 初始化主題（頁面載入時讀取上次設定）
function initTheme(){ if(load(SK.theme,'light')==='dark'){ document.body.classList.add('dark'); document.getElementById('themeBtn').textContent='☀️'; } }

// ══════════════════════════════════════════════════════
//  Tag 輸入元件
// ══════════════════════════════════════════════════════
// 初始化多選 Tag 輸入框（支援鍵盤輸入、自動完成建議）
function initTagInput(wrapId, values, suggestions, onChange){
  const wrap=document.getElementById(wrapId);
  if(!wrap) return;
  wrap.innerHTML='';
  const vals=[...values];
  // （內部）重新渲染 Tag 列表
  function refresh(){
    wrap.querySelectorAll('.m-tag').forEach(t=>t.remove());
    vals.forEach((v,i)=>{
      const tag=document.createElement('span'); tag.className='m-tag';
      tag.innerHTML=`${v} <span class="rm" onclick="this.parentNode.remove();vals.splice(${i},1);refresh()">✕</span>`;
      // 重新綁定 rm，因 index 會變
      tag.querySelector('.rm').onclick=()=>{ vals.splice(i,1); refresh(); if(onChange) onChange(vals); };
      wrap.insertBefore(tag, wrap.querySelector('.m-tag-input'));
    });
    if(onChange) onChange(vals);
  }
  const inp=document.createElement('input'); inp.className='m-tag-input'; inp.placeholder='輸入成員…';
  inp.addEventListener('keydown',e=>{
    if((e.key==='Enter'||e.key===',')&&inp.value.trim()){ e.preventDefault(); const v=inp.value.trim(); if(v&&!vals.includes(v)){ vals.push(v); refresh(); } inp.value=''; }
    else if(e.key==='Backspace'&&!inp.value&&vals.length){ vals.pop(); refresh(); }
  });
  if(suggestions&&suggestions.length){
    inp.addEventListener('focus',()=>showSugg(inp,suggestions,vals,refresh));
    inp.addEventListener('input',()=>showSugg(inp,suggestions,vals,refresh));
  }
  wrap.appendChild(inp);
  wrap.getVals=()=>vals;
  refresh();
}
let _suggEl=null;
// 顯示輸入建議下拉選單
function showSugg(inp,suggs,vals,refresh){
  removeSugg();
  const q=inp.value.toLowerCase();
  const filtered=suggs.filter(s=>!vals.includes(s)&&s.toLowerCase().includes(q));
  if(!filtered.length) return;
  _suggEl=document.createElement('div');
  _suggEl.style.cssText='position:fixed;background:var(--surface);border:1px solid var(--border);border-radius:var(--rm);box-shadow:var(--shadow-m);z-index:9999;min-width:120px;overflow:hidden;pointer-events:auto';
  filtered.forEach(s=>{
    const d=document.createElement('div');
    d.textContent=s; d.style.cssText='padding:7px 12px;cursor:pointer;font-size:.82rem;color:var(--text)';
    d.onmouseenter=()=>d.style.background='var(--surface2)';
    d.onmouseleave=()=>d.style.background='';
    d.onmousedown=e=>{ e.preventDefault(); e.stopPropagation(); vals.push(s); refresh(); inp.value=''; setTimeout(removeSugg,0); inp.focus(); };
    _suggEl.appendChild(d);
  });
  const rect=inp.getBoundingClientRect();
  _suggEl.style.left=rect.left+'px'; _suggEl.style.top=rect.bottom+4+'px';
  document.body.appendChild(_suggEl);
}
// 移除輸入建議下拉選單
function removeSugg(){ if(_suggEl){ _suggEl.remove(); _suggEl=null; } }
document.addEventListener('mousedown',e=>{ if(_suggEl&&!_suggEl.contains(e.target)&&!e.target.classList.contains('m-tag-input')) removeSugg(); });
// 取得 Tag 輸入框目前的值陣列
function getTagVals(wrapId){ return document.getElementById(wrapId)?.getVals?.()??[]; }
// 將 Tag 陣列格式化為「、」分隔字串
function fmtTags(arr){ return arr.join('、'); }
// 將分隔字串解析為 Tag 陣列
function parseTags(str){ if(!str||str==='－') return []; return str.split(/[、,]/).map(s=>s.trim()).filter(Boolean); }

// ══════════════════════════════════════════════════════
//  進度計算
// ══════════════════════════════════════════════════════
// 計算階段的完成率（依任務完成率平均）
function calcPhaseProgress(phase){
  const tasks=phase.tasks||[];
  if(!tasks.length) return 0;
  const sum=tasks.reduce((a,t)=>a+(t.status==='已完成'?100:(t.pct||0)),0);
  return Math.round(sum/tasks.length);
}
// 計算專案整體完成率（依所有任務平均）
function calcProjProgress(proj){
  const allTasks=(proj.phases||[]).flatMap(p=>p.tasks||[]);
  if(!allTasks.length) return 0;
  const sum=allTasks.reduce((a,t)=>a+(t.status==='已完成'?100:(t.pct||0)),0);
  return Math.round(sum/allTasks.length);
}
// 依完成率回傳顏色
function pctColor(pct){ return pct>=100?'var(--green)':pct>=60?'var(--accent)':pct>=30?'var(--orange)':'var(--red)'; }

// ══════════════════════════════════════════════════════
//  Modal 控制
// ══════════════════════════════════════════════════════
// 關閉指定 Modal 並重新渲染
function closeModal(id){ document.getElementById(id).classList.remove('show'); render(); }
// 開啟指定 Modal
function openModal(id){ document.getElementById(id).classList.add('show'); }

// ══════════════════════════════════════════════════════
//  專案 CRUD
// ══════════════════════════════════════════════════════
let _editPi=-1;
// 開啟專案新增/編輯 Modal（pi<0 為新增）
function openProjModal(pi){
  _editPi=pi;
  document.getElementById('projModalTitle').textContent=pi<0?'新增專案':'編輯專案';
  const p=pi<0?{}:DATA.projects[pi];
  document.getElementById('p-id').value=p.id||'';
  document.getElementById('p-name').value=p.name||'';
  document.getElementById('p-type').value=p.type||'';
  document.getElementById('p-status').value=p.status||'待開始';
  document.getElementById('p-start').value=p.startDate||'';
  document.getElementById('p-due').value=p.dueDate||'';
  document.getElementById('p-actual').value=p.actualDate||'';
  document.getElementById('p-notes').value=p.notes||'';
  initTagInput('pOwnerWrap', parseTags(p.owner||''), DATA.members);
  initTagInput('pMembersWrap', parseTags(p.members||''), DATA.members);
  openModal('projOverlay');
}
// 儲存專案表單資料
function saveProj(){
  const now=new Date().toISOString();
  const proj={
    id:document.getElementById('p-id').value||('PJ'+Date.now()),
    name:document.getElementById('p-name').value||'未命名專案',
    type:document.getElementById('p-type').value||'',
    owner:fmtTags(getTagVals('pOwnerWrap')),
    members:fmtTags(getTagVals('pMembersWrap')),
    status:document.getElementById('p-status').value,
    startDate:document.getElementById('p-start').value,
    dueDate:document.getElementById('p-due').value,
    actualDate:document.getElementById('p-actual').value,
    notes:document.getElementById('p-notes').value,
    createdDate:_editPi<0?now:(DATA.projects[_editPi].createdDate||now),
    lastUpdated:now,
    phases:_editPi<0?[]:(DATA.projects[_editPi].phases||[]),
    starred:_editPi<0?false:!!(DATA.projects[_editPi].starred),
  };
  if(_editPi<0) DATA.projects.push(proj);
  else DATA.projects[_editPi]=proj;
  saveData(); closeModal('projOverlay');
}
// 刪除指定專案
function deleteProj(pi){ if(!confirm('確定要刪除這個專案嗎？')) return; DATA.projects.splice(pi,1); saveData(); render(); }
// 切換重大專案標記
function toggleStar(pi){ DATA.projects[pi].starred=!DATA.projects[pi].starred; saveData(); render(); }

// ══════════════════════════════════════════════════════
//  階段 CRUD
// ══════════════════════════════════════════════════════
// 新增一個空白階段到指定專案
function addPhase(pi){
  DATA.projects[pi].phases=DATA.projects[pi].phases||[];
  DATA.projects[pi].phases.push({id:'ph'+Date.now(),name:'新階段',owner:'',startDate:'',dueDate:'',status:'待開始',tasks:[]});
  saveData(); render(); setTimeout(()=>{ _openCards.add(pi); render(); },0);
}
// 更新階段名稱（inline 編輯）
function updatePhaseName(pi,phi,val){ DATA.projects[pi].phases[phi].name=val; saveData(); }
// 更新階段欄位值
function updatePhaseField(pi,phi,field,val){ DATA.projects[pi].phases[phi][field]=val; saveData(); renderSidebar(); }
// 刪除指定階段
function deletePhase(pi,phi){ if(!confirm('確定要刪除這個階段？')) return; DATA.projects[pi].phases.splice(phi,1); saveData(); render(); }

// ══════════════════════════════════════════════════════
//  任務 CRUD
// ══════════════════════════════════════════════════════
let _editPi2=-1, _editPhi=-1, _editTi=-1;
// 開啟任務編輯 Modal
function openTaskModal(pi,phi,ti){
  _editPi2=pi; _editPhi=phi; _editTi=ti;
  const t=DATA.projects[pi].phases[phi].tasks[ti];
  document.getElementById('taskModalTitle').textContent='編輯任務';
  document.getElementById('t-name').value=t.name||'';
  document.getElementById('t-status').value=t.status||'待開始';
  document.getElementById('t-start').value=t.startDate||'';
  document.getElementById('t-due').value=t.dueDate||'';
  document.getElementById('t-actual').value=t.actualDate||'';
  document.getElementById('t-pct').value=t.pct||0;
  document.getElementById('tPctLabel').textContent=t.pct||0;
  document.getElementById('t-note').value=t.note||'';
  initTagInput('tPersonWrap', parseTags(t.person||''), DATA.members);
  openModal('taskOverlay');
}
// 儲存任務 Modal 資料
function saveTask(){
  const t=DATA.projects[_editPi2].phases[_editPhi].tasks[_editTi];
  t.name=document.getElementById('t-name').value;
  t.person=fmtTags(getTagVals('tPersonWrap'));
  t.status=document.getElementById('t-status').value;
  t.startDate=document.getElementById('t-start').value;
  t.dueDate=document.getElementById('t-due').value;
  t.actualDate=document.getElementById('t-actual').value;
  t.pct=parseInt(document.getElementById('t-pct').value)||0;
  t.note=document.getElementById('t-note').value;
  if(t.status==='已完成'){ t.pct=100; if(!t.actualDate) t.actualDate=todayStr(); }
  saveData(); closeModal('taskOverlay');
}
// 新增一列空白任務到指定階段
function addTaskRow(pi,phi){
  DATA.projects[pi].phases[phi].tasks=DATA.projects[pi].phases[phi].tasks||[];
  DATA.projects[pi].phases[phi].tasks.push({name:'新任務',person:'',startDate:'',dueDate:'',actualDate:'',status:'待開始',pct:0,note:''});
  saveData(); render();
}
// 複製指定任務
function copyTask(pi,phi,ti){
  const orig=DATA.projects[pi].phases[phi].tasks[ti];
  const copy=JSON.parse(JSON.stringify(orig));
  copy.name+='（複製）'; copy.actualDate=''; copy.status='待開始'; copy.pct=0;
  DATA.projects[pi].phases[phi].tasks.splice(ti+1,0,copy);
  saveData(); render();
}
// 刪除指定任務
function deleteTask(pi,phi,ti){ if(!confirm('確定要刪除這個任務嗎？')) return; DATA.projects[pi].phases[phi].tasks.splice(ti,1); saveData(); render(); }
// 更新任務單一欄位（inline 編輯）
function updateTaskField(pi,phi,ti,field,val){
  const t=DATA.projects[pi].phases[phi].tasks[ti];
  t[field]=val;
  if(field==='status'&&val==='已完成'){ t.pct=100; if(!t.actualDate) t.actualDate=todayStr(); }
  if(field==='status'&&val!=='已完成'){ if(t.pct===100) t.pct=0; }
  saveData(); render();
}
// 更新任務完成率
function updateTaskPct(pi,phi,ti,val){ DATA.projects[pi].phases[phi].tasks[ti].pct=parseInt(val)||0; saveData(); }

// ══════════════════════════════════════════════════════
//  任務欄寬
// ══════════════════════════════════════════════════════
const COL_DEF={name:160,person:120,status:76,start:94,due:94,actual:94,pct:90,note:160,ops:84};
let COL_W={...COL_DEF};
// 啟動滑鼠拖曳調整欄寬
function startColResize(e,col){
  e.preventDefault(); e.stopPropagation();
  const rz=e.target; rz.classList.add('dragging');
  const startX=e.clientX, startW=COL_W[col];
  const onMove=ev=>{ const nw=Math.max(40,startW+ev.clientX-startX); COL_W[col]=nw; document.querySelectorAll(`[data-col-id="${col}"]`).forEach(el=>{ el.style.width=nw+'px'; el.style.maxWidth=nw+'px'; }); };
  const onUp=()=>{ rz.classList.remove('dragging'); document.removeEventListener('mousemove',onMove); document.removeEventListener('mouseup',onUp); document.body.style.cursor=''; document.body.style.userSelect=''; render(); };
  document.body.style.cursor='col-resize'; document.body.style.userSelect='none';
  document.addEventListener('mousemove',onMove); document.addEventListener('mouseup',onUp);
}

// ══════════════════════════════════════════════════════
//  任務拖曳排序（限 ⠿ 把手）
// ══════════════════════════════════════════════════════
// 初始化任務拖曳排序（只有按住 ⠿ 把手才能拖曳）
function initTaskDragSort(pi,phi){
  const tbody=document.querySelector(`#phase-${pi}-${phi} .task-tbody`);
  if(!tbody) return;
  let dragTi=null;
  tbody.querySelectorAll('td.drag-handle').forEach(handle=>{
    handle.addEventListener('mousedown',()=>{ const tr=handle.closest('tr'); if(tr) tr.draggable=true; });
  });
  tbody.addEventListener('dragstart',e=>{ const tr=e.target.closest('tr[data-ti]'); if(!tr) return; dragTi=parseInt(tr.dataset.ti); tr.classList.add('dragging-row'); e.dataTransfer.effectAllowed='move'; });
  tbody.addEventListener('dragend',e=>{ const tr=e.target.closest('tr'); if(tr){ tr.classList.remove('dragging-row'); tr.draggable=false; } tbody.querySelectorAll('tr').forEach(r=>r.classList.remove('drag-over-top','drag-over-bot')); dragTi=null; });
  tbody.addEventListener('dragover',e=>{ e.preventDefault(); const tr=e.target.closest('tr[data-ti]'); if(!tr) return; const overTi=parseInt(tr.dataset.ti); if(overTi===dragTi) return; tbody.querySelectorAll('tr').forEach(r=>r.classList.remove('drag-over-top','drag-over-bot')); const rect=tr.getBoundingClientRect(); tr.classList.add(e.clientY<rect.top+rect.height/2?'drag-over-top':'drag-over-bot'); });
  tbody.addEventListener('drop',e=>{ e.preventDefault(); const tr=e.target.closest('tr[data-ti]'); if(!tr||dragTi===null) return; const overTi=parseInt(tr.dataset.ti); if(overTi===dragTi) return; const rect=tr.getBoundingClientRect(); const insertAfter=e.clientY>=rect.top+rect.height/2; const tasks=DATA.projects[pi].phases[phi].tasks; const [moved]=tasks.splice(dragTi,1); let idx=overTi>dragTi?overTi-1:overTi; if(insertAfter) idx++; tasks.splice(idx,0,moved); saveData(); render(); });
}

