// 建立甘特圖 HTML（時間軸 + 所有專案/階段/任務 Bar）
function buildGantt(){
  const projs=DATA.projects.filter(p=>p.phases&&p.phases.length>0);
  if(!projs.length){ document.getElementById('ganttBody').innerHTML='<div style="padding:40px;text-align:center;color:var(--text3)">目前沒有專案資料</div>'; return; }

  // 收集全域日期範圍
  let minDate=null, maxDate=null;
  projs.forEach(p=>{
    [p.startDate,p.dueDate].forEach(d=>{ if(!d) return; if(!minDate||d<minDate) minDate=d; if(!maxDate||d>maxDate) maxDate=d; });
    (p.phases||[]).forEach(ph=>{
      [ph.startDate,ph.dueDate].forEach(d=>{ if(!d) return; if(!minDate||d<minDate) minDate=d; if(!maxDate||d>maxDate) maxDate=d; });
      (ph.tasks||[]).forEach(t=>{
        [t.startDate,t.dueDate].forEach(d=>{ if(!d) return; if(!minDate||d<minDate) minDate=d; if(!maxDate||d>maxDate) maxDate=d; });
      });
    });
  });
  if(!minDate){ document.getElementById('ganttBody').innerHTML='<div style="padding:40px;text-align:center;color:var(--text3)">請先為專案/任務填入日期</div>'; return; }

  // 擴展前後各 3 天 buffer
  const sd=new Date(minDate+'T00:00:00'); sd.setDate(sd.getDate()-3);
  const ed=new Date(maxDate+'T00:00:00'); ed.setDate(ed.getDate()+3);

  // 產生日期陣列
  const days=[]; let cur=new Date(sd);
  while(cur<=ed){ days.push(new Date(cur)); cur.setDate(cur.getDate()+1); }
  const today=todayStr();
  const dayStr=d=>d.toISOString().split('T')[0];

  // 月份群組
  const months=[];
  days.forEach((d,i)=>{
    const mk=d.getFullYear()+'-'+(d.getMonth()+1);
    if(!months.length||months[months.length-1].key!==mk) months.push({key:mk,label:`${d.getFullYear()}/${d.getMonth()+1}月`,start:i,count:0});
    months[months.length-1].count++;
  });

  // 顏色對應
  const statusColor={待開始:'#aeaeb2',進行中:'#007aff',已完成:'#34c759',擱置:'#ff3b30'};
  const phaseColors=['#007aff','#af52de','#ff9500','#34c759','#ff2d55','#5ac8fa','#ffcc00','#30d158'];

  // Bar 計算
  function barCols(start,end){
    if(!start||!end) return null;
    const si=days.findIndex(d=>dayStr(d)>=start);
    const ei=days.findIndex(d=>dayStr(d)>=end);
    if(si<0) return null;
    const endIdx=ei<0?days.length-1:ei;
    return {left:si, width:Math.max(1,endIdx-si+1)};
  }

  // thead：月份列
  let thead=`<tr class="gantt-head-sticky"><th class="g-label" style="width:220px;min-width:220px" rowspan="2">專案 / 階段 / 任務</th>`;
  months.forEach(m=>{ thead+=`<th class="g-head-month" colspan="${m.count}">${m.label}</th>`; });
  thead+=`</tr><tr class="gantt-head-sticky">`;
  days.forEach(d=>{ const ds=dayStr(d); const isWE=d.getDay()===0||d.getDay()===6; thead+=`<th class="g-head-day ${ds===today?'today':''} ${isWE?'weekend':''}">${d.getDate()}</th>`; });
  thead+=`</tr>`;

  // tbody
  let tbody='';
  projs.forEach(p=>{
    // 專案列
    const pb=barCols(p.startDate,p.dueDate);
    const pPct=calcProjProgress(p);
    tbody+=`<tr><td class="g-label" title="${p.name}"><b>${p.id}</b> ${p.name}</td>`;
    days.forEach((d,i)=>{
      const ds=dayStr(d); const isWE=d.getDay()===0||d.getDay()===6;
      const isTd=ds===today;
      if(pb&&i===pb.left){
        const bg=statusColor[p.status]||'#aeaeb2';
        tbody+=`<td class="g-cell ${isWE?'weekend':''} ${isTd?'today-col':''}" colspan="${pb.width}" style="padding:0">
          <div class="g-bar proj ${p.status==='已完成'?'done':''}" style="width:100%;background:linear-gradient(90deg,${bg} ${pPct}%,rgba(174,174,178,.25) ${pPct}%)" title="${p.name} ${p.status} ${pPct}%"></div>
        </td>`;
      } else if(!pb||i<pb.left||i>pb.left+pb.width-1){
        tbody+=`<td class="g-cell ${isWE?'weekend':''} ${isTd?'today-col':''}"></td>`;
      }
    });
    tbody+=`</tr>`;

    // 階段列
    (p.phases||[]).forEach((ph,phi)=>{
      const phb=barCols(ph.startDate,ph.dueDate);
      const phPct=calcPhaseProgress(ph);
      const phColor=phaseColors[phi%phaseColors.length];
      const dur=fmtDuration(ph.startDate,ph.dueDate);
      tbody+=`<tr><td class="g-label phase" title="${ph.name}">📁 ${ph.name}${dur?` <span style='color:var(--text3);font-size:.65rem'>(${dur})</span>`:''}
      </td>`;
      days.forEach((d,i)=>{
        const ds=dayStr(d); const isWE=d.getDay()===0||d.getDay()===6; const isTd=ds===today;
        if(phb&&i===phb.left){
          tbody+=`<td class="g-cell ${isWE?'weekend':''} ${isTd?'today-col':''}" colspan="${phb.width}" style="padding:0">
            <div class="g-bar phase-bar ${ph.status==='已完成'?'done':''}" style="width:100%;background:linear-gradient(90deg,${phColor} ${phPct}%,rgba(174,174,178,.22) ${phPct}%);box-shadow:0 1px 4px rgba(0,0,0,.1)" title="${ph.name} ${ph.status} ${phPct}%"></div>
          </td>`;
        } else if(!phb||i<phb.left||i>phb.left+phb.width-1){
          tbody+=`<td class="g-cell ${isWE?'weekend':''} ${isTd?'today-col':''}"></td>`;
        }
      });
      tbody+=`</tr>`;

      // 任務列
      (ph.tasks||[]).forEach((t,ti)=>{
        const tb=barCols(t.startDate,t.dueDate);
        const pc=t.status==='已完成'?100:(t.pct||0);
        const tc=statusColor[t.status]||'#aeaeb2';
        tbody+=`<tr><td class="g-label task" title="${t.name}">↳ ${t.name}${t.person?` <span style='color:var(--text3);font-size:.62rem'>👤${t.person}</span>`:''}</td>`;
        days.forEach((d,i)=>{
          const ds=dayStr(d); const isWE=d.getDay()===0||d.getDay()===6; const isTd=ds===today;
          if(tb&&i===tb.left){
            tbody+=`<td class="g-cell ${isWE?'weekend':''} ${isTd?'today-col':''}" colspan="${tb.width}" style="padding:0">
              <div class="g-bar ${t.status==='已完成'?'done':''}" style="width:100%;background:linear-gradient(90deg,${tc} ${pc}%,rgba(174,174,178,.2) ${pc}%)" title="${t.name} ${t.status} ${pc}%"></div>
            </td>`;
          } else if(!tb||i<tb.left||i>tb.left+tb.width-1){
            tbody+=`<td class="g-cell ${isWE?'weekend':''} ${isTd?'today-col':''}"></td>`;
          }
        });
        tbody+=`</tr>`;
      });
    });
  });

  document.getElementById('ganttBody').innerHTML=`
    <div class="gantt-legend">
      <span><span class="dot" style="background:#aeaeb2"></span>待開始</span>
      <span><span class="dot" style="background:#007aff"></span>進行中</span>
      <span><span class="dot" style="background:#34c759"></span>已完成</span>
      <span><span class="dot" style="background:#ff3b30"></span>擱置</span>
      <span style="margin-left:8px;color:var(--text3)">■ 色條填充 = 完成率　□ 灰色 = 剩餘　直欄陰影 = 週末</span>
    </div>
    <div class="gantt-wrap">
      <table class="gantt-table">
        <thead>${thead}</thead>
        <tbody>${tbody}</tbody>
      </table>
    </div>`;
}
