//  工作天週數計算
// ══════════════════════════════════════════════════════
// 計算兩日期之間的工作天數（週一到週五），不含假日 API（純星期判斷）
function countWorkdays(start, end){
  if(!start||!end||start>end) return 0;
  let s=new Date(start+'T00:00:00'), e=new Date(end+'T00:00:00');
  let count=0;
  while(s<=e){
    const d=s.getDay();
    if(d!==0&&d!==6) count++;
    s.setDate(s.getDate()+1);
  }
  return count;
}
// 將工作天數換算為週數（5工作天=1週，無條件進位）
function workdaysToWeeks(days){ return Math.ceil(days/5); }
// 格式化工期標籤（工作天 + 週數）
function fmtDuration(start, end){
  const days=countWorkdays(start,end);
  if(!days) return '';
  const weeks=workdaysToWeeks(days);
  return days<=5?`${days} 天`:`${weeks} 週（${days} 工作天）`;
}


