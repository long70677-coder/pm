// 格式化日期值（Excel 序列或字串 → yyyy-mm-dd）
function fmtDate(val){
  if(!val) return '';
  if(typeof val==='number'){ const d=new Date(Math.round((val-25569)*86400*1000)); return d.toISOString().split('T')[0]; }
  const s=String(val).trim();
  if(/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  const d=new Date(s); if(!isNaN(d)) return d.toISOString().split('T')[0];
  return s;
}
// 處理拖放檔案匯入事件
function handleDrop(e){ e.preventDefault(); const f=e.dataTransfer.files[0]; if(f) processXlsx(f); }
// 處理 xlsx 選擇匯入事件
function importXlsx(e){ const f=e.target.files[0]; if(f) processXlsx(f); e.target.value=''; }
// 解析 xlsx 並匯入專案資料
function processXlsx(file){
  const reader=new FileReader();
  reader.onload=ev=>{
    try{
      const wb=XLSX.read(ev.target.result,{type:'array'});
      const rows=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]]);
      const map={},order=[];
      rows.forEach(row=>{
        const pid=String(row['專案編號']||'').trim(); if(!pid) return;
        if(!map[pid]){ order.push(pid); map[pid]={id:pid,name:String(row['專案名稱']||''),type:String(row['專案類型']||''),owner:String(row['負責人']||''),members:String(row['成員']||''),status:String(row['狀態']||'待開始'),startDate:fmtDate(row['開始日']),dueDate:fmtDate(row['完成日']),actualDate:fmtDate(row['實際完成日']),notes:String(row['備註']||''),createdDate:'',lastUpdated:'',phases:[],starred:false}; }
        const phName=String(row['階段名稱']||'').trim();
        const taskName=String(row['任務名稱']||'').trim();
        if(!phName) return;
        let ph=map[pid].phases.find(p=>p.name===phName);
        if(!ph){ ph={name:phName,status:String(row['階段狀態']||'待開始'),startDate:fmtDate(row['階段開始日']),dueDate:fmtDate(row['階段完成日']),tasks:[]}; map[pid].phases.push(ph); }
        if(taskName) ph.tasks.push({name:taskName,person:String(row['任務負責人']||''),status:String(row['任務狀態']||'待開始'),startDate:fmtDate(row['任務開始日']),dueDate:fmtDate(row['任務完成日']),actualDate:fmtDate(row['任務實際完成']),pct:parseInt(String(row['任務完成率']||'0').replace('%',''))||0,note:String(row['任務備註']||'')});
      });
      const imported=order.map(id=>map[id]).filter(Boolean);
      if(!imported.length){ alert('找不到有效資料，請確認欄位標題正確'); return; }
      if(confirm(`找到 ${imported.length} 個專案，要取代現有資料嗎？
（取消 = 合併匯入）`)) DATA.projects=imported;
      else DATA.projects=[...DATA.projects,...imported.filter(np=>!DATA.projects.find(op=>op.id===np.id))];
      // Sheet2 成員
      if(wb.SheetNames[1]){ const mrows=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[1]],{header:1}); const ms=mrows.flat().map(m=>String(m).trim()).filter(Boolean); if(ms.length) DATA.members=[...new Set([...DATA.members,...ms])]; }
      saveData(); render(); showToast(`✅ 成功匯入 ${imported.length} 個專案`);
    }catch(e){ alert('匯入失敗：'+e.message); }
  };
  reader.readAsArrayBuffer(file);
}
// 匯出所有專案資料為 xlsx
function exportXlsx(){
  const rows=[];
  DATA.projects.forEach(p=>{
    const base={'專案編號':p.id,'專案名稱':p.name,'專案類型':p.type||'','負責人':p.owner||'','成員':p.members||'','狀態':p.status,'開始日':p.startDate,'完成日':p.dueDate,'實際完成日':p.actualDate,'備註':p.notes||''};
    if(!(p.phases||[]).length){ rows.push(base); return; }
    p.phases.forEach(ph=>{
      if(!(ph.tasks||[]).length){ rows.push({...base,'階段名稱':ph.name,'階段狀態':ph.status,'階段開始日':ph.startDate,'階段完成日':ph.dueDate}); return; }
      ph.tasks.forEach(t=>rows.push({...base,'階段名稱':ph.name,'階段狀態':ph.status,'階段開始日':ph.startDate,'階段完成日':ph.dueDate,'任務名稱':t.name,'任務負責人':t.person||'','任務狀態':t.status,'任務開始日':t.startDate,'任務完成日':t.dueDate,'任務實際完成':t.actualDate,'任務完成率':(t.pct||0)+'%','任務備註':t.note||''}));
    });
  });
  const ws=XLSX.utils.json_to_sheet(rows);
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'專案資料');
  const ws2=XLSX.utils.aoa_to_sheet([['成員名稱'],...DATA.members.map(m=>[m])]);
  XLSX.utils.book_append_sheet(wb,ws2,'成員清單');
  XLSX.writeFile(wb,`專案管理看板_${todayStr()}.xlsx`);
}

