//  今日儀表板 — 任務層級到期提醒
// ══════════════════════════════════════════════════════
// 渲染今日儀表板（逾期、本週、即將到期的任務）
function renderSidebar(){
  const today=todayStr();
  const weekEnd=new Date(); weekEnd.setDate(weekEnd.getDate()+7);
  const weekEndStr=weekEnd.toISOString().split('T')[0];
  const upcoming=new Date(); upcoming.setDate(upcoming.getDate()+14);
  const upcomingStr=upcoming.toISOString().split('T')[0];

  const allTasks=[];
  DATA.projects.forEach((p,pi)=>{
    (p.phases||[]).forEach((ph,phi)=>{
      (ph.tasks||[]).forEach((t,ti)=>{
        if(t.status!=='已完成'&&t.dueDate){
          allTasks.push({...t,projName:p.name,projId:p.id,phaseName:ph.name,pi,phi,ti});
        }
      });
    });
  });

  const overdue=allTasks.filter(t=>t.dueDate<today);
  const thisweek=allTasks.filter(t=>t.dueDate>=today&&t.dueDate<=weekEndStr);
  const soon=allTasks.filter(t=>t.dueDate>weekEndStr&&t.dueDate<=upcomingStr);

  const mkItem=(t,cls)=>`<div class="sb-item ${cls}" onclick="jumpToCard(${t.pi})">
    <div class="sb-proj">${t.projId} ${t.projName}</div>
    <div class="sb-phase">📁 ${t.phaseName}</div>
    <div class="sb-name">${t.name}</div>
    <div class="sb-date">${t.person?'👤 '+t.person+'　':''} 📅 ${t.dueDate}</div>
  </div>`;

  document.getElementById('sidebarContent').innerHTML=
    `<div class="today-badge">今日 ${today}</div>`+
    (overdue.length?`<div class="sb-section"><div class="sb-section-title overdue">🔴 逾期 (${overdue.length})</div>${overdue.map(t=>mkItem(t,'overdue')).join('')}</div>`:`<div class="sb-section"><div class="sb-section-title overdue">🔴 逾期</div><div class="sb-empty">無逾期任務 ✅</div></div>`)+
    (thisweek.length?`<div class="sb-section"><div class="sb-section-title thisweek">🟠 本週到期 (${thisweek.length})</div>${thisweek.map(t=>mkItem(t,'thisweek')).join('')}</div>`:'')+
    (soon.length?`<div class="sb-section"><div class="sb-section-title upcoming">🟢 14天內 (${soon.length})</div>${soon.map(t=>mkItem(t,'upcoming')).join('')}</div>`:'');
}

