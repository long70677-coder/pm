// 全選或全不選 AI 建議子任務
function aiSelectAll(val){
  const list = document.getElementById('aiResultList');
  (list._tasks||[]).forEach((_,i)=>{
    const item = document.getElementById('ai-item-'+i);
    const cb = document.getElementById('ai-cb-'+i);
