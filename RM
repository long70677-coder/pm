      <div style="display:flex;gap:8px">
        <button onclick="downloadGantt()" style="background:linear-gradient(135deg,#059669,#10B981);color:#fff;border:none;border-radius:8px;padding:6px 14px;cursor:pointer;font-size:.85rem">🖼️ 下載圖片</button>
        <button onclick="exportGanttXlsx()" style="background:linear-gradient(135deg,#0ea5e9,#6366f1);color:#fff;border:none;border-radius:8px;padding:6px 14px;cursor:pointer;font-size:.85rem">📊 匯出 Excel</button>
