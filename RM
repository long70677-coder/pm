<script>
let _openCards = new Set(); // 卡片展開狀態

let _stSort={ri:-1,col:null,dir:1};
let _stFilter={};
// ═══════════════════════════════════════════════════
//  資料層
// ═══════════════════════════════════════════════════
const SK = { data:'pm_v33_data', types:'pm_v33_types', tmpl:'pm_v33_tmpl', theme:'pm_v33_theme' };

const DEF_TYPES = ['開發功能','撈資料','系統分析','測試/QA','行政維運','其他'];
const DEF_TMPL  = { '開發功能':[{name:'需求規劃',days:5},{name:'程式開發',days:5},{name:'SIT',days:5},{name:'UAT',days:5},{name:'上線',days:5},{name:'結案',days:5}] };
const DEF_DATA  = {
  members:['宥維','建華','慶龍','曜宇','炳志','至軒'],
  requirements:[]
};

// 從 localStorage 讀取資料，若不存在則回傳預設值
function load(key,def){ try{ const v=localStorage.getItem(key); return v?JSON.parse(v):def; }catch(e){ return def; } }
// 將資料序列化後存入 localStorage
function save(key,val){ localStorage.setItem(key,JSON.stringify(val)); }

let DATA     = load(SK.data, DEF_DATA);
let REQ_TYPES= load(SK.types, [...DEF_TYPES]);
let ALL_TMPL = load(SK.tmpl, JSON.parse(JSON.stringify(DEF_TMPL)));

// 儲存主要資料（需求單、成員等）並顯示儲存提示
function saveData(){ save(SK.data,DATA); showSaveInd(); }
// 短暫顯示「已自動儲存」提示文字
function showSaveInd(){ const el=document.getElementById('saveInd'); el.textContent='💾 已自動儲存'; clearTimeout(el._t); el._t=setTimeout(()=>el.textContent='',3000); }
// 回傳今日日期字串（yyyy-mm-dd 格式）
function todayStr(){ return new Date().toISOString().split('T')[0]; }

// ═══════════════════════════════════════════════════
//  假日 & 工作日
// ═══════════════════════════════════════════════════
let _hols=[];
// 從 date.nager.at API 取得台灣指定年份的國定假日清單
async function fetchHols(year){
  try{ const r=await fetch('https://date.nager.at/API/v3/PublicHolidays/'+year+'/TW'); _hols=(await r.json()).map(h=>h.date); }catch(e){ _hols=[]; }
}
// 判斷指定日期是否為工作日（非週六日且非國定假日）
function isWorkday(ds){ const d=new Date(ds); if(d.getDay()===0||d.getDay()===6)return false; return !_hols.includes(ds); }
// 從指定日期加上 n 個工作天，回傳結果日期字串
function addWorkdays(start,n){
  let d=new Date(start),cnt=0;
  while(cnt<n){ d.setDate(d.getDate()+1); if(isWorkday(d.toISOString().split('T')[0]))cnt++; }
  return d.toISOString().split('T')[0];
}
// 取得指定日期之後的第一個工作日
function nextWorkday(ds){
  let d=new Date(ds);
  do{ d.setDate(d.getDate()+1); }while(!isWorkday(d.toISOString().split('T')[0]));
  return d.toISOString().split('T')[0];
}
// 依範本與開始日期自動產生子任務清單（含日期計算）
function genSubtasks(tmpl,startDate){
  const subs=[]; let cur=startDate;
  while(!isWorkday(cur)) cur=nextWorkday(cur);
  tmpl.forEach(item=>{
    const s=cur, e=addWorkdays(s,item.days-1);
    subs.push({name:item.name,person:'－',startDate:s,dueDate:e,actualDate:'',status:'待開始',pct:0});
    cur=nextWorkday(e);
  });
  return subs;
}

// ═══════════════════════════════════════════════════
//  主題切換
// ═══════════════════════════════════════════════════
function toggleTheme(){
  const dark=document.body.classList.toggle('dark');
  save(SK.theme, dark?'dark':'light');
  document.getElementById('themeBtn').textContent=dark?'☀️ 亮色':'🌙 深色';
}
// 初始化主題（頁面載入時讀取上次設定）
(function initTheme(){
  if(load(SK.theme,'light')==='dark'){
    document.body.classList.add('dark');
    document.addEventListener('DOMContentLoaded',()=>{
      const b=document.getElementById('themeBtn'); if(b)b.textContent='☀️ 亮色';
    });
  }
})();

// ═══════════════════════════════════════════════════
//  多選 Tag 輸入
// ═══════════════════════════════════════════════════
function initTagInput(wrapId, values, suggestions, onChange){
  const wrap=document.getElementById(wrapId);
  wrap.innerHTML='';
  const vals=[...values];
  // （內部）重新渲染 Tag 列表，同步更新 DOM 與回調
  function refresh(){
    wrap.querySelectorAll('.m-tag').forEach(t=>t.remove());
    vals.forEach((v,i)=>{
      const tag=document.createElement('span'); tag.className='m-tag';
      tag.innerHTML=v+' <span class="rm" onclick="this.parentNode._remove()">✕</span>';
      tag._remove=()=>{ vals.splice(i,1); refresh(); };
      wrap.insertBefore(tag, wrap.querySelector('.m-tag-input'));
    });
    if(onChange) onChange(vals);
  }
  const inp=document.createElement('input'); inp.className='m-tag-input'; inp.placeholder='輸入後按 Enter';
  inp.addEventListener('keydown',e=>{
    if(e.key==='Enter'||e.key===','){
      e.preventDefault();
      const v=inp.value.trim();
      if(v&&!vals.includes(v)){ vals.push(v); refresh(); inp.value=''; }
    } else if(e.key==='Backspace'&&inp.value===''&&vals.length>0){
      vals.pop(); refresh();
    }
  });
  // 建議清單
  if(suggestions&&suggestions.length){
    inp.addEventListener('focus',()=>showSugg(inp,suggestions,vals,()=>refresh()));
    inp.addEventListener('input',()=>showSugg(inp,suggestions,vals,()=>refresh()));
  }
  wrap.appendChild(inp);
  wrap._getVals=()=>vals;
  refresh();
}
let _suggEl=null;
// 顯示輸入建議下拉選單
function showSugg(inp,suggs,vals,refresh){
  removeSugg();
  const q=inp.value.toLowerCase();
  const filtered=suggs.filter(s=>!vals.includes(s)&&s.toLowerCase().includes(q));
  if(!filtered.length)return;
  _suggEl=document.createElement('div');
  _suggEl.style.cssText='position:fixed;background:var(--surface);border:1px solid var(--border);border-radius:var(--rm);box-shadow:var(--shadow-m);z-index:9999;min-width:120px;overflow:hidden;pointer-events:auto';
  filtered.forEach(s=>{
    const d=document.createElement('div');
    d.textContent=s; d.style.cssText='padding:7px 12px;cursor:pointer;font-size:.82rem;color:var(--text)';
    d.onmouseenter=()=>d.style.background='var(--surface2)';
    d.onmouseleave=()=>d.style.background='';
    d.onmousedown=e=>{ e.preventDefault(); e.stopPropagation(); vals.push(s); refresh(); inp.value=''; setTimeout(removeSugg,0); inp.focus(); };
    d.onclick=e=>{ e.preventDefault(); e.stopPropagation(); };
    _suggEl.appendChild(d);
  });
  const rect=inp.getBoundingClientRect();
  _suggEl.style.left=rect.left+'px'; _suggEl.style.top=(rect.bottom+4)+'px';
  document.body.appendChild(_suggEl);
}
// 移除輸入建議下拉選單
function removeSugg(){ if(_suggEl){ _suggEl.remove(); _suggEl=null; } }
document.addEventListener('mousedown',function(e){ if(_suggEl && !_suggEl.contains(e.target) && !e.target.classList.contains('m-tag-input')) removeSugg(); });
// 取得指定 Tag 輸入框目前已選的值陣列
function getTagVals(wrapId){ return document.getElementById(wrapId)._getVals?.()??[]; }
// 將 Tag 陣列格式化為「、」分隔的字串
function fmtTags(arr){ return arr.join('、'); }
// 將分隔字串解析為 Tag 陣列
function parseTags(str){ if(!str||str==='－')return []; return str.split(/[、,，\s]+/).map(s=>s.trim()).filter(Boolean); }
// 在子任務列渲染負責人 Tag 輸入框（延遲綁定）
function renderPersonTags(val,ri,si){
  const vals=parseTags(val);
  const wrapId=`subperson-${ri}-${si}`;
  setTimeout(()=>{
    const wrap=document.getElementById(wrapId);
    if(!wrap||wrap.dataset.bound) return;
    wrap.dataset.bound='1';
    initTagInput(wrapId, vals, DATA.members||[]);
  },0);
  return `<div id="${wrapId}" class="sub-person-wrap"></div>`;
}

// ═══════════════════════════════════════════════════
//  需求類型
// ═══════════════════════════════════════════════════
function refreshTypeSelects(){
  ['r-type','filterType'].forEach(id=>{
    const sel=document.getElementById(id); if(!sel)return;
    const cur=sel.value;
    if(id==='filterType'){
      sel.innerHTML='<option value="">全部</option>'+REQ_TYPES.map(t=>`<option>${t}</option>`).join('');
    } else {
      sel.innerHTML=REQ_TYPES.map(t=>`<option>${t}</option>`).join('');
    }
    if(REQ_TYPES.includes(cur))sel.value=cur;
  });
}
// 重新整理負責人與成員篩選下拉選單
function refreshOwnerFilter(){
  const sel=document.getElementById('filterOwner'); if(!sel)return;
  const cur=sel.value;
  const opts='<option value="">全部</option>'+(DATA.members||[]).map(m=>`<option>${m}</option>`).join('');
