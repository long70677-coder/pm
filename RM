function fmtDate(val){
  if(!val)return '';
  if(val instanceof Date) return val.getFullYear()+'-'+String(val.getMonth()+1).padStart(2,'0')+'-'+String(val.getDate()).padStart(2,'0');
  const s=String(val).trim();
  if(/^\d{4}-\d{2}-\d{2}/.test(s))return s.substring(0,10);
  if(/^\d{4}\/\d{2}\/\d{2}/.test(s))return s.replace(/\//g,'-').substring(0,10);
  return s;
}
// 處理檔案拖放匯入事件
function handleDrop(e){
  e.preventDefault();
  document.getElementById('dropZone').style.background='rgba(0,122,255,.04)';
  const f=e.dataTransfer.files[0];
  if(f)processXlsx(f);
}
// 處理 xlsx 檔案選擇匯入事件
function importXlsx(e){
  const f=e.target.files[0]; if(!f)return;
  processXlsx(f); e.target.value='';
}
// 解析 xlsx 檔案並匯入需求單與成員資料
function processXlsx(file){
  if(typeof XLSX==='undefined'){alert('❌ XLSX 函式庫未載入，請確認網路後重新整理');return;}
  const reader=new FileReader();
  reader.onload=function(e){
    try{
      const wb=XLSX.read(new Uint8Array(e.target.result),{type:'array',cellDates:true});
      // 成員清單
      const ms=wb.Sheets['成員清單'];
      if(ms){
        const mr=XLSX.utils.sheet_to_json(ms,{defval:''});
        const members=mr.map(r=>String(r['成員姓名']||'').trim()).filter(Boolean);
        if(members.length>0)DATA.members=members;
      }
      // 需求單
      const ws=wb.Sheets[wb.SheetNames[0]];
      const rows=XLSX.utils.sheet_to_json(ws,{defval:'',raw:true});
      if(!rows||!rows.length){alert('需求單工作表沒有資料');return;}
      const map={},order=[];
      rows.forEach(row=>{
        const rid=String(row['需求單編號']||'').trim(); if(!rid)return;
        if(!map[rid]){
          order.push(rid);
          map[rid]={id:rid,name:String(row['需求單名稱']||''),type:String(row['需求類型']||'其他'),system:String(row['系統別']||''),
            owner:String(row['負責人']||'－'),devs:String(row['成員']||'－'),status:String(row['狀態']||'待開始'),
            startDate:fmtDate(row['預計開始日']),dueDate:fmtDate(row['預計完成日']),actualDate:fmtDate(row['實際完成日']),
            notes:String(row['備註']||''),createdDate:String(row['建立日期']||''),lastUpdated:String(row['最後更新時間']||''),
            subtasks:[]};
        }
        const sn=String(row['子功能名稱']||'').trim();
        if(sn) map[rid].subtasks.push({name:sn,person:String(row['子功能負責人']||'－'),
          startDate:fmtDate(row['子功能開始日']),dueDate:fmtDate(row['子功能完成日']),
          actualDate:fmtDate(row['子功能實際完成']),status:String(row['子功能狀態']||'待開始'),
          pct:parseInt(String(row['子功能完成率']||'0').replace('%',''))||0, note:String(row['子功能備註']||'')});
      });
      const imported=order.map(id=>map[id]).filter(Boolean);
      if(!imported.length){alert('找不到有效需求單資料，請確認欄位標題正確');return;}
      const choice = DATA.requirements.length > 0
        ? confirm('目前看板已有 '+DATA.requirements.length+' 筆需求單。\n\n✅ 確定 → 合併（保留現有，加入新的）\n❌ 取消 → 放棄匯入')
        : true;
      if(!choice) return;
      if(DATA.requirements.length > 0){
        // 合併：以需求單編號去重，已存在的不覆蓋
        const existIds = new Set(DATA.requirements.map(r=>r.id));
        const newReqs = imported.filter(r=>!existIds.has(r.id));
        const dupCount = imported.length - newReqs.length;
        DATA.requirements = DATA.requirements.concat(newReqs);
        saveData(); refreshOwnerFilter();
        render(); alert('✅ 匯入完成！新增 '+newReqs.length+' 筆' + (dupCount>0?'，已略過 '+dupCount+' 筆重複編號':''));
      } else {
        DATA.requirements = imported; saveData(); refreshOwnerFilter();
        render(); alert('✅ 匯入完成！共 '+imported.length+' 筆需求單');
      } render();
      alert('✅ 成功匯入 '+imported.length+' 筆需求單！');
    }catch(err){alert('匯入失敗：'+err.message);}
  };
  reader.readAsArrayBuffer(file);
}
// 將目前所有需求單匯出為 xlsx 檔案
function exportXlsx(){
  const rows=[];
  DATA.requirements.forEach(r=>{
    const base={'需求單編號':r.id,'需求單名稱':r.name,'需求類型':r.type,'系統別':r.system||'','負責人':r.owner,'成員':r.devs,
