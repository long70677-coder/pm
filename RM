      '子功能數量':(r.subtasks||[]).length,'備註':r.notes||''};
    if(!r.subtasks||!r.subtasks.length){rows.push(base);return;}
    r.subtasks.forEach((st,si)=>rows.push({...base,'子功能序':si+1,'子功能名稱':st.name,
      '子功能負責人':st.person,'子功能開始日':st.startDate,'子功能完成日':st.dueDate,
      '子功能實際完成':st.actualDate,'子功能狀態':st.status,'子功能完成率':(st.pct||0)+'%','子功能備註':st.note||''}));
  });
  const memberRows=(DATA.members||[]).map(m=>({'成員姓名':m}));
  const wb=XLSX.utils.book_new();
  const ws1=XLSX.utils.json_to_sheet(rows.length?rows:[{}]);
  const ws2=XLSX.utils.json_to_sheet(memberRows.length?memberRows:[{'成員姓名':''}]);
  Object.keys(ws1).forEach(k=>{ if(k[0]!=='!') ws1[k].z='@'; });
  Object.keys(ws2).forEach(k=>{ if(k[0]!=='!') ws2[k].z='@'; });
  XLSX.utils.book_append_sheet(wb,ws1,'需求單');
  XLSX.utils.book_append_sheet(wb,ws2,'成員清單');
  XLSX.writeFile(wb,'PM需求單_v34_'+todayStr()+'.xlsx');
}

