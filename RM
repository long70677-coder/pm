<script>
// ── 甘特圖 ──
const _selectedReqs = new Set();
let _filterStar = false;
let _filterSys = '';
const MEMBER_COLORS = ['#6366f1','#0ea5e9','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6','#f97316','#64748b'];

// 切換需求單的甘特圖選取狀態
function toggleGanttSelect(ri){
  const chk = document.getElementById('chk-'+ri);
  if(chk.checked) _selectedReqs.add(ri);
  else _selectedReqs.delete(ri);
  const btn = document.getElementById('ganttBtn');
  btn.style.display = _selectedReqs.size > 0 ? 'inline-flex' : 'none';
}

// 開啟甘特圖檢視 Modal
function openGantt(){
  if(_selectedReqs.size === 0){ alert('請先勾選至少一張需求單'); return; }
  buildGantt();
  openModal('ganttOverlay');
}

// 建立甘特圖 HTML（依子任務日期繪製時間軸）
function buildGantt(){
  const riList = [..._selectedReqs].sort((a,b)=>a-b);
  const rows = []; // {label, reqName, person, start, end, color}

  // 收集所有成員，指定顏色
  const memberColorMap = {};
  let colorIdx = 0;

  riList.forEach(ri => {
    const r = DATA.requirements[ri];
    if(!r) return;
    (r.subtasks||[]).forEach(st => {
      if(!st.startDate || !st.dueDate) return;
      const m = st.person || '－';
      if(!memberColorMap[m]) memberColorMap[m] = MEMBER_COLORS[colorIdx++ % MEMBER_COLORS.length];
      rows.push({
        reqId: r.id, reqName: r.name,
        label: st.name, person: m,
        start: st.startDate, end: st.dueDate,
        color: memberColorMap[m]
      });
    });
  });

  if(!rows.length){ document.getElementById('ganttContainer').innerHTML='<p style="padding:20px;color:var(--text2)">選取的需求單沒有子任務資料</p>'; return; }

  // 計算時間範圍
  const allDates = rows.flatMap(r=>[new Date(r.start), new Date(r.end)]).filter(d=>!isNaN(d));
  let minD = new Date(Math.min(...allDates));
  let maxD = new Date(Math.max(...allDates));
  // 擴展到月份邊界
  minD = new Date(minD.getFullYear(), minD.getMonth(), 1);
  maxD = new Date(maxD.getFullYear(), maxD.getMonth()+1, 1);

  // 產生半月刻度
  const ticks = [];
  let d = new Date(minD);
  while(d <= maxD){
    ticks.push(new Date(d));
    if(d.getDate() < 15) d = new Date(d.getFullYear(), d.getMonth(), 15);
    else d = new Date(d.getFullYear(), d.getMonth()+1, 1);
  }
  ticks.push(new Date(maxD));

  const totalMs = maxD - minD;
  const labelW = 220;
  const chartW = Math.max(700, ticks.length * 60);
  const rowH = 32;
  const headerH = 48;
  const totalH = headerH + rows.length * rowH + 8;

  const pct = (dateStr) => {
    const ms = new Date(dateStr) - minD;
    return Math.max(0, Math.min(100, ms / totalMs * 100));
  };

  // 群組標頭（需求單分隔）
  let lastReqId = null;
  let html = `<div id="ganttSvgWrap" style="display:flex;font-family:var(--font-body,sans-serif)">`;

  // 左側標籤
  html += `<div style="min-width:${labelW}px;flex-shrink:0;border-right:2px solid var(--border)">`;
  html += `<div style="height:${headerH}px;background:var(--surface2);border-bottom:2px solid var(--border);display:flex;align-items:center;padding:0 12px;font-size:.8rem;color:var(--text2);font-weight:600">需求單 / 子任務</div>`;
  rows.forEach((row,i) => {
    const isNewReq = row.reqId !== lastReqId;
    lastReqId = row.reqId;
    const bg = i%2===0?'var(--surface)':'var(--surface2)';
    html += `<div style="height:${rowH}px;background:${bg};border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 10px;gap:6px;overflow:hidden">`;
    if(isNewReq) html += `<span style="font-size:.7rem;background:var(--accent);color:#fff;border-radius:4px;padding:1px 5px;white-space:nowrap;flex-shrink:0">${row.reqId}</span>`;
    html += `<span style="font-size:.78rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${row.label}・${row.person}">${row.label}</span>`;
    html += `<span style="font-size:.7rem;color:${row.color};font-weight:600;margin-left:auto;flex-shrink:0">${row.person}</span>`;
    html += `</div>`;
  });
  html += `</div>`;

  // 右側甘特圖區
  html += `<div style="flex:1;overflow-x:auto;position:relative">`;
  // 刻度 header
  html += `<div style="height:${headerH}px;background:var(--surface2);border-bottom:2px solid var(--border);position:relative;min-width:${chartW}px">`;
  ticks.forEach((t,i) => {
    const x = (t - minD) / totalMs * 100;
    const label = `${t.getMonth()+1}/${t.getDate()}`;
    html += `<div style="position:absolute;left:${x}%;top:0;height:100%;border-left:1px solid var(--border);padding:4px 4px;font-size:.72rem;color:var(--text2);white-space:nowrap">${label}</div>`;
  });
  html += `</div>`;

  // 條狀列
  lastReqId = null;
  rows.forEach((row,i) => {
    const bg = i%2===0?'var(--surface)':'var(--surface2)';
    const left = pct(row.start);
    const width = Math.max(0.5, pct(row.end) - left);
    html += `<div style="height:${rowH}px;background:${bg};border-bottom:1px solid var(--border);position:relative;min-width:${chartW}px">`;
    // 今天線
    const todayPct = (new Date() - minD) / totalMs * 100;
    if(todayPct>=0&&todayPct<=100) html += `<div style="position:absolute;left:${todayPct}%;top:0;height:100%;width:2px;background:rgba(239,68,68,.5);z-index:1"></div>`;
    // 條
    html += `<div title="${row.label} (${row.person})
${row.start} ~ ${row.end}" style="position:absolute;left:${left}%;width:${width}%;top:6px;height:${rowH-12}px;background:${row.color};border-radius:4px;opacity:.85;display:flex;align-items:center;padding:0 6px;overflow:hidden">`;
    html += `<span style="font-size:.68rem;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${row.person}</span>`;
    html += `</div>`;
    html += `</div>`;
  });
  html += `</div></div>`;

  // 圖例
  html += `<div style="display:flex;flex-wrap:wrap;gap:10px;padding:10px 0 0;border-top:1px solid var(--border);margin-top:8px">`;
  Object.entries(memberColorMap).forEach(([m,c])=>{
    html += `<div style="display:flex;align-items:center;gap:5px;font-size:.8rem"><div style="width:12px;height:12px;border-radius:3px;background:${c}"></div>${m}</div>`;
  });
  html += `<div style="display:flex;align-items:center;gap:5px;font-size:.8rem;margin-left:12px"><div style="width:3px;height:12px;background:rgba(239,68,68,.6)"></div>今天</div>`;
  html += `</div>`;

  document.getElementById('ganttContainer').innerHTML = html;
}


// 將甘特圖匯出為 xlsx 格式
async function exportGanttXlsx(){
  if(_selectedReqs.size === 0){ alert('請先勾選需求單並產出甘特圖'); return; }
  if(typeof ExcelJS === 'undefined'){ alert('ExcelJS 尚未載入，請稍後再試'); return; }

  const riList = [..._selectedReqs].sort((a,b)=>a-b);

  // ── 收集任務 ──
  const allTasks = [];
  riList.forEach(ri=>{
    const r = DATA.requirements[ri]; if(!r) return;
    const subs = (r.subtasks||[]).filter(st=>st.startDate&&st.dueDate);
    if(!subs.length){
      allTasks.push({req_id:r.id,req_name:r.name,system:r.system||'',
        name:'（無子任務）',person:r.owner||'',
        startDate:r.startDate||'',dueDate:r.dueDate||'',status:r.status||'',note:r.notes||''});
      return;
    }
    subs.forEach(st=>allTasks.push({req_id:r.id,req_name:r.name,system:r.system||'',
      name:st.name||'',person:st.person||'',
      startDate:st.startDate,dueDate:st.dueDate,status:st.status||'',note:st.note||''}));
  });
  if(!allTasks.length){ alert('沒有含子任務的需求單'); return; }

  // 計算兩日期之間的工作天數
  function workdays(s,e){
    let d=new Date(s),end=new Date(e),cnt=0;
    while(d<=end){if(d.getDay()!==0&&d.getDay()!==6)cnt++;d.setDate(d.getDate()+1);}
    return cnt;
  }

  // ── 週段 ──
  const dates=allTasks.flatMap(t=>[new Date(t.startDate),new Date(t.dueDate)]);
  let minDate=new Date(Math.min(...dates)), maxDate=new Date(Math.max(...dates));
  maxDate.setDate(maxDate.getDate()+7);
  const dow=minDate.getDay(); minDate.setDate(minDate.getDate()-(dow===0?6:dow-1));
  const weeks=[]; let wd=new Date(minDate);
  while(wd<=maxDate){weeks.push(new Date(wd));wd.setDate(wd.getDate()+7);}

  const STATUS_ARGB={'已完成':'FF70AD47','進行中':'FFED7D31','待開始':'FF9DC3E6','擱置':'FFFF3B30'};
  const SYS_ARGB={'光訊系統':'FF0EA5E9','帳務系統':'FF8B5CF6','減損系統':'FF10B981'};
  const HDR_ARGB='FF1F3864', REQ_ARGB='FFD6E4F0', ALT_ARGB='FFF5F9FF', WHT='FFFFFFFF';

  // 將 ARGB 色碼轉換為 CSS hex 顏色字串
  function argb2color(argb){ return {argb}; }
  // 產生 ExcelJS 純色填充物件
  function solidFill(argb){ return {type:'pattern',pattern:'solid',fgColor:{argb}}; }
  // 產生 ExcelJS 細框線物件
  function thinBorder(color='FFD0D0D0'){
    const s={style:'thin',color:{argb:color}};
    return {top:s,left:s,bottom:s,right:s};
  }
  // 在指定儲存格寫入表頭樣式
  function hdrCell(ws,row,col,val,fillArgb=HDR_ARGB){
    const c=ws.getCell(row,col);
    c.value=val; c.fill=solidFill(fillArgb);
    c.font={name:'Calibri',bold:true,size:10,color:{argb:WHT}};
    c.alignment={horizontal:'center',vertical:'middle'};
    c.border=thinBorder('FF5B7FCC');
    return c;
  }
  // 在指定儲存格寫入資料樣式
  function dataCell(ws,row,col,val,fillArgb,opts={}){
    const c=ws.getCell(row,col);
    c.value=val;
    c.fill=solidFill(fillArgb);
    c.font={name:'Calibri',size:10,...(opts.bold?{bold:true}:{}),...(opts.color?{color:{argb:opts.color}}:{})};
    c.alignment={horizontal:opts.h||'center',vertical:'middle',wrapText:opts.wrap||false};
    c.border=thinBorder();
    if(opts.numFmt) c.numFmt=opts.numFmt;
    return c;
  }

  const wb = new ExcelJS.Workbook();
  wb.creator='PM看板';
  wb.created=new Date();

  // ════════════════════════════════════
  //  Sheet 1：甘特圖
  // ════════════════════════════════════
  const ws1=wb.addWorksheet('甘特圖',{views:[{showGridLines:false}]});
  const FIXED=7; // 固定欄數(含A空白)

  // 欄寬
  ws1.getColumn(1).width=2;
  ws1.getColumn(2).width=18;
  ws1.getColumn(3).width=11;
  ws1.getColumn(4).width=20;
  ws1.getColumn(5).width=10;
  ws1.getColumn(6).width=12;
  ws1.getColumn(7).width=12;
  weeks.forEach((_,i)=>{ ws1.getColumn(FIXED+1+i).width=5.5; });

  // R1 空白
  ws1.getRow(1).height=8;

  // R2 標題
  ws1.getRow(2).height=34;
  const titleC=ws1.getCell(2,2);
  titleC.value='🗓️  專案甘特圖';
  titleC.font={name:'Calibri',bold:true,size:18,color:{argb:'FF1F3864'}};
  titleC.alignment={horizontal:'center',vertical:'middle'};
  ws1.mergeCells(2,2,2,FIXED+weeks.length);

  // R3 月份
  ws1.getRow(3).height=20;
  const monthMap={};
  weeks.forEach((w,i)=>{
    const key=`${w.getFullYear()}-${w.getMonth()}`;
    if(!monthMap[key]){monthMap[key]={first:i,last:i,y:w.getFullYear(),m:w.getMonth()+1};}
    else monthMap[key].last=i;
  });
  Object.values(monthMap).forEach(mo=>{
    const c1=FIXED+1+mo.first, c2=FIXED+1+mo.last;
    const label=`${mo.y}年${String(mo.m).padStart(2,'0')}月`;
    const mc=ws1.getCell(3,c1);
    mc.value=label; mc.fill=solidFill('FF2E75B6');
    mc.font={name:'Calibri',bold:true,size:10,color:{argb:WHT}};
    mc.alignment={horizontal:'center',vertical:'middle'};
    mc.border=thinBorder('FF4A90D9');
    if(c2>c1) ws1.mergeCells(3,c1,3,c2);
  });

  // R4 欄位 header + 週次
  ws1.getRow(4).height=20;
  ['需求單','系統別','子任務名稱','負責人','開始日','完成日'].forEach((h,i)=>hdrCell(ws1,4,i+2,h));
  weeks.forEach((w,i)=>{
    const label=`${String(w.getMonth()+1).padStart(2,'0')}/${String(w.getDate()).padStart(2,'0')}`;
    const c=ws1.getCell(4,FIXED+1+i);
    c.value=label;c.fill=solidFill('FFD6E4F0');
    c.font={name:'Calibri',bold:true,size:8,color:{argb:'FF1F3864'}};
    c.alignment={horizontal:'center',vertical:'middle'};
    c.border=thinBorder();
  });

  // 凍結
  ws1.views=[{state:'frozen',xSplit:FIXED,ySplit:4,showGridLines:false}];

  // 資料列
  let curRow=5, prevId=null;
  allTasks.forEach(task=>{
    const isNew=task.req_id!==prevId; prevId=task.req_id;
    const rowArgb=isNew?REQ_ARGB:ALT_ARGB;
    const t_s=new Date(task.startDate), t_e=new Date(task.dueDate);
    ws1.getRow(curRow).height=18;

    // 需求單欄
    dataCell(ws1,curRow,2,isNew?task.req_id:'',rowArgb,{h:'left',bold:isNew});
    // 系統別
    const sysArgb=SYS_ARGB[task.system]||'FF2E75B6';
    const sc=dataCell(ws1,curRow,3,isNew?task.system:'',isNew?sysArgb+'33':rowArgb,{bold:isNew});
    if(isNew){sc.font={name:'Calibri',bold:true,size:10,color:{argb:sysArgb}};sc.fill=solidFill(sysArgb+'44');}
    // 子任務名稱
    dataCell(ws1,curRow,4,task.name,rowArgb,{h:'left'});
    // 負責人
    dataCell(ws1,curRow,5,task.person,rowArgb);
    // 開始/完成日
    dataCell(ws1,curRow,6,task.startDate,rowArgb);
    dataCell(ws1,curRow,7,task.dueDate,rowArgb);

    // 甘特條
    weeks.forEach((w,wi)=>{
      const wEnd=new Date(w); wEnd.setDate(wEnd.getDate()+6);
      const inRange=t_s<=wEnd&&t_e>=w;
      const barArgb=STATUS_ARGB[task.status]||'FF4472C4';
      const cell=ws1.getCell(curRow,FIXED+1+wi);
      if(inRange){
        cell.fill=solidFill(barArgb);
        // 漸層感：任務起始週和結束週淡一點
        const isEdge=(wi===weeks.findIndex(x=>t_s<=new Date(x.getTime()+6*86400000)&&t_s>=x)
                   || wi===weeks.findIndex(x=>t_e<=new Date(x.getTime()+6*86400000)&&t_e>=x));
        cell.value='';
        cell.border=thinBorder('FF'+barArgb.slice(2)+'88');
      } else {
        cell.fill=solidFill(rowArgb);
        cell.border=thinBorder('FFE8E8E8');
      }
    });
    curRow++;
  });

  // 圖例
  curRow++;
  ws1.getRow(curRow).height=18;
  ws1.getCell(curRow,2).value='圖例：';
  ws1.getCell(curRow,2).font={name:'Calibri',bold:true,size:10};
  [['已完成','FF70AD47'],['進行中','FFED7D31'],['待開始','FF9DC3E6'],['擱置','FFFF3B30']].forEach(([lbl,argb],i)=>{
    const box=ws1.getCell(curRow,3+i*2);
    box.fill=solidFill(argb); box.value=' ';
    box.border=thinBorder();
    const lc=ws1.getCell(curRow,4+i*2);
    lc.value=lbl; lc.font={name:'Calibri',size:9,color:{argb:'FF444444'}};
  });

  // ════════════════════════════════════
  //  Sheet 2：詳細資料
  // ════════════════════════════════════
  const ws2=wb.addWorksheet('詳細資料',{views:[{showGridLines:false}]});
  ws2.views=[{state:'frozen',ySplit:1,showGridLines:false}];
  ['需求單編號','需求單名稱','系統別','子任務名稱','負責人','開始日','完成日','工作天數','狀態','備註'].forEach((h,i)=>{
    hdrCell(ws2,1,i+1,h);
  });
  ws2.getRow(1).height=22;
  [14,30,10,20,10,12,12,10,10,24].forEach((w,i)=>ws2.getColumn(i+1).width=w);
  ws2.autoFilter={from:{row:1,column:1},to:{row:1,column:10}};

  let r2=2, prevId2=null;
  allTasks.forEach((task,ti)=>{
    const isNew=task.req_id!==prevId2; prevId2=task.req_id;
    const rowArgb=ti%2===0?WHT:'FFF5F9FF';
    const wd=workdays(task.startDate,task.dueDate);
    const stArgb=STATUS_ARGB[task.status]||'FFDDDDDD';
    ws2.getRow(r2).height=16;
    [
      [isNew?task.req_id:'',{h:'left',bold:isNew}],
      [isNew?task.req_name:'',{h:'left',bold:isNew}],
      [isNew?task.system:'',{}],
      [task.name,{h:'left'}],[task.person,{}],
      [task.startDate,{}],[task.dueDate,{}],
      [wd,{}],[task.status,{}],[task.note||'',{h:'left'}]
    ].forEach(([val,opts],ci)=>{
      const fill=ci===8?stArgb+'55':rowArgb;
      dataCell(ws2,r2,ci+1,val,fill,opts);
    });
    r2++;
  });

  // ════════════════════════════════════
  //  Sheet 3：成員工作量
  // ════════════════════════════════════
  const ws3=wb.addWorksheet('成員工作量',{views:[{showGridLines:false}]});
  ws3.views=[{state:'frozen',ySplit:2,showGridLines:false}];

  // 標題
  ws3.getRow(1).height=30;
  const t3=ws3.getCell(1,1);
  t3.value='👤  成員工作量分析'; t3.font={name:'Calibri',bold:true,size:14,color:{argb:'FF1F3864'}};
  t3.alignment={horizontal:'center',vertical:'middle'}; ws3.mergeCells(1,1,1,4);

  ['成員','總工作天數','子任務數','佔比'].forEach((h,i)=>hdrCell(ws3,2,i+1,h));
  ws3.getRow(2).height=22;
  [14,14,10,10].forEach((w,i)=>ws3.getColumn(i+1).width=w);

  const memberDays={},memberCnt={};
  allTasks.forEach(t=>{
    const m=t.person||'未指定', wd=workdays(t.startDate,t.dueDate);
    memberDays[m]=(memberDays[m]||0)+wd; memberCnt[m]=(memberCnt[m]||0)+1;
  });
  const totalDays=Object.values(memberDays).reduce((a,b)=>a+b,0);
  const sorted=Object.entries(memberDays).sort((a,b)=>b[1]-a[1]);
  let r3=3;
  sorted.forEach(([m,d],i)=>{
    const rowArgb=i%2===0?WHT:'FFF5F9FF';
    ws3.getRow(r3).height=18;
    dataCell(ws3,r3,1,m,rowArgb,{h:'left',bold:true});
    dataCell(ws3,r3,2,d,rowArgb);
    dataCell(ws3,r3,3,memberCnt[m]||0,rowArgb);
    const pc=ws3.getCell(r3,4);
    pc.value=totalDays?d/totalDays:0; pc.numFmt='0.0%';
    pc.fill=solidFill(rowArgb); pc.font={name:'Calibri',size:10};
    pc.alignment={horizontal:'center',vertical:'middle'}; pc.border=thinBorder();
    r3++;
  });
  // 合計列
  ws3.getRow(r3).height=20;
  const totArgb='FFD6E4F0';
  dataCell(ws3,r3,1,'合計',totArgb,{bold:true});
  dataCell(ws3,r3,2,totalDays,totArgb,{bold:true});
  dataCell(ws3,r3,3,Object.values(memberCnt).reduce((a,b)=>a+b,0),totArgb,{bold:true});
  dataCell(ws3,r3,4,'',totArgb);

  // ── 下載 ──
  const buf=await wb.xlsx.writeBuffer();
  const blob=new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='甘特圖_'+(new Date().toISOString().slice(0,10))+'.xlsx';
  a.click();
}


// 觸發甘特圖 xlsx 下載
function downloadGantt(){
  const wrap = document.getElementById('ganttSvgWrap');
  if(!wrap){ alert('請先產出甘特圖'); return; }
  if(typeof html2canvas !== 'undefined'){
    html2canvas(wrap,{backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--surface')||'#fff', scale:2}).then(canvas=>{
      const a = document.createElement('a');
      a.href = canvas.toDataURL('image/png');
      a.download = '甘特圖_'+(new Date().toISOString().slice(0,10))+'.png';
      a.click();
    });
  } else {
    alert('下載功能需要 html2canvas 函式庫，請確認網路後重試');
  }
}

