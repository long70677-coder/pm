function render(){
  const ft=document.getElementById('filterType').value;
  const fs=document.getElementById('filterStatus').value;
  const fo=document.getElementById('filterOwner').value;
  const fq=(document.getElementById('searchBox').value||'').toLowerCase();
  const fm=document.getElementById('filterMember').value;
  const fsys=_filterSys||(document.getElementById('filterSystem')||{}).value||'';
  const reqs=DATA.requirements.filter(r=>{
    if(ft&&r.type!==ft)return false;
    if(fs&&r.status!==fs)return false;
    if(fsys&&r.system!==fsys)return false;
    if(fo&&!parseTags(r.owner).includes(fo))return false;
    if(fq&&!r.name.toLowerCase().includes(fq)&&!r.id.toLowerCase().includes(fq))return false;
    if(_filterStar && !r.starred) return false;
    if(fm){
      const hasMember=(r.subtasks||[]).some(st=>String(st.person||'').includes(fm));
      const isOwner=parseTags(r.owner).includes(fm)||parseTags(r.devs||'').includes(fm);
      if(!hasMember&&!isOwner)return false;
    }
    return true;
  });
  reqs.forEach(r=>{ r._origIdx = DATA.requirements.indexOf(r); });

  // 排序：starred 釘選最前，其次保持原始順序
  reqs.sort((a,b)=>{
    const as=a.starred?1:0, bs=b.starred?1:0;
    if(as!==bs) return bs-as;
    return (a._origIdx||0)-(b._origIdx||0);
  });

  // Stats
  const all=DATA.requirements;
  const _curStatSel = document.getElementById('filterStatus').value;
  // 產生統計卡片 HTML（可點擊觸發篩選）
