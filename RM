document.addEventListener('DOMContentLoaded', function(){
  // 動態偵測 toolbar 高度
  const tb = document.getElementById('mainToolbar');
  const qz = document.getElementById('queryZone');
  // 更新查詢區高度 CSS 變數（供 sticky 定位計算使用）
  function updateQH(){
    const header = document.querySelector('header');
    const hh = header ? header.offsetHeight : 56;
    const qh = qz ? qz.offsetHeight : 0;
    document.documentElement.style.setProperty('--qh', (hh + qh) + 'px');
  }
  updateQH();
  requestAnimationFrame(updateQH);
  setTimeout(updateQH, 100);
  setTimeout(updateQH, 300);
  setTimeout(updateQH, 800);
  window.addEventListener('load', updateQH);
  if(window.ResizeObserver){
    const ro = new ResizeObserver(updateQH);
    if(qz) ro.observe(qz);
    const hdr = document.querySelector('header');
    if(hdr) ro.observe(hdr);
    // 監控 appWrapper 高度
    const aw = document.getElementById('appWrapper');
    if(aw) ro.observe(aw);
  }
  window.addEventListener('resize', updateQH);;
  if(qz && window.ResizeObserver){ new ResizeObserver(updateQH).observe(qz); }
  window.addEventListener('resize', updateQH);

  refreshOwnerFilter();
  render();
});
