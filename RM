// ═══════════════════════════════════════════════════
//  進度計算
// ═══════════════════════════════════════════════════
function calcProgress(r){
  const subs=r.subtasks||[];
  if(!subs.length) return {actualPct:0,expectPct:0};
  const today=new Date().toISOString().split('T')[0];
  let actualNum=0, expectNum=0, total=subs.length;

  subs.forEach(st=>{
    // 實際進度
    if(st.status==='已完成'){
      actualNum += 1;
    } else if(st.status==='進行中'){
      actualNum += (st.pct||0)/100;
    }

    // 預期進度：只看預計完成日
    if(st.dueDate){
      if(st.dueDate <= today){
        // A：預計完成日在今日以前（含今日），直接算1
        expectNum += 1;
      } else if(st.status==='進行中' && st.startDate){
        // B：進行中且預計完成日在今日之後，計算時間比例
        const start=new Date(st.startDate).getTime();
        const end=new Date(st.dueDate).getTime();
        const now=new Date(today).getTime();
        const totalDays=end-start;
        if(totalDays>0 && now>start){
          expectNum += Math.min((now-start)/totalDays, 1);
        }
      }
    }
  });

  const actualPct=Math.round(actualNum/total*100);
  const expectPct=Math.round(expectNum/total*100);
  return {actualPct, expectPct};
}
