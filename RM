// 將選取的 AI 建議子任務插入需求單
function insertAiSubtasks(){
  const list = document.getElementById('aiResultList');
  const tasks = list._tasks||[];
  const selected = tasks.filter((_,i)=> document.getElementById('ai-cb-'+i)?.checked);

  if(!selected.length){ alert('請至少勾選一個子任務'); return; }

  // 如果是新增模式（editRi<0），直接從 modal 欄位建立需求單並 push
  if(editRi < 0){
    const now = new Date().toISOString();
    const newReq = {
      id:       document.getElementById('r-id').value||'RE'+Date.now(),
      name:     document.getElementById('r-name').value||'新需求單',
      type:     document.getElementById('r-type').value,
      owner:    fmtTags(getTagVals('ownerWrap'))||'－',
      devs:     fmtTags(getTagVals('devsWrap'))||'－',
      status:   document.getElementById('r-status').value,
      startDate:document.getElementById('r-start').value,
      dueDate:  document.getElementById('r-due').value,
      actualDate:document.getElementById('r-actual').value,
      notes:'', subtasks:[],
      createdDate:now, lastUpdated:now
    };
    editRi = DATA.requirements.length;
    DATA.requirements.push(newReq);
    saveData();
  }

  // 用 editRi 直接定位
  const ri = editRi;
  if(ri < 0 || ri >= DATA.requirements.length){ alert('請先儲存需求單'); return; }

  const today = new Date().toISOString().split('T')[0];
  const r = DATA.requirements[ri];
  if(!r.subtasks) r.subtasks = [];

  selected.forEach(t=>{
    const startDate = today;
    const due = new Date(); due.setDate(due.getDate() + (t.days||3));
    const dueDate = due.toISOString().split('T')[0];
    r.subtasks.push({
      name: t.name,
      person: r.owner||'',
      status: '待開始',
      startDate,
      dueDate,
      actualDate: '',
      pct: 0,
      note: t.note||''
    });
  });

  saveData();
  render();
  closeModal('aiOverlay');
  closeModal('reqOverlay');

  // 展開對應卡片
  setTimeout(()=>{
    _openCards.add(ri);
    render();
    jumpToCard(ri);
  }, 100);

  // 顯示成功提示
  showToast(`✅ 已加入 ${selected.length} 個 AI 建議子任務`);
}

// 顯示短暫通知訊息（右下角浮動提示）
function showToast(msg){
  let t = document.getElementById('toast');
  if(!t){
    t = document.createElement('div');
    t.id = 'toast';
    t.style.cssText = 'position:fixed;bottom:32px;left:50%;transform:translateX(-50%);background:#1C1C1E;color:#fff;padding:10px 22px;border-radius:20px;font-size:.9rem;z-index:9999;opacity:0;transition:.3s;pointer-events:none;white-space:nowrap';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.opacity = '1';
  clearTimeout(t._timer);
  t._timer = setTimeout(()=>{ t.style.opacity='0'; }, 2500);
}


