// 渲染今日儀表板（逾期、本週、近期子任務）
function renderSidebar(){
  const today = new Date();
  const todayStr = today.toISOString().split('T')[0];
  // 本週日
  const dow = today.getDay();
  const sunday = new Date(today); sunday.setDate(today.getDate() + (7 - (dow===0?7:dow)));
  const sundayStr = sunday.toISOString().split('T')[0];
  // 7天後
  const plus7 = new Date(today); plus7.setDate(today.getDate()+7);
  const plus7Str = plus7.toISOString().split('T')[0];

  const overdue=[], thisweek=[], upcoming=[], inprogress=[];

  DATA.requirements.forEach((r,ri)=>{
    (r.subtasks||[]).forEach((st,si)=>{
      if(st.status==='已完成'||st.status==='擱置') return;
      const due = st.dueDate||'';
      const start = st.startDate||'';
      if(due && due < todayStr){
        overdue.push({r,ri,st,si,due,start});
      } else if(due && due >= todayStr && due <= sundayStr){
        thisweek.push({r,ri,st,si,due,start});
      } else if(start && start > todayStr && start <= plus7Str){
        upcoming.push({r,ri,st,si,due,start});
      }
      // 進行中：狀態為進行中 且 今日介於開始日～完成日之間
      if(st.status==='進行中' && start && due && start <= todayStr && due >= todayStr){
        inprogress.push({r,ri,st,si,due,start});
      }
    });
  });

  // 產生進行中子任務的儀表板項目 HTML
  function mkItemsInProgress(list){
    if(!list.length) return '<div class="sb-empty">—</div>';
    return list.map(({r,ri,st})=>{
      const pct = st.pct||0;
      const daysLeft = st.dueDate ? Math.ceil((new Date(st.dueDate)-new Date())/(1000*60*60*24)) : null;
      const daysTag = daysLeft!==null ? `<span style="font-size:.6rem;color:${daysLeft<=3?'var(--red)':'var(--text3)'}">${daysLeft<=0?'今日到期':daysLeft+'天後到期'}</span>` : '';
      return `<div class="sb-item" style="border-left:3px solid var(--accent)" onclick="jumpToCard(${ri})">
        <div class="sb-req">${r.id} · ${r.name}</div>
        <div class="sb-name">${st.name} ${daysTag}</div>
        <div style="margin-top:4px;display:flex;align-items:center;gap:6px">
          <div style="flex:1;height:4px;background:var(--surface2);border-radius:4px;overflow:hidden">
            <div style="width:${pct}%;height:100%;background:var(--accent);border-radius:4px"></div>
          </div>
          <span style="font-size:.65rem;color:var(--accent);font-weight:600">${pct}%</span>
        </div>
        <div class="sb-date">負責人：${st.person||'—'} ｜ ${st.startDate||'?'} ～ ${st.dueDate||'?'}</div>
      </div>`;
    }).join('');
  }

  // 產生儀表板子任務項目 HTML（逾期/本週/近期）
  function mkItems(list, cls){
    if(!list.length) return '<div class="sb-empty">—</div>';
    return list.map(({r,ri,st,due,start})=>`
      <div class="sb-item ${cls}" onclick="jumpToCard(${ri})">
        <div class="sb-req">${r.id} · ${r.name}</div>
        <div class="sb-name">${st.name}</div>
        <div class="sb-date">${cls==='upcoming'?'開始：'+start:'完成日：'+due}</div>
      </div>`).join('');
  }

  const fmt = today.toLocaleDateString('zh-TW',{year:'numeric',month:'long',day:'numeric',weekday:'long'});

  const _sc = document.getElementById('sidebarContent');
  if(!_sc) return;
  if(!DATA.requirements.length){
    _sc.innerHTML = '<div style="padding:32px 20px;text-align:center;color:var(--text3)"><div style="font-size:2rem;margin-bottom:8px">📭</div><div style="font-size:.88rem">尚無需求單資料</div></div>';
    return;
  }
  _sc.innerHTML = `
    <div style="padding:10px 16px 4px">
      <div style="font-size:.82rem;font-weight:600;color:var(--text)">${fmt}</div>
    </div>
    <div class="sb-section">
      <div class="sb-section-title" style="color:var(--accent)">🔵 進行中子任務 <span style="background:rgba(0,122,255,.12);color:var(--accent);border-radius:12px;padding:1px 8px;font-size:.7rem">${inprogress.length}</span></div>
      ${mkItemsInProgress(inprogress)}
    </div>
    <div class="sb-section">
      <div class="sb-section-title overdue">🔴 已逾時 <span style="background:rgba(255,59,48,.12);color:var(--red);border-radius:12px;padding:1px 8px;font-size:.7rem">${overdue.length}</span></div>
      ${mkItems(overdue,'overdue')}
    </div>
    <div class="sb-section">
      <div class="sb-section-title thisweek">🟡 本週應完成 <span style="background:rgba(255,149,0,.12);color:var(--orange);border-radius:12px;padding:1px 8px;font-size:.7rem">${thisweek.length}</span></div>
      ${mkItems(thisweek,'thisweek')}
    </div>
    <div class="sb-section">
      <div class="sb-section-title upcoming">🟢 即將開始（7天內）<span style="background:rgba(52,199,89,.12);color:var(--green);border-radius:12px;padding:1px 8px;font-size:.7rem">${upcoming.length}</span></div>
      ${mkItems(upcoming,'upcoming')}
    </div>`;
}

