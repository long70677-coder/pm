<script>
(function(){
  // 為指定元素加上滑鼠拖曳捲動功能（今日儀表板側欄）
  function addDragScroll(el){
    let isDown=false, startY, scrollTop;
    el.addEventListener('mousedown',e=>{isDown=true;el.classList.add('grabbing');startY=e.pageY-el.offsetTop;scrollTop=el.scrollTop;});
    document.addEventListener('mouseup',()=>{isDown=false;el.classList.remove('grabbing');});
    el.addEventListener('mousemove',e=>{if(!isDown)return;e.preventDefault();const y=e.pageY-el.offsetTop;el.scrollTop=scrollTop-(y-startY);});
  }
  window.addEventListener('DOMContentLoaded',()=>{
    const sb=document.getElementById('sidebar');
    if(sb) addDragScroll(sb);
    // 設定 mainZone 高度
    function setMainHeight(){
      const ml = document.getElementById('mainZone');
      const qz = document.getElementById('queryZone');
      const hdr = document.querySelector('header');
      if(!ml) return;
      const usedH = (hdr ? hdr.offsetHeight : 0) + (qz ? qz.offsetHeight : 0);
      ml.style.height = (window.innerHeight - usedH) + 'px';
    }
    setMainHeight();
    window.addEventListener('resize', setMainHeight);
  });
})();
</script>

<script>
// 強制滾輪滾動需求列表區
window.addEventListener('wheel', function(e) {
  const bc = document.getElementById('boardCol');
  if (!bc) return;
  const sb = document.getElementById('sidebar');
  if (sb && sb.contains(e.target)) return; // sidebar 自己捲
  e.preventDefault();
  let delta = e.deltaY;
  if (e.deltaMode === 1) delta *= 24;
  else if (e.deltaMode === 2) delta *= (bc.clientHeight || 600);
  bc.scrollBy({ top: delta, behavior: 'instant' });
}, { passive: false });
</script>

