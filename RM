// 呼叫 AI API 根據需求名稱建議子任務清單
async function generateAiSubtasks(){
  const key = document.getElementById('aiKeyInput').value.trim() || localStorage.getItem('or_api_key')||'';
  if(!key){ alert('請輸入並儲存你的 OpenRouter API Key'); return; }

  const name = document.getElementById('r-name').value.trim();
  const type = document.getElementById('r-type').value;
  const extra = document.getElementById('aiPromptExtra').value.trim();

  // 撈出此類型的範本子任務名稱，提供給 AI 參考風格
  const tmplItems = (ALL_TMPL[type] || []).map(t => t.name).filter(Boolean);
  const tmplHint = tmplItems.length > 0
    ? `\n\n參考範本（此類型現有的子任務名稱，請參考這個命名風格，名稱盡量簡短、4字以內）：\n${tmplItems.join('、')}`
    : '';

  const prompt = `你是一個專業的 PM 助理，請根據以下需求單資訊，幫我拆解出 5～8 個具體可執行的子任務。

需求單名稱：${name}
需求類型：${type}
${extra ? '補充說明：'+extra : ''}${tmplHint}

請用 JSON 陣列格式回傳，每個元素包含：
- name: 子任務名稱（繁體中文，簡短具體，4字以內為佳）
- days: 預估完成天數（整數）
- note: 簡短說明（一句話）

只回傳 JSON 陣列，不要其他文字。範例格式：
[{"name":"需求訪談","days":2,"note":"與stakeholder確認需求細節"},...]`;

  document.getElementById('aiLoading').style.display = 'block';
  document.getElementById('aiError').style.display = 'none';
  document.getElementById('aiResultSection').style.display = 'none';
  document.getElementById('aiGenerateBtn').disabled = true;

  try {
    const aiModel = document.getElementById('aiModelSelect').value;
    const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${key}`,
        'Content-Type': 'application/json',
        'HTTP-Referer': 'https://pm-kanban.local',
        'X-Title': 'PM Kanban Tool'
      },
      body: JSON.stringify({
        model: aiModel,
        messages: [
          { role: 'system', content: '你是一個專業的 PM 助理，只回傳 JSON，不加任何說明文字或 markdown。' },
          { role: 'user', content: prompt }
        ],
        temperature: 0.7,
        max_tokens: 2000
      })
    });

    if(!res.ok){
      let errMsg = `HTTP ${res.status}`;
      try{
        const err = await res.json();
        const raw = err.error?.metadata?.raw || '';
        errMsg = err.error?.message || errMsg;
        if(raw) errMsg += '\n詳細：' + raw;
      }catch(_){}
      throw new Error(errMsg);
    }

    const data = await res.json();
    let rawText = (data.choices?.[0]?.message?.content || '').trim();

    if(!rawText) throw new Error('模型回傳空內容，請換一個模型試試');

    // 清除 markdown code block（多種格式）
    rawText = rawText.replace(/^```json\s*/i,'').replace(/^```\s*/,'').replace(/\s*```$/,'').trim();

    // 如果 JSON 被截斷（結尾不是 ] ），嘗試補全
    if(!rawText.endsWith(']')){
      const lastBrace = rawText.lastIndexOf('}');
      if(lastBrace > -1) rawText = rawText.substring(0, lastBrace+1) + ']';
    }

    let tasks;
    try{
      tasks = JSON.parse(rawText);
    } catch(parseErr){
      throw new Error('JSON 解析失敗，模型回傳：' + rawText.substring(0,200));
    }
    if(!Array.isArray(tasks) || tasks.length === 0) throw new Error('模型未回傳有效的子任務陣列');
    renderAiResult(tasks);

  } catch(e) {
    document.getElementById('aiError').style.display = 'block';
    document.getElementById('aiError').textContent = '❌ 錯誤：' + e.message + '\n\n請確認 API Key 正確，或嘗試更換免費模型。';
  } finally {
    document.getElementById('aiLoading').style.display = 'none';
    document.getElementById('aiGenerateBtn').disabled = false;
  }
}

// 渲染 AI 建議的子任務選擇清單
function renderAiResult(tasks){
  const list = document.getElementById('aiResultList');
  list.innerHTML = tasks.map((t,i)=>`
    <div class="ai-item selected" id="ai-item-${i}" onclick="toggleAiItem(${i})">
