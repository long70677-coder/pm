    const isActive = _curStatSel === filterVal;
    const activeStyle = isActive ? 'box-shadow:0 0 0 2px var(--accent);background:var(--surface2);' : '';
    const clickable = filterVal !== null ? `style="cursor:pointer;${activeStyle}${extraStyle}" onclick="setStatusFilter('${filterVal}')" title="${filterVal===''?'顯示全部':isActive?'點擊取消篩選':'點擊篩選：'+label}"` : `style="${extraStyle}"`;
    return `<div class="stat-card ${cls}" ${clickable}><div class="num">${val}</div><div class="lbl">${label}${isActive?' ✓':''}</div></div>`;
  }
  document.getElementById('statsBar').innerHTML=
    _statCard('全部需求', all.length, '', '', '') +
    _statCard('進行中', all.filter(r=>r.status==='進行中').length, 'or', '進行中') +
    _statCard('待開始', all.filter(r=>r.status==='待開始').length, '', '待開始') +
    _statCard('已完成', all.filter(r=>r.status==='已完成').length, 'gr', '已完成') +
