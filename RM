// 初始化子任務拖曳排序（只有按住 ⠿ 把手才能拖曳）
function initStDragSort(ri) {
  const tbody = document.querySelector(`#card-${ri} .st-table tbody`);
  if (!tbody) return;
  let dragSi = null;

  // 只有在 drag-handle 上 mousedown 才啟用 draggable
  tbody.querySelectorAll('td.drag-handle').forEach(handle => {
    handle.addEventListener('mousedown', () => {
      const tr = handle.closest('tr');
      if (tr) tr.draggable = true;
    });
  });

  tbody.addEventListener('dragstart', e => {
    const tr = e.target.closest('tr[data-si]');
    if (!tr) return;
    dragSi = parseInt(tr.dataset.si);
    tr.classList.add('dragging-row');
    e.dataTransfer.effectAllowed = 'move';
  });

  tbody.addEventListener('dragend', e => {
    const tr = e.target.closest('tr');
    if (tr) { tr.classList.remove('dragging-row'); tr.draggable = false; }
    tbody.querySelectorAll('tr').forEach(r => r.classList.remove('drag-over-top','drag-over-bot'));
    dragSi = null;
  });

  tbody.addEventListener('dragover', e => {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    const tr = e.target.closest('tr[data-si]');
    if (!tr) return;
    const overSi = parseInt(tr.dataset.si);
    if (overSi === dragSi) return;
    tbody.querySelectorAll('tr').forEach(r => r.classList.remove('drag-over-top','drag-over-bot'));
    const rect = tr.getBoundingClientRect();
    tr.classList.add(e.clientY < rect.top + rect.height / 2 ? 'drag-over-top' : 'drag-over-bot');
  });

  tbody.addEventListener('drop', e => {
    e.preventDefault();
    const tr = e.target.closest('tr[data-si]');
    if (!tr || dragSi === null) return;
    const overSi = parseInt(tr.dataset.si);
    if (overSi === dragSi) return;
    const rect = tr.getBoundingClientRect();
    const insertAfter = e.clientY >= rect.top + rect.height / 2;
    const subs = DATA.requirements[ri].subtasks;
    const [moved] = subs.splice(dragSi, 1);
    let targetIdx = overSi > dragSi ? overSi - 1 : overSi;
    if (insertAfter) targetIdx++;
    subs.splice(targetIdx, 0, moved);
    saveData();
    render();
  });
}

