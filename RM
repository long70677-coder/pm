<script>
// 切換批次匯入中 AI 區塊的顯示/隱藏
function toggleBiAiSection(){
  const mode = document.getElementById('biSubtaskMode').value;
  document.getElementById('biAiSection').style.display = mode==='ai' ? 'block' : 'none';
  document.getElementById('biDefaultTmplSection').style.display = mode==='default_tmpl' ? 'block' : 'none';
}

// 開啟批次匯入 Modal
function openBulkImport(){
  const key = localStorage.getItem('or_api_key')||'';
  if(document.getElementById('biKeyInput')) document.getElementById('biKeyInput').value = key;
  document.getElementById('biProgress').style.display = 'none';
  document.getElementById('biLog').textContent = '';
  document.getElementById('biProgressBar').style.width = '0%';
  document.getElementById('bulkImportFile').value = '';

  // 填充預設模板下拉選單
  const tmplSel = document.getElementById('biDefaultTmpl');
  const tmplKeys = Object.keys(ALL_TMPL).filter(k=>ALL_TMPL[k]&&ALL_TMPL[k].length>0);
  tmplSel.innerHTML = tmplKeys.length
    ? tmplKeys.map(k=>`<option value="${k}">${k}（${ALL_TMPL[k].length}個子任務）</option>`).join('')
    : '<option value="">（尚未設定任何範本）</option>';

  toggleBiAiSection();
  openModal('bulkImportOverlay');
}

// 處理批次匯入的檔案解析與匯入邏輯
async function startBulkImport(e){
  const file = e.target.files[0]; if(!file) return;
  const key = document.getElementById('biKeyInput').value.trim() || localStorage.getItem('or_api_key')||'';
  const model = document.getElementById('biModelSelect').value;
  const today = new Date().toISOString().split('T')[0];

  document.getElementById('biProgress').style.display = 'block';
  const logEl = document.getElementById('biLog');
  const barEl = document.getElementById('biProgressBar');
  const txtEl = document.getElementById('biProgressText');
  logEl.textContent = '';

  // （內部）批次匯入進度 log 輸出
  function log(msg){ logEl.textContent += msg + '\n'; logEl.scrollTop = logEl.scrollHeight; }

  if(typeof XLSX === 'undefined'){ alert('XLSX 函式庫未載入'); return; }

  const reader = new FileReader();
  reader.onload = async function(ev){
    try{
      const wb = XLSX.read(new Uint8Array(ev.target.result),{type:'array',cellDates:true});
      const ws = wb.Sheets[wb.SheetNames[0]];
      const rows = XLSX.utils.sheet_to_json(ws,{defval:'',raw:false});
      if(!rows.length){ alert('找不到資料'); return; }

      // 支援兩種格式：
      // 格式A（我的範本）：需求單名稱、需求類型、負責人、成員…
      // 格式B（使用者原始）：工作項目、類型、PM、負責人、工作分類…
      function detectFormat(r){
        if(r['需求單名稱']||r['需求名稱']) return 'A';
        if(r['工作項目']||r['工作規劃']) return 'B';
        return 'A';
      }

      // 去重：以「工作項目+工作規劃」或「需求單名稱」為 key，避免同名稱重複匯入
      const seenKeys = new Set();
      const dataRows = rows.filter(r => {
        const fmt = detectFormat(r);
        let key;
        if(fmt === 'B'){
          // 格式B：有 RE 編號用編號，否則用工作規劃內容
          const re = String(r['工作項目']||'').trim();
          const plan = String(r['工作規劃']||'').trim();
          key = re || plan;
        } else {
          key = String(r['需求單名稱']||r['需求名稱']||'').trim();
        }
        if(!key || key === '必填') return false;
        if(seenKeys.has(key)) return false;
        seenKeys.add(key);
        return true;
      });

      if(!dataRows.length){ alert('找不到有效需求單資料'); return; }

      log('📋 共讀取 ' + dataRows.length + ' 筆需求單（已自動去重）');

      const existIds = new Set(DATA.requirements.map(r=>r.id));
      const existNames = new Set(DATA.requirements.map(r=>r.name));
      const newReqs = [];
      let aiCount = 0, tmplCount = 0, skipCount = 0;

      for(let i=0; i<dataRows.length; i++){
        const row = dataRows[i];
        const fmt = detectFormat(row);

        let name, type, owner, devs, status, startDate, dueDate, notes, id;

        if(fmt === 'B'){
          // 格式B：使用者原始欄位
          const re = String(row['工作項目']||'').trim();
          const plan = String(row['工作規劃']||'').trim();
          const detail = String(row['細部規劃說明']||'').trim();
          name = re || plan || detail;
          if(!name){ skipCount++; continue; }
          type = String(row['工作分類']||row['類型']||'其他').trim();
          owner = String(row['PM']||row['負責人']||'－').trim();
          devs = String(row['負責人']||'－').trim();
          status = String(row['狀態']||'待開始').trim();
          startDate = String(row['預計開始日']||'').trim() || today;
          dueDate = String(row['預計完成日']||'').trim();
          notes = String(row['備註(進度說明)']||row['備註']||'').trim();
          // 有 RE 開頭就用，否則自動產生
          const reMatch = (re+' '+plan).match(/RE\d+/);
          const pad = String(DATA.requirements.length + newReqs.length + 1).padStart(3,'0');
          id = reMatch ? reMatch[0] : ('RE'+new Date().getFullYear()+pad);
        } else {
          // 格式A：我的範本
          name = String(row['需求單名稱']||row['需求名稱']||'').trim();
          if(!name){ skipCount++; continue; }
          type = String(row['需求類型']||'其他').trim();
          owner = String(row['負責人']||'－').trim();
          devs = String(row['成員']||'－').trim();
          status = String(row['狀態']||'待開始').trim();
          startDate = String(row['預計開始日']||'').trim() || today;
          dueDate = String(row['預計完成日']||'').trim();
          notes = String(row['備註']||'').trim();
          const pad = String(DATA.requirements.length + newReqs.length + 1).padStart(3,'0');
          id = String(row['需求單編號']||'').trim() || ('RE'+new Date().getFullYear()+pad);
        }

        // 狀態正規化
        const statusMap = {'完成':'已完成','done':'已完成','進行':'進行中','待辦':'待開始','hold':'擱置','擱置':'擱置'};
        for(const [k,v] of Object.entries(statusMap)){ if(status.includes(k)){ status=v; break; } }
        if(!['待開始','進行中','已完成','擱置'].includes(status)) status = '待開始';

        if(existIds.has(id) || existNames.has(name)){ log('⏭ 略過重複：'+name); skipCount++; continue; }

        const now = new Date().toISOString();
        const req = { id, name, type, owner, devs, status, startDate, dueDate, actualDate:'', notes, subtasks:[], createdDate:now, lastUpdated:now };

        // 決定子任務來源
        const mode = document.getElementById('biSubtaskMode').value;
        const typeTmpl = ALL_TMPL[type];

        if(typeTmpl && typeTmpl.length > 0){
          // 有對應範本，優先套用
          req.subtasks = genSubtasks(typeTmpl, startDate);
          if(!req.dueDate && req.subtasks.length) req.dueDate = req.subtasks[req.subtasks.length-1].dueDate;
          tmplCount++;
          log('✅ [範本:'+type+'] ' + name);
        } else if(mode === 'default_tmpl'){
          // 套預設模板
          const defKey = document.getElementById('biDefaultTmpl').value;
          const defTmpl = ALL_TMPL[defKey];
          if(defTmpl && defTmpl.length > 0){
            req.subtasks = genSubtasks(defTmpl, startDate);
            if(!req.dueDate && req.subtasks.length) req.dueDate = req.subtasks[req.subtasks.length-1].dueDate;
            tmplCount++;
            log('✅ [預設模板] ' + name);
          } else {
            log('⚠️ 找不到預設模板：'+defKey+'，建立空需求單');
          }
        } else if(mode === 'ai'){
          // AI 生成
          const aiModel = document.getElementById('biModelSelect').value;
          log('🤖 [AI] ' + name + ' 生成中...');
          txtEl.textContent = '處理中 ' + (i+1) + ' / ' + dataRows.length + '（AI：' + name.substring(0,15)+'...）';
          try{
            const prompt = `你是一個專業的 PM 助理，請根據以下需求單資訊，幫我拆解出 5～8 個具體可執行的子任務。

需求單名稱：${name}
需求類型：${type}

請用 JSON 陣列格式回傳，每個元素包含：
- name: 子任務名稱（繁體中文，4字以內）
- days: 預估完成天數（整數）
- note: 簡短說明（一句話）

只回傳 JSON 陣列，不要其他文字。`;
            const res = await fetch('https://openrouter.ai/api/v1/chat/completions',{
              method:'POST',
              headers:{'Authorization':'Bearer '+key,'Content-Type':'application/json','HTTP-Referer':'https://pm-kanban.local','X-Title':'PM Kanban Tool'},
              body:JSON.stringify({model:aiModel, messages:[{role:'system',content:'你是 PM 助理，只回傳 JSON，不加說明或 markdown。'},{role:'user',content:prompt}], temperature:0.7, max_tokens:1500})
            });
            if(!res.ok) throw new Error('HTTP '+res.status);
            const data = await res.json();
            let raw = (data.choices?.[0]?.message?.content||'').trim();
            raw = raw.replace(/^```json\s*/i,'').replace(/^```\s*/,'').replace(/\s*```$/,'').trim();
            if(!raw.endsWith(']')){ const lb=raw.lastIndexOf('}'); if(lb>-1) raw=raw.substring(0,lb+1)+']'; }
            const aiTasks = JSON.parse(raw);
            let d = new Date(startDate);
            req.subtasks = aiTasks.map(t=>{
              const s = d.toISOString().split('T')[0];
              d.setDate(d.getDate()+(t.days||3));
              return {name:t.name, person:owner||'－', status:'待開始', startDate:s, dueDate:d.toISOString().split('T')[0], actualDate:'', pct:0, note:t.note||''};
            });
            if(!req.dueDate && req.subtasks.length) req.dueDate = req.subtasks[req.subtasks.length-1].dueDate;
            aiCount++;
            log('   → 完成 '+req.subtasks.length+' 個子任務');
          } catch(err){
            log('   ⚠️ AI 失敗（'+err.message+'），建立空子任務');
          }
          await new Promise(r=>setTimeout(r,2000));
        } else {
          // 只建需求單
          log('📋 [空] ' + name);
        }

        newReqs.push(req);
        barEl.style.width = Math.round((i+1)/dataRows.length*100)+'%';
        txtEl.textContent = '處理中 '+(i+1)+' / '+dataRows.length;
      }

      DATA.requirements = DATA.requirements.concat(newReqs);
      saveData(); refreshOwnerFilter(); render();
      log('\n🎉 完成！新增 '+newReqs.length+' 筆（範本：'+tmplCount+'，AI：'+aiCount+'，略過：'+skipCount+'）');
      txtEl.textContent = '✅ 匯入完成！';
      barEl.style.width = '100%';

    } catch(err){ log('❌ 錯誤：'+err.message); }
  };
  reader.readAsArrayBuffer(file);
}
</script>


