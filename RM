<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PM 需求單管理看板 v34</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f5f5f7;--surface:#fff;--surface2:#f2f2f7;--border:#d2d2d7;
  --text:#1d1d1f;--text2:#6e6e73;--text3:#aeaeb2;
  --accent:#007aff;--green:#34c759;--red:#ff3b30;--orange:#ff9500;--purple:#af52de;
  --shadow-s:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.04);
  --shadow-m:0 4px 16px rgba(0,0,0,.10);--shadow-l:0 8px 32px rgba(0,0,0,.14);
  --rs:8px;--rm:12px;--rl:16px;--rxl:20px;
}
body.dark{
  --bg:#000;--surface:#1c1c1e;--surface2:#2c2c2e;--border:#4a4a4c;
  --text:#f5f5f7;--text2:#d1d1d6;--text3:#8e8e93;
  --shadow-s:0 1px 3px rgba(0,0,0,.5);--shadow-m:0 4px 16px rgba(0,0,0,.5);--shadow-l:0 8px 32px rgba(0,0,0,.6);
}
body{font-family:-apple-system,"SF Pro Text","Microsoft JhengHei","Segoe UI",sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;transition:background .3s,color .3s;margin:0}

/* Header */
header{background:rgba(255,255,255,.88);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:13px 28px;display:flex;align-items:center;justify-content:space-between;box-shadow:var(--shadow-s);z-index:200;flex-shrink:0}
body.dark header{background:rgba(28,28,30,.92)}
header h1{font-size:1.15rem;font-weight:700;letter-spacing:-.3px;color:var(--text)}
header .subtitle{font-size:.72rem;color:var(--text2);margin-top:2px}
.hdr-right{display:flex;align-items:center;gap:10px}
.save-ind{font-size:.72rem;background:var(--surface2);color:var(--text2);padding:4px 12px;border-radius:20px;border:1px solid var(--border)}
.theme-btn{background:var(--surface2);border:1px solid var(--border);border-radius:20px;padding:4px 14px;cursor:pointer;font-size:.78rem;color:var(--text2);transition:all .2s}
.theme-btn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}

/* Toolbar */
.toolbar{background:var(--surface);padding:10px 28px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;border-bottom:1px solid var(--border)}
.toolbar label{font-size:.8rem;color:var(--text2)}
.toolbar select{border:1px solid var(--border);border-radius:var(--rs);padding:6px 10px;font-size:.8rem;outline:none;background:var(--surface2);color:var(--text)}
.toolbar select:focus{border-color:var(--accent)}

/* Buttons */
.btn{background:var(--accent);color:#fff;border:none;border-radius:var(--rs);padding:7px 16px;cursor:pointer;font-size:.8rem;font-weight:500;transition:all .18s;white-space:nowrap;display:inline-flex;align-items:center;gap:4px}
.btn:hover{filter:brightness(1.1);transform:translateY(-1px);box-shadow:var(--shadow-s)}
.btn:active{transform:translateY(0);filter:brightness(.95)}
.btn.green{background:var(--green)}
.btn.gray{background:var(--surface2);color:var(--text);border:1px solid var(--border)}
.btn.gray:hover{background:var(--border);filter:none;transform:none}
.btn.red{background:var(--red)}
.btn.purple{background:var(--purple)}

/* Stats */
.stats-bar{display:flex;gap:12px;padding:14px 28px;background:var(--surface);border-bottom:1px solid var(--border);flex-wrap:wrap}
.stat-card{background:var(--surface2);border-radius:var(--rm);padding:10px 20px;text-align:center;min-width:86px;border:1px solid var(--border);transition:transform .15s,box-shadow .15s,background .15s;cursor:default}
.stat-card[onclick]:hover{transform:translateY(-2px);box-shadow:var(--sh2);background:var(--surface)}
.stat-card[onclick]:active{transform:translateY(0)}
.stat-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-m)}
.stat-card .num{font-size:1.55rem;font-weight:700;color:var(--accent)}
.stat-card.or .num{color:var(--orange)}.stat-card.gr .num{color:var(--green)}.stat-card.rd .num{color:var(--red)}
.stat-card .lbl{font-size:.7rem;color:var(--text2);margin-top:2px}

/* Cards */
.container{padding:20px 28px}
.req-card{background:var(--surface);border-radius:var(--rl);margin-bottom:14px;box-shadow:var(--shadow-s);border:1px solid var(--border);overflow:hidden;transition:box-shadow .2s,transform .2s}
.req-card:hover{box-shadow:var(--shadow-m);transform:translateY(-1px)}
.req-card[data-status="進行中"]{border-left:4px solid var(--accent)}
.req-card[data-status="待開始"]{border-left:4px solid var(--text3)}
.req-card[data-status="已完成"]{border-left:4px solid var(--green)}
.req-card[data-status="擱置"]{border-left:4px solid var(--red)}
.req-header{padding:14px 18px;display:flex;align-items:flex-start;gap:10px;flex-wrap:wrap}
.req-header-left{display:flex;flex-direction:column;gap:6px;flex:1;cursor:pointer}
.req-header-left:hover .req-title{color:var(--accent)}
.req-header-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.req-id{font-size:.7rem;color:var(--text3);font-family:"SF Mono","Menlo",monospace}
.req-title{font-weight:600;font-size:.96rem;color:var(--text)}
.badge{font-size:.68rem;padding:3px 10px;border-radius:20px;font-weight:600;white-space:nowrap}
.b-進行中{background:rgba(0,122,255,.12);color:var(--accent)}
.b-待開始{background:var(--surface2);color:var(--text2);border:1px solid var(--border)}
.b-已完成{background:rgba(52,199,89,.12);color:var(--green)}
.b-擱置{background:rgba(255,59,48,.12);color:var(--red)}
.b-type{background:rgba(255,149,0,.12);color:var(--orange)}
.meta-row{display:flex;gap:14px;flex-wrap:wrap}
.meta-item{font-size:.74rem;color:var(--text2)}
.toggle-icon{font-size:.88rem;color:var(--text3);cursor:pointer;padding:4px 8px;margin-top:2px;transition:transform .2s}
.req-card.open .toggle-icon{transform:rotate(180deg)}

/* Dual Progress */
.dual-wrap{display:flex;flex-direction:column;gap:4px;min-width:200px;margin-top:2px}
.dp-row{display:flex;align-items:center;gap:8px}
.dp-label{font-size:.68rem;color:var(--text3);width:52px;text-align:right;flex-shrink:0}
.dp-bg{flex:1;height:5px;background:var(--surface2);border-radius:10px;overflow:hidden}
.dp-fill-actual{height:100%;border-radius:10px;background:linear-gradient(90deg,var(--accent),#5ac8fa);transition:width .4s}
.dp-fill-expect{height:100%;border-radius:10px;background:repeating-linear-gradient(90deg,var(--orange) 0,var(--orange) 4px,transparent 4px,transparent 8px)}
.dp-pct{font-size:.7rem;font-weight:600;min-width:32px}
.dp-pct.a{color:var(--accent)}.dp-pct.e{color:var(--orange)}
.tag-ahead{font-size:.66rem;background:rgba(52,199,89,.12);color:var(--green);padding:1px 8px;border-radius:8px}
.tag-behind{font-size:.66rem;background:rgba(255,59,48,.12);color:var(--red);padding:1px 8px;border-radius:8px}
.tag-ok{font-size:.66rem;background:rgba(0,122,255,.12);color:var(--accent);padding:1px 8px;border-radius:8px}

/* Subtasks */
.subtasks{display:none;border-top:1px solid var(--border)}
.req-card.open .subtasks{display:block}
.st-table-wrap{width:100%;overflow-x:auto}
.st-table{width:auto;min-width:100%;border-collapse:collapse;table-layout:fixed}
.st-table thead tr{background:var(--surface2)}
.st-table thead th{padding:7px 10px;font-size:.68rem;color:var(--text2);font-weight:600;text-align:left;white-space:nowrap;position:relative;user-select:none;border-bottom:1px solid var(--border);border-right:1px solid var(--border)}
.st-table thead th:last-child{border-right:none}
.st-table tbody tr{border-bottom:1px solid var(--border);transition:background .15s}
.st-table tbody tr:hover{background:var(--surface2)}
.st-table tbody tr.dimmed{opacity:.55;background:rgba(52,199,89,.06)}
.st-table tbody tr.highlighted{background:rgba(255,149,0,.07)!important;opacity:1!important}
.st-table td{padding:7px 8px;vertical-align:middle;overflow:hidden;font-size:.8rem;color:var(--text)}
.rz{position:absolute;right:0;top:0;bottom:0;width:6px;cursor:col-resize;background:transparent;z-index:2}
.rz:hover,.rz.dragging{background:var(--accent);opacity:.5}
.drag-handle{width:28px;min-width:28px;cursor:grab;text-align:center;color:var(--text3);font-size:.85rem;user-select:none;padding:0 2px}
.drag-handle:active{cursor:grabbing}
.drag-handle:hover{color:var(--accent)}
tr.drag-over-top{box-shadow:inset 0 2px 0 var(--accent)}
tr.drag-over-bot{box-shadow:inset 0 -2px 0 var(--accent)}
tr.dragging-row{opacity:.35}
.colw-inline{color:var(--text3);font-weight:600;font-size:11px}
.rz-popup{position:fixed;background:var(--surface);border:1px solid var(--border);border-radius:var(--rm);padding:10px 14px;box-shadow:var(--shadow-l);z-index:9999;display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--text)}
.rz-popup input{width:60px;border:1px solid var(--border);border-radius:var(--rs);padding:4px 6px;font-size:.8rem;outline:none;text-align:center;background:var(--surface2);color:var(--text)}
.rz-popup input:focus{border-color:var(--accent)}
.rz-popup button{background:var(--accent);color:#fff;border:none;border-radius:var(--rs);padding:4px 10px;cursor:pointer}
.person-tag{display:inline-block;font-size:.68rem;background:rgba(0,122,255,.1);color:var(--accent);padding:2px 8px;border-radius:12px;margin:1px;cursor:pointer;white-space:nowrap;transition:all .15s}
.person-tag:hover{background:var(--accent);color:#fff}
.di{font-size:.74rem;border:1px solid var(--border);border-radius:var(--rs);padding:3px 5px;outline:none;color:var(--text);background:var(--surface2);width:100%;transition:border-color .2s}
.di:focus{border-color:var(--accent);background:var(--surface)}
.di.done-date{background:rgba(52,199,89,.1);color:var(--green);border-color:var(--green)}
.di:disabled{opacity:.4;cursor:not-allowed}
.es{font-size:.74rem;border:1px solid var(--border);border-radius:var(--rs);padding:3px 5px;outline:none;background:var(--surface2);color:var(--text);width:100%;cursor:pointer}
.es:focus{border-color:var(--accent)}
.pc-wrap{display:flex;align-items:center;gap:5px}
.pc-bar{flex:1;height:5px;background:var(--surface2);border-radius:10px;overflow:hidden;cursor:pointer;min-width:30px}
.pc-fill{height:100%;border-radius:10px;transition:width .3s}
.pc-inp{width:36px;font-size:.7rem;border:1px solid var(--border);border-radius:var(--rs);padding:2px 3px;text-align:center;outline:none;background:var(--surface2);color:var(--text)}
.pc-inp:focus{border-color:var(--accent)}
.add-st-row{padding:8px 18px 8px 28px}
.add-st-row button{font-size:.76rem;color:var(--accent);background:none;border:1px dashed var(--accent);border-radius:var(--rs);padding:4px 14px;cursor:pointer;transition:all .15s}
.add-st-row button:hover{background:rgba(0,122,255,.08)}
.notes-wrap{background:var(--surface2);padding:10px 18px 10px 28px;border-top:1px solid var(--border)}
.notes-wrap textarea{width:100%;font-size:.78rem;font-family:inherit;color:var(--text);border:1px solid var(--border);border-radius:var(--rs);padding:6px 8px;resize:vertical;background:var(--surface);outline:none;line-height:1.6}
.notes-wrap textarea:focus{border-color:var(--accent)}

/* Modal */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;backdrop-filter:blur(6px)}
.overlay.show{display:flex}
.modal{background:var(--surface);border-radius:var(--rxl);padding:26px;width:420px;max-height:92vh;overflow-y:auto;box-shadow:var(--shadow-l);border:1px solid var(--border)}
.modal h3{margin-bottom:14px;color:var(--text);font-size:1.02rem;font-weight:700}
.modal label{font-size:.78rem;color:var(--text2);display:block;margin-bottom:4px;margin-top:10px}
.modal input,.modal select,.modal textarea{width:100%;border:1px solid var(--border);border-radius:var(--rs);padding:8px 10px;font-size:.84rem;font-family:inherit;outline:none;background:var(--surface2);color:var(--text);transition:border-color .2s}
.modal input:focus,.modal select:focus{border-color:var(--accent);background:var(--surface)}
.modal-btns{display:flex;gap:8px;margin-top:18px;justify-content:flex-end}
.slider{width:100%;margin-top:4px;accent-color:var(--accent)}
.date-pair{display:flex;gap:8px}
.date-pair>div{flex:1}
.multi-tag-wrap{display:flex;flex-wrap:wrap;gap:4px;border:1px solid var(--border);border-radius:var(--rs);padding:6px 8px;min-height:36px;background:var(--surface2);cursor:text;align-items:center}
.multi-tag-wrap:focus-within{border-color:var(--accent);background:var(--surface)}
.m-tag{background:rgba(0,122,255,.12);color:var(--accent);border-radius:12px;padding:2px 8px;font-size:.75rem;display:inline-flex;align-items:center;gap:4px}
.m-tag .rm{cursor:pointer;color:var(--text3);font-size:.8rem}
.m-tag .rm:hover{color:var(--red)}
.m-tag-input{border:none;outline:none;font-size:.8rem;background:transparent;color:var(--text);min-width:80px;flex:1}

/* Drop Zone */
#dropZone{margin:40px auto;max-width:480px;border:2px dashed var(--accent);border-radius:var(--rxl);padding:52px 20px;text-align:center;color:var(--accent);background:rgba(0,122,255,.04);cursor:pointer;transition:all .2s}
#dropZone:hover{background:rgba(0,122,255,.09)}
#dropZone .dz-icon{font-size:2.8rem}
#dropZone .dz-title{font-size:1.05rem;font-weight:600;margin-top:10px}
#dropZone .dz-sub{font-size:.82rem;color:var(--text2);margin-top:6px}

/* ── Layout ── */
.main-layout {
  flex: 1;
  min-height: 0;
  height: 0;
  position: relative;
  overflow: hidden;
}
..board-col {
  position: absolute;
  top: 0; left: 0; right: 300px; bottom: 0;
  overflow-y: scroll;
  transition: right .3s;
}

.sidebar {
  position: absolute;
  top: 0; right: 0; bottom: 0;
  width: 300px;
  background: var(--surface);
  border-left: 1px solid var(--border);
  overflow-y: auto;
  box-shadow: -2px 0 8px rgba(0,0,0,.06);
  transition: transform .3s, opacity .3s;
  z-index: 10;
}
.sidebar{cursor:grab}.sidebar.grabbing{cursor:grabbing}.sidebar.collapsed {
  transform: translateX(300px);
  opacity: 0;
  pointer-events: none;
}

.sidebar-/* header style consolidated */
.sidebar-header h2 { font-size: .9rem; font-weight: 700; color: var(--text); }
.sidebar-toggle { background: none; border: none; cursor: pointer; color: var(--text2); font-size: .9rem; padding: 2px 6px; border-radius: var(--rs); transition: all .15s; }
.sidebar-toggle:hover { background: var(--surface2); color: var(--accent); }
.today-badge { font-size: .72rem; color: var(--text2); padding: 3px 10px; background: var(--surface2); border-radius: 20px; border: 1px solid var(--border); margin: 10px 16px 4px; display: inline-block; }
.sb-section { padding: 10px 12px 4px; }
.sb-section-title { font-size: .72rem; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
.sb-section-title.overdue  { color: var(--red); }
.sb-section-title.thisweek { color: var(--orange); }
.sb-section-title.upcoming { color: var(--green); }
.sb-item {
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: var(--rm); padding: 8px 10px; margin-bottom: 7px;
  cursor: pointer; transition: all .15s;
}
.sb-item:hover { border-color: var(--accent); box-shadow: var(--shadow-s); transform: translateX(-2px); }
.sb-item .sb-req { font-size: .68rem; color: var(--text3); margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sb-item .sb-name { font-size: .8rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sb-item .sb-date { font-size: .68rem; margin-top: 3px; }
.sb-item.overdue  .sb-date { color: var(--red); }
.sb-item.thisweek .sb-date { color: var(--orange); }
.sb-item.upcoming .sb-date { color: var(--green); }
.sb-empty { font-size: .78rem; color: var(--text3); padding: 8px 12px 12px; text-align: center; }
.sb-open-btn { background: none; border: none; cursor: pointer; color: var(--text2); font-size: .78rem; padding: 4px 8px; border-radius: var(--rs); transition: all .15s; white-space: nowrap; }
.sb-open-btn:hover { background: var(--surface2); color: var(--accent); }
@keyframes spin { to { transform: rotate(360deg); } }
.ai-item { display:flex; align-items:flex-start; gap:10px; padding:10px 12px; border-radius:10px; background:var(--surface2); border:1.5px solid transparent; cursor:pointer; transition:.15s; }
.ai-item:hover { border-color:var(--accent); }
.ai-item.selected { border-color:#6C63FF; background:rgba(108,99,255,.08); }
.ai-item input[type=checkbox] { margin-top:2px; accent-color:#6C63FF; width:16px; height:16px; flex-shrink:0; cursor:pointer; }
.ai-item-body { flex:1; }
.ai-item-name { font-size:.92rem; font-weight:600; color:var(--text); }
.ai-item-meta { font-size:.78rem; color:var(--text3); margin-top:2px; }

#appWrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: clip;
}
</style>
</head>
<body>

<!-- ══════════════ 頁面主容器 ══════════════ -->
<div id="appWrapper">
<!-- ── 頂部標題列：系統名稱、儲存提示、深色模式切換 ── -->
<header>
  <div>
    <h1>📋 投資資訊二科</h1>
    <div class="subtitle">需求單管理看板 · v33</div>
  </div>
  <div class="hdr-right">
    <span class="save-ind" id="saveInd">💾 已自動儲存</span>
    <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙 深色</button>
  </div>
</header>

<!-- ── 查詢操作區：工具列、篩選列、統計列（固定於頂部） ── -->
<div id="queryZone" style="flex-shrink:0;z-index:100">
<div class="toolbar" id="mainToolbar" style="flex-direction:column;align-items:stretch;gap:0;padding:0">
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:8px 20px;border-bottom:1px solid var(--border)">
    <button class="btn" onclick="openReqModal(-1)" style="font-weight:700">＋ 新增</button>
    <button class="btn green" onclick="openBulkImport()">📦 批次匯入</button>
    <div style="width:1px;height:22px;background:var(--border)"></div>
    <label class="btn gray" style="cursor:pointer;margin:0">📂 匯入<input type="file" id="xlsxInput" accept=".xlsx,.xls" style="display:none" onchange="importXlsx(event)"></label>
    <button class="btn gray" onclick="exportXlsx()">📥 匯出</button>
    <div style="width:1px;height:22px;background:var(--border)"></div>
    <button class="btn gray" onclick="openMemberMgr()">👥 成員</button>
    <button class="btn gray" onclick="openTemplateMgr()">📐 範本</button>
    <div style="flex:1"></div>
    <button id="ganttBtn" onclick="openGantt()" style="background:linear-gradient(135deg,#0ea5e9,#6366f1);color:#fff;border:none;border-radius:var(--rm);padding:0 14px;height:34px;cursor:pointer;font-size:.83rem;font-weight:600;display:none;align-items:center">📊 甘特圖</button>
    <button class="btn" onclick="clearAllData()" style="background:#fee2e2;color:#dc2626;border:1px solid #fca5a5">🗑 清除資料</button>
  </div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:5px 20px;background:var(--surface2)">
    <select id="filterType" onchange="render()" style="border:1px solid var(--border);border-radius:var(--rs);padding:4px 8px;font-size:.8rem;background:var(--surface);color:var(--text)"><option value="">全部類型</option></select>
    <select id="filterStatus" onchange="render()" style="border:1px solid var(--border);border-radius:var(--rs);padding:4px 8px;font-size:.8rem;background:var(--surface);color:var(--text)">
      <option value="">全部狀態</option><option>待開始</option><option>進行中</option><option>已完成</option><option>擱置</option>
    </select>
    <select id="filterOwner" onchange="render()" style="border:1px solid var(--border);border-radius:var(--rs);padding:4px 8px;font-size:.8rem;background:var(--surface);color:var(--text)"><option value="">全部負責人</option></select>
    <select id="filterMember" onchange="render()" style="border:1px solid var(--border);border-radius:var(--rs);padding:4px 8px;font-size:.8rem;background:var(--surface);color:var(--text)"><option value="">全部成員</option></select>
    <input id="searchBox" placeholder="🔍 搜尋名稱／編號" style="border:1px solid var(--border);border-radius:var(--rs);padding:4px 10px;font-size:.8rem;background:var(--surface);color:var(--text);width:160px" oninput="render()">
    <button class="btn gray" style="font-size:.78rem;padding:3px 9px;height:28px" onclick="clearFilters()">✕ 清除篩選</button>
