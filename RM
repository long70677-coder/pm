// 儲存需求單表單資料（含自動套用子任務範本邏輯）
async function saveReq(){
  const startDate=document.getElementById('r-start').value;
  const type=document.getElementById('r-type').value;
  await fetchHols(startDate.split('-')[0]||new Date().getFullYear());
  const now=new Date().toISOString();
  const isNew=editRi<0;
  const req={
    id:       document.getElementById('r-id').value||'RE2026XXXXX',
    name:     document.getElementById('r-name').value||'新需求單',
    type,
    owner:    fmtTags(getTagVals('ownerWrap'))||'－',
    devs:     fmtTags(getTagVals('devsWrap'))||'－',
    status:   document.getElementById('r-status').value,
    startDate, dueDate:document.getElementById('r-due').value,
    actualDate:document.getElementById('r-actual').value,
    notes:    isNew?'':(DATA.requirements[editRi].notes||''),
    subtasks: isNew?[]:(DATA.requirements[editRi].subtasks||[]),
    starred:  isNew?false:!!(DATA.requirements[editRi].starred),
    createdDate:  isNew?now:(DATA.requirements[editRi].createdDate||now),
    lastUpdated:  now
  };
  if(!isNew){
    DATA.requirements[editRi]=req; saveData(); closeModal('reqOverlay'); return;
  }
  const tmpl=ALL_TMPL[type];
  if(tmpl&&tmpl.length>0&&startDate){
    req.subtasks=genSubtasks(tmpl,startDate);
    if(!req.dueDate&&req.subtasks.length>0) req.dueDate=req.subtasks[req.subtasks.length-1].dueDate;
    editRi = DATA.requirements.length; DATA.requirements.push(req); saveData(); closeModal('reqOverlay');
  } else {
    _pendingReq=req; showSelectTmpl();
  }
}
